;; Compose after the gateway trigger fixtures and cursor implementation.
(defn test-cron-cursor [] :bool
  (let [definition (test-definition "* * * * *" "cursor-test" 540)
        pin (test-pin definition) slot 1792638000000 previous (- slot 60000)
        cursor (cc-cursor pin previous) plan (cc-plan definition pin cursor slot)]
    (and (= (cc-cursor-problem cursor pin slot) "cursor/ok")
         (cc-definition-overlap? "/p/cursor.last" "/p/cursor")
         (cc-definition-overlap? "/p/cursor.pending/child" "/p/cursor")
         (cc-definition-overlap? "/p/cursor.intent" "/p/cursor")
         (cc-definition-overlap? "/p/cursor.head-intent" "/p/cursor")
         (cc-definition-overlap? "/p/cursor.head-last" "/p/cursor")
         (cc-definition-overlap? "/p/cursor.turn-intent" "/p/cursor")
         (cc-definition-overlap? "/p/cursor.turn-last" "/p/cursor")
         (not (= (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-a" "did:a") (cc-turn-text pin cursor "job" slot "/p/b.lock" "/p/token" "1001,1002" "node-a" "did:a")))
         (not (= (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-a" "did:a") (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/other" "1001,1002" "node-a" "did:a")))
         (not (= (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-a" "did:a") (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1002,1001" "node-a" "did:a")))
         (not (= (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-a" "did:a") (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-b" "did:a")))
         (not (= (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-a" "did:a") (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-a" "did:b")))
         (= (string-index-of (cc-turn-text pin cursor "job" slot "/p/a.lock" "/p/token" "1001,1002" "node-a" "did:a") "jti4\n") 0)
         (cc-definition-overlap? "/p" "/p/cursor")
         (not (cc-definition-overlap? "/p/cursor-backup" "/p/cursor"))
         (not (cp-safe-absolute? "/p//cursor.last"))
         (= (cc-plan-problem definition pin cursor (- slot 1)) "cursor/idle")
         (= (cc-plan-problem definition pin cursor slot) "trigger/ok")
         (= (string-index-of plan "cursor/plan ") 0)
         (= (cc-plan-problem definition "bad" cursor slot) "cursor/binding")
         (= (cc-plan-problem definition pin (gt-bytes "{\"a\":") slot) "cursor/schema")
         (= (cc-plan-problem definition pin (cc-cursor pin (+ slot 1)) slot) "cursor/time")
         (= (cc-plan-problem (gt-bytes "{}") pin cursor slot) "cursor/definition"))))
