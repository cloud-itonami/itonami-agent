;; Compose after the guarded node and existing gateway trigger test fixtures.
(ns itonami.gateway-guarded-job-node-cases (:export [test-guarded-cron-cursor]))

(defn test-guarded-cron-cursor [] :bool
  (let [definition (test-definition "* * * * *" "guard-test" 540)
        pin (test-pin definition) now 1792638000000 previous (- now 60000)
        cursor (cc-cursor pin previous)]
    (and (cjg-bytes-same? [65 195 169] (jn-bytes (string-from-utf8 (bytes-from-vector-i64 [65 195 169]))))
         (not (cjg-bytes-same? [65 195 169] [65 195 168]))
         (not (cjg-bytes-same? [65 195] [65 195 169]))
         (= (cjg-cursor-problem "0" "0" "0" "0" definition cursor pin previous now) "cron-guard/ok")
         (cjg-lock-paths? "/p/cron.lock" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" "/p/token")
         (not (cjg-lock-paths? "/p/cursor.head-intent" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" "/p/token"))
         (not (cjg-lock-paths? "/p/attempts/lock" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" "/p/token"))
         (not (cjg-lock-paths? "/p//lock" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" "/p/token"))
         (not (cjg-lock-paths? "/p/token" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" "/p/token"))
         (not (cjg-lock-paths? "/p/token/lock" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" "/p/token"))
         (not (cjg-lock-paths? "/p/tokens" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" "/p/tokens/lease"))
         (not (cjg-lock-paths? "/p/cron.lock" "/p/cursor" "/p/definition" "/p/source" "/p/input" "/p/attempts" ""))
         (cjg-input-outside-cursor? "/p/key" "/p/cursor")
         (not (cjg-input-outside-cursor? "/p/cursor.turn-intent" "/p/cursor"))
         (not (cjg-input-outside-cursor? "/p" "/p/cursor"))
         (not (cjg-input-outside-cursor? "relative" "/p/cursor"))
         (cjg-input-outside-lock? "/p/layout" "/p/cron.lock")
         (not (cjg-input-outside-lock? "/p/layout" "/p/layout/lock"))
         (not (cjg-input-outside-lock? "/p/cron.lock" "/p/cron.lock"))
         (= (cjg-cursor-problem "1" "0" "0" "0" definition cursor pin previous now) "cron-guard/pending-unknown")
         (= (cjg-cursor-problem "0" "" "0" "0" definition cursor pin previous now) "cron-guard/intent-unknown")
         (= (cjg-cursor-problem "0" "0" "1" "0" definition cursor pin previous now) "cron-guard/head-intent-unknown")
         (= (cjg-cursor-problem "0" "0" "" "0" definition cursor pin previous now) "cron-guard/head-intent-unknown")
         (= (cjg-cursor-problem "0" "0" "0" "1" definition cursor pin previous now) "cron-guard/turn-intent-unknown")
         (= (cjg-cursor-problem "0" "0" "0" "" definition cursor pin previous now) "cron-guard/turn-intent-unknown")
         (= (cjg-cursor-problem "0" "0" "0" "0" definition cursor pin (- previous 60000) now) "cron-guard/cursor-changed")
         (= (cjg-cursor-problem "0" "0" "0" "0" definition cursor pin previous (- now 1)) "cron-guard/plan-refused")
         (= (cjg-cursor-problem "0" "0" "0" "0" definition (vector-alloc 0) pin previous now) "cron-guard/plan-refused"))))
