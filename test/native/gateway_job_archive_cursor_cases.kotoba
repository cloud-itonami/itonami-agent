;; Compose after gateway_job_archive_cursor. Effects remain stubbed by the host.
(ns itonami.gateway-job-archive-cursor-cases (:export [test-job-archive-cursor]))

(defn test-job-archive-cursor [] :bool
  (let [cid "bafkreibuoymhi5lbxktszxduuzmekq2qpbqd7mz66w2cowz4memgb4dna"
        tree "0123456789abcdef0123456789abcdef01234567"
        ok (str "job-output/archive-verified " cid " " tree)
        chosen "{\"epoch\":1,\"node\":\"node-a\",\"until\":2000}"
        digest (sha256-hex (jn-bytes chosen))
        proof (cp-bytes (str "{\"receipt\":{\"at\":1500,\"epoch\":1,\"kind\":\"itonami.agent-step-receipt/2\",\"lease\":\"" digest "\",\"node\":\"node-a\"}}"))
        old-epoch (cp-bytes (str "{\"receipt\":{\"at\":1500,\"epoch\":2,\"kind\":\"itonami.agent-step-receipt/2\",\"lease\":\"" digest "\",\"node\":\"node-a\"}}"))
        expired (cp-bytes (str "{\"receipt\":{\"at\":2000,\"epoch\":1,\"kind\":\"itonami.agent-step-receipt/2\",\"lease\":\"" digest "\",\"node\":\"node-a\"}}"))
        old-lease (cp-bytes "{\"receipt\":{\"at\":1500,\"epoch\":1,\"kind\":\"itonami.agent-step-receipt/2\",\"lease\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"node\":\"node-a\"}}")
        legacy (cp-bytes "{\"receipt\":{\"at\":1500,\"epoch\":1,\"kind\":\"itonami.agent-step-receipt/1\",\"node\":\"node-a\"}}")]
    (and (jac-complete? ok cid "lease-a" "lease-a" "job/lease-ok" 100 101 true)
         (jac-head-result? (str "head-cas/advanced " cid " " tree " acknowledged") cid)
         (jac-head-result? (str "head-cas/advanced " cid " " tree " unacknowledged") cid)
         (not (jac-head-result? "head-cas/conflict-or-unknown" cid))
         (not (jac-head-result? (str "head-cas/advanced " cid " " tree " acknowledged extra") cid))
         (not (jac-head-result? (str "head-cas/advanced wrong " tree " acknowledged") cid))
         (not (jac-head-result? (str "head-cas/advanced " cid " bad acknowledged") cid))
         (jac-cursor-overlap? "/private/task/cursor.last" "/private/task/cursor")
         (jac-cursor-overlap? "/private/task/cursor.head-intent" "/private/task/cursor")
         (jac-cursor-overlap? "/private/task/cursor.head-last/child" "/private/task/cursor")
         (jac-cursor-overlap? "/private/task/cursor.turn-intent" "/private/task/cursor")
         (jac-cursor-overlap? "/private/task/cursor.turn-last" "/private/task/cursor")
         (jac-cursor-overlap? "/private/task/cursor.pending/child" "/private/task/cursor")
         (not (jac-cursor-overlap? "/private/task/cursor-backup" "/private/task/cursor"))
         (jac-lock-paths? "/p/cron.lock" "/p/work" "/p/store" "/p/cursor" "/p/definition" "/p/token" "/p/gh")
         (not (jac-lock-paths? "/p/store/lock" "/p/work" "/p/store" "/p/cursor" "/p/definition" "/p/token" "/p/gh"))
         (not (jac-lock-paths? "/p/cursor.turn-intent" "/p/work" "/p/store" "/p/cursor" "/p/definition" "/p/token" "/p/gh"))
         (jac-proof-lease? proof chosen "node-a" 1500)
         (not (jac-proof-lease? proof chosen "node-a" 1499))
         (not (jac-proof-lease? old-epoch chosen "node-a" 1500))
         (not (jac-proof-lease? expired chosen "node-a" 2000))
         (not (jac-proof-lease? old-lease chosen "node-a" 1500))
         (not (jac-proof-lease? legacy chosen "node-a" 1500))
         (not (jac-proof-lease? proof chosen "node-b" 1500))
         (not (jac-complete? "job-output/archive-readback-unknown" cid "lease-a" "lease-a" "job/lease-ok" 100 101 true))
         (not (jac-complete? ok cid "lease-a" "lease-b" "job/lease-ok" 100 101 true))
         (not (jac-complete? ok cid "lease-a" "lease-a" "job/lease-invalid" 100 101 true))
         (not (jac-complete? ok cid "lease-a" "lease-a" "job/lease-ok" 101 100 true))
         (not (jac-complete? ok cid "lease-a" "lease-a" "job/lease-ok" 100 101 false))
         (not (jac-complete? (str ok " extra") cid "lease-a" "lease-a" "job/lease-ok" 100 101 true)))))
