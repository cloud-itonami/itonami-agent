(ns itonami.agent.clarify-test
  "Hermes tools/clarify_tool.py semantics: normalization errors name their
  index, the recommendation label never leaks into user_response, async
  callbacks are awaited, and an unavailable surface answers the honest string."
  (:require [cljs.test :refer [deftest is testing async]]
            [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.clarify :as clarify]
            [itonami.agent.host :as h]))

(deftest normalize-errors-name-their-index
  (testing "shape errors"
    (is (re-find #"non-empty array" (str (second (clarify/normalize-questions [])))))
    (is (re-find #"non-empty array" (str (second (clarify/normalize-questions "x")))))
    (is (re-find #"at most 5" (str (second (clarify/normalize-questions (vec (repeat 6 {"question" "q"}))))))))
  (testing "per-entry errors"
    (is (re-find #"questions\[0\] must be an object" (str (second (clarify/normalize-questions ["x"])))))
    (is (re-find #"questions\[1\]\.question must be non-empty" (str (second (clarify/normalize-questions [{"question" "a"} {"question" "  "}])))))
    (is (re-find #"questions\[0\]\.choices must be a list of strings" (str (second (clarify/normalize-questions [{"question" "a" "choices" "x"}])))))
    (is (re-find #"questions\[0\]\.choices must be a list of strings" (str (second (clarify/normalize-questions [{"question" "a" "choices" [1]}])))))
    (is (re-find #"choices\[0\] is over 8000 characters" (str (second (clarify/normalize-questions [{"question" "a" "choices" [(apply str (repeat 8001 "x"))]}])))))
    (is (re-find #"all are blank" (str (second (clarify/normalize-questions [{"question" "a" "choices" ["  " ""]}])))))))

(deftest normalize-shape
  (let [[norm err] (clarify/normalize-questions [{"question" " Pick? " "choices" ["b" "a"] "multi_select" true}
                                                 {"question" "Open"}])]
    (is (nil? err))
    (let [q0 (first norm) q1 (second norm)]
      (is (= "q0" (get q0 "qid")))
      (is (= "q1" (get q1 "qid")))
      (is (= "Pick?" (get q0 "question")))
      (testing "the first choice is marked, choices_offered stays bare"
        (is (str/ends-with? (str (first (get q0 "choices"))) "(Recommended)"))
        (is (= ["b" "a"] (get q0 "choices_offered"))))
      (testing "multi_select only with choices"
        (is (true? (get q0 "multi_select")))
        (is (false? (get q1 "multi_select"))))
      (testing "a lone choice is left untouched"
        (let [[one _] (clarify/normalize-questions [{"question" "x" "choices" ["only"]}])]
          (is (= ["only"] (get (first one) "choices"))))))))

(deftest edge-answers-match-hermes-semantics
  (testing "blanks are filtered on the RAW item, then the label is stripped"
    (let [[norm _] (clarify/normalize-questions [{"question" "A" "choices" ["yes" "no"] "multi_select" true}])]
      ;; a label-only item is non-blank raw -> survives -> answers [""] (Hermes)
      (is (= [""] (get-in (h/json-parse (clarify/result-json norm {"answers" {"q0" ["(Recommended)"]} "outcome" "submitted"})) ["responses" 0 "user_response"])))))
  (testing "a scalar multi answer errors like Python's non-iterable"
    (let [[norm _] (clarify/normalize-questions [{"question" "A" "choices" ["yes" "no"] "multi_select" true}])]
      (is (thrown-with-msg? js/Error #"object is not iterable"
                            (clarify/result-json norm {"answers" {"q0" 5} "outcome" "submitted"})))))
  (testing "a missing outcome is an error, not a silent null"
    (let [[norm _] (clarify/normalize-questions [{"question" "A"}])]
      (is (thrown-with-msg? js/Error #"'outcome'"
                            (clarify/result-json norm {"answers" {}})))))
  (testing "falsy question values are empty text, as in Hermes"
    (is (re-find #"must be non-empty" (str (second (clarify/normalize-questions [{"question" 0}])))))
    (is (re-find #"must be non-empty" (str (second (clarify/normalize-questions [{"question" false}])))))
    (is (re-find #"must be non-empty" (str (second (clarify/normalize-questions [{"question" []}]))))))
  (testing "single answers stringify Python-style for bool/nil"
    (let [[norm _] (clarify/normalize-questions [{"question" "A"}])]
      (is (= "True" (get-in (h/json-parse (clarify/result-json norm {"answers" {"q0" true} "outcome" "submitted"})) ["responses" 0 "user_response"])))
      (is (= "False" (get-in (h/json-parse (clarify/result-json norm {"answers" {"q0" false} "outcome" "submitted"})) ["responses" 0 "user_response"])))
      (testing "a None raw answer is skipped with no response (Hermes guards it away)"
        (let [parsed (h/json-parse (clarify/result-json norm {"answers" {"q0" nil} "outcome" "submitted"}))]
          (is (= "skipped" (get-in parsed ["responses" 0 "status"])))
          (is (nil? (get-in parsed ["responses" 0 "user_response"]))))))))

(deftest recommended-label-never-leaks
  (is (= "b" (clarify/strip-recommended "b (Recommended)")))
  (is (= ["b (Recommended)" "a"] (clarify/mark-recommended ["b" "a"])))
  (testing "marking is idempotent"
    (is (= (clarify/mark-recommended ["b" "a"])
           (clarify/mark-recommended (clarify/mark-recommended ["b" "a"]))))))

(deftest result-statuses
  (let [[norm _] (clarify/normalize-questions [{"question" "A" "choices" ["yes" "no"]}
                                               {"question" "B"}
                                               {"question" "C"}])
        reply {"answers" {"q0" "yes (Recommended)" "q2" ""}
               "outcome" "submitted"
               "notice" "timed out"}
        parsed (h/json-parse (clarify/result-json norm reply))]
    (is (= "answered" (get-in parsed ["responses" 0 "status"])))
    (is (= "yes" (get-in parsed ["responses" 0 "user_response"])))
    (is (= "unanswered" (get-in parsed ["responses" 1 "status"])))
    (is (nil? (get-in parsed ["responses" 1 "user_response"])))
    (is (= "skipped" (get-in parsed ["responses" 2 "status"])))
    (is (= "submitted" (get parsed "outcome")))
    (is (= "timed out" (get parsed "notice")))))

(deftest ask-contracts
  (async done
    (-> (clarify/ask! [{"question" "Q"}] nil)
        (p/then (fn [out]
                  (testing "no callback -> the honest unavailability error"
                    (is (re-find #"not available in this execution context"
                                 (str (h/json-parse out)))))))
        (p/then (fn [_]
                  (let [seen (atom nil)]
                    (-> (clarify/ask! [{"question" "Q" "choices" ["a" "b"]}]
                                      (fn [norm]
                                        (reset! seen norm)
                                        {"answers" {"q0" "a"} "outcome" "submitted"}))
                        (p/then (fn [out]
                                  (let [parsed (h/json-parse out)]
                                    (testing "a sync callback's reply is shaped"
                                      (is (= "q0" (get-in @seen [0 "qid"])))
                                      (is (= "answered" (get-in parsed ["responses" 0 "status"])))
                                      (is (= "a" (get-in parsed ["responses" 0 "user_response"])))))))))))
        (p/then (fn [_]
                  (clarify/ask! [{"question" "Q"}]
                                (fn [_] (p/resolved {"answers" {"q0" "typed"} "outcome" "submitted"})))))
        (p/then (fn [out]
                  (let [parsed (h/json-parse out)]
                    (testing "an ASYNC callback's reply is awaited — a Promise answer is an ANSWER"
                      (is (= "answered" (get-in parsed ["responses" 0 "status"])))
                      (is (= "typed" (get-in parsed ["responses" 0 "user_response"])))))))
        (p/then (fn [_]
                  (clarify/ask! [{"question" "A" "choices" ["yes" "no"] "multi_select" true}]
                                (fn [_] {"answers" {"q0" ["yes (Recommended)" "" " "]} "outcome" "submitted"}))))
        (p/then (fn [out]
                  (let [parsed (h/json-parse out)]
                    (testing "multi-select answers drop blanks and the label (Hermes verbatim)"
                      (is (= ["yes"] (get-in parsed ["responses" 0 "user_response"]))))
                    out)))
        (p/then (fn [_]
                  (clarify/ask! [{"question" "A" "choices" ["yes" "no"] "multi_select" true}]
                                (fn [_] {"answers" {"q0" "[\"yes\", \"no\"]"} "outcome" "submitted"}))))
        (p/then (fn [out]
                  (let [parsed (h/json-parse out)]
                    (testing "a JSON-array STRING is split too (js->clj yields a vector, not a JS array)"
                      (is (= ["yes" "no"] (get-in parsed ["responses" 0 "user_response"])))))))
        (p/then (fn [_]
                  (clarify/ask! [{"question" "Q"}]
                                (fn [_] #js {"answers" #js {"q0" "js-obj"} "outcome" "submitted"}))))
        (p/then (fn [out]
                  (let [parsed (h/json-parse out)]
                    (testing "a plain JS-object reply is read too (future bridge interop)"
                      (is (= "js-obj" (get-in parsed ["responses" 0 "user_response"])))))))
        (p/then (fn [_]
                  (clarify/ask! [{"question" "Q"}]
                                (fn [_] (js/Promise.reject (js/Error. "boom"))))))
        (p/then (fn [out]
                  (testing "a rejecting callback answers the Hermes failure wording"
                    (is (re-find #"Failed to get user input: boom"
                                 (str (h/json-parse out)))))))
        (p/then (fn [_]
                  (let [called (atom false)]
                    (-> (clarify/ask! [] (fn [_] (reset! called true)))
                        (p/then (fn [_]
                                  (testing "bad input beats the callback (validation first)"
                                    (is (false? @called))))
                                (fn [e] (is false (str "unexpected: " (str e))) nil))))))
        (p/then (fn [_] (done)))
        (p/catch (fn [e] (is false (str "unexpected: " (str e))) (done))))))
