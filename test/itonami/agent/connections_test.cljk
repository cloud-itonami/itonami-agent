(ns itonami.agent.connections-test
  "manage_connections slice 1: read-only connection surfaces — local MCP rows
  carry auth state without token values; hosted connectors answer the named
  unavailability."
  (:require [cljs.test :refer [deftest is testing]]
            [itonami.agent.host :as h]
            [itonami.agent.oauth :as oauth]
            [itonami.agent.connections :as connections]))

(deftest mcp-rows-carry-auth-state
  (let [home (h/join (h/tmp-dir) (str "test-conn-" (.-pid js/process) "-" (h/random-hex 4)))
        _ (h/mkdirs (h/join home "mcp-tokens"))
        config {"mcp_servers" {"srv" {"command" "x"} "other" {"url" "https://mcp.example"}}}]
    (testing "no cache file: needs-login (dapp rows ride alongside)"
      (let [rows (filter #(= "mcp" (get % "kind"))
                         (connections/connection-status config {} home nil))]
        (is (= 2 (count rows)))
        (is (every? #(= "mcp" (get % "kind")) rows))
        (is (every? #(true? (get % "configured")) rows))
        (is (every? #(= "needs-login" (get % "auth")) rows))))
    (testing "a cached, unexpired token reads as token-cached (never the value)"
      (h/spit (h/join home "mcp-tokens" (str (oauth/store-name "srv") ".json"))
              (h/json-str {"access_token" "SECRET" "expires_at" (+ 9999999999 (quot (h/now-ms) 1000))}))
      (let [rows (connections/connection-status config {} home nil)
            srv (first (filter #(= "srv" (get % "name")) rows))]
        (is (some? srv))
        (is (= "token-cached" (get srv "auth")))
        (is (not (re-find #"SECRET" (h/json-str rows))))))
    (testing "an expired token reads as token-expired; a corrupt one as token-unreadable"
      (h/spit (h/join home "mcp-tokens" (str (oauth/store-name "srv") ".json"))
              (h/json-str {"access_token" "SECRET" "expires_at" 100}))
      (is (= "token-expired" (get (first (filter #(= "srv" (get % "name"))
                                                 (connections/connection-status config {} home nil)))
                                  "auth")))
      (h/spit (h/join home "mcp-tokens" (str (oauth/store-name "srv") ".json")) "{not json")
      (is (= "token-unreadable" (get (first (filter #(= "srv" (get % "name"))
                                                   (connections/connection-status config {} home nil)))
                                    "auth"))))))

(deftest hosted-connectors-name-their-unavailability
  (let [rows (connections/connection-status {} {} "/tmp/no-home"
                                            [{"name" "gmail"} {"name" "srv" "mcp" true}])]
    (is (= connections/hosted-error (get-in (first rows) ["error"])))
    (is (= "hosted" (get-in (first rows) ["kind"])))
    (is (= "mcp" (get-in (second rows) ["kind"])))
    (is (false? (get-in (second rows) ["configured"])))))

(deftest malformed-requests-are-named
  (is (= "connectors must be objects like {name, mcp?}"
         (get (connections/connection-status {} {} "/tmp/x" ["not-a-map"]) "error"))))
