(ns itonami.agent.session-search-test
  "Hermes `tools/session_search_tool.py` cross-profile lookup
  (`_resolve_profile_db` + `hermes_cli/profiles.py` name gates) and the
  discovery `detail` modes (`_hydrate_hit` adaptive/full hydration)."
  (:require [cljs.test :refer [deftest is testing]]
            [clojure.string :as str]
            [itonami.agent.host :as h]
            [itonami.agent.tools :as tools]
            ["node:sqlite" :as sqlite]))

(defn- make-state-db!
  "A minimal Hermes-shaped state.db: `sessions`, `messages`, `messages_fts`
  (FTS5 rowid = messages.id, as the discover SQL joins them)."
  [path sessions messages]
  (h/mkdirs (h/dirname path))
  (let [db (sqlite/DatabaseSync. path)]
    (.exec db (str "CREATE TABLE sessions (id TEXT PRIMARY KEY, title TEXT, started_at INTEGER, "
                   "message_count INTEGER, source TEXT, hidden INTEGER, last_activity_at INTEGER, "
                   "parent_session_id TEXT, end_reason TEXT, model TEXT)"))
    (.exec db (str "CREATE TABLE messages (id INTEGER PRIMARY KEY, session_id TEXT, role TEXT, "
                   "content TEXT, timestamp INTEGER, active INTEGER, compacted INTEGER)"))
    (.exec db "CREATE VIRTUAL TABLE messages_fts USING fts5(content)")
    (doseq [s sessions]
      (let [st (.prepare db (str "INSERT INTO sessions (id, title, started_at, message_count, "
                                 "source, hidden, last_activity_at, parent_session_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?)"))]
        (js/Reflect.apply (.-run st) st
          (clj->js [(str (:id s)) (:title s) (:started s)
                    (count (filter #(= (:id s) (:session %)) messages))
                    (or (:source s) "chat") (if (:hidden s) 1 0) (:started s) (:parent s)]))))
    (doseq [m messages]
      (let [st (.prepare db (str "INSERT INTO messages (id, session_id, role, content, timestamp, "
                                 "active, compacted) VALUES (?, ?, ?, ?, ?, 1, 0)"))
            st2 (.prepare db "INSERT INTO messages_fts (rowid, content) VALUES (?, ?)")]
        (js/Reflect.apply (.-run st) st
          (clj->js [(:id m) (str (:session m)) (:role m) (:content m) (or (:timestamp m) 1000)]))
        (js/Reflect.apply (.-run st2) st2 (clj->js [(:id m) (:content m)]))))
    (.close db)))

(defn- call [ctx args] (h/json-parse (tools/session-search ctx args)))

(deftest cross-profile-lookup
  ;; Hermes session_search_tool.session_search: the `profile` argument and a raw
  ;; `@session:<profile>/<id>` link as session_id swap in the named profile's
  ;; state.db (read-only) for every shape; a bare id never scans other profiles
  ;; (_read_scoped's miss hint).
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")
        other (h/join root "profiles" "other")]
    (make-state-db! (h/join work "state.db")
                    [{:id "w1" :title "work" :started 100}]
                    [{:id 1 :session "w1" :role "user" :content "work only"}])
    (make-state-db! (h/join other "state.db")
                    [{:id "o1" :title "other" :started 200}]
                    [{:id 1 :session "o1" :role "user" :content "cross profile needle"}
                     {:id 2 :session "o1" :role "assistant" :content "answer"}])
    (let [ctx {:home work :cwd work}]
      (testing "profile= swaps in the named profile's state.db for every shape"
        (let [res (call ctx {"session_id" "o1" "profile" "other"})]
          (is (= "read" (get res "mode")))
          (is (= ["cross profile needle" "answer"]
                 (mapv #(get % "content") (get res "results"))))))
      (testing "a raw @session:<profile>/<id> link splits on '/' at the name gate (Hermes source: no prefix strip)"
        (let [res (call ctx {"session_id" "@session:other/o1"})]
          (is (str/includes? (str (get res "error")) "'@session:other' is not a valid profile name"))))
      (testing "the <profile>/<id> form resolves (ids never contain '/')"
        (let [res (call ctx {"session_id" "other/o1"})]
          (is (= "read" (get res "mode")))
          (is (= ["cross profile needle" "answer"]
                 (mapv #(get % "content") (get res "results"))))))
      (testing "an explicit profile= wins over the link's embedded profile"
        (let [res (call ctx {"session_id" "other/o1" "profile" "other"})]
          (is (= "read" (get res "mode")))
          (is (= 2 (count (get res "results"))))))
      (testing "unknown profile: Hermes' verbatim wrapper over the existence gate"
        (let [res (call ctx {"session_id" "x" "profile" "nope"})]
          (is (= "profile 'nope': profile 'nope' does not exist" (get res "error")))))
      (testing "invalid profile names fail at normalize/validate (reserved, grammar)"
        (let [res (call ctx {"session_id" "x" "profile" "@session:foo"})]
          (is (str/includes? (str (get res "error")) "is not a valid profile name")))
        (let [res (call ctx {"session_id" "x" "profile" "root"})]
          (is (str/includes? (str (get res "error")) "is reserved"))))
      (testing "a bare id misses with _read_scoped's hint (no cross-profile scan)"
        (let [res (call ctx {"session_id" "o1"})]
          (is (str/includes? (str (get res "error")) "session_id not found in this profile: o1"))
          (is (str/includes? (str (get res "error")) "pass profile=<name>"))))
      (testing "default resolves to the store root (hermes_cli.profiles.get_profile_dir)"
        (let [res (call ctx {"session_id" "w1" "profile" "default"})]
          ;; the store root exists but holds no state.db: the existence gate
          ;; passes and the read-only open fails, wrapped exactly as Hermes
          ;; wraps _resolve_profile_db errors (upstream's SessionDB open-error
          ;; text is not pinned here).
          (is (str/includes? (str (get res "error")) "profile 'default':")))
        (is (not (h/file? (h/join root "state.db"))))))
    (h/rm root)))

(deftest discovery-adaptive-detail
  ;; Hermes `_hydrate_hit`: adaptive fully hydrates only the top-ranked hit
  ;; (anchored window + bookends, detail "full"); lower hits carry just the
  ;; anchor message (detail "compact"). `detail: "full"` hydrates every hit.
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")
        s1-msgs (vec (for [i (range 1 21)]
                       {:id i :session "s1" :role (if (odd? i) "user" "assistant")
                        :content (if (= i 10) "the needle one" (str "filler " i))}))
        s2-msgs (vec (for [i (range 21 29)]
                       {:id i :session "s2" :role (if (odd? i) "user" "assistant")
                        :content (if (= i 24) "the needle two" (str "filler " i))}))]
    (make-state-db! (h/join work "state.db")
                    [{:id "s1" :title "alpha" :started 100}
                     {:id "s2" :title "beta" :started 200}]
                    (into s1-msgs s2-msgs))
    (let [ctx {:home work :cwd work}
          by-sid (fn [res] (into {} (map (juxt #(get % "session_id") identity) (get res "results"))))]
      (testing "adaptive (default): top hit full, the rest compact"
        (let [res (call ctx {"query" "needle"})]
          (is (= "discover" (get res "mode")))
          (is (= "adaptive" (get res "detail")))
          (is (= 2 (get res "count")))
          (is (= "full" (get-in res ["results" 0 "detail"])))
          (is (< 1 (count (get-in res ["results" 0 "messages"]))))
          (is (true? (some #(get % "anchor") (get-in res ["results" 0 "messages"]))))
          (let [compact (get-in res ["results" 1])]
            (is (= "compact" (get compact "detail")))
            (is (= 1 (count (get compact "messages"))))
            (is (true? (get (first (get compact "messages")) "anchor")))
            (is (= [] (get compact "bookend_start")))
            (is (= [] (get compact "bookend_end"))))))
      (testing "full: every hit hydrated with window + bookends (case-insensitive)"
        (let [res (call ctx {"query" "needle" "detail" "FULL"})
              m (by-sid res)]
          (is (= "full" (get res "detail")))
          (is (every? #(= "full" (get % "detail")) (get res "results")))
          (let [e (get m "s1")]
            ;; anchor id 10 of 20: window rn 5..15 (11 rows), bookends 3 + 3,
            ;; 4 rows before / 5 after the window.
            (is (= 11 (count (get e "messages"))))
            (is (= 4 (get e "messages_before")))
            (is (= 5 (get e "messages_after")))
            (is (= ["filler 1" "filler 2" "filler 3"]
                   (mapv #(get % "content") (get e "bookend_start"))))
            (is (= ["filler 18" "filler 19" "filler 20"]
                   (mapv #(get % "content") (get e "bookend_end"))))
            (is (true? (some #(get % "anchor") (get e "messages")))))
          (let [e (get m "s2")]
            ;; anchor id 24 of 8 rows: the whole session is the window.
            (is (= 8 (count (get e "messages"))))
            (is (= 0 (get e "messages_before")))
            (is (= 0 (get e "messages_after")))
            (is (= [] (get e "bookend_start")))
            (is (= [] (get e "bookend_end")))))))
    (h/rm root)))

(deftest parse-bound
  ;; Hermes tests/tools/test_session_search.py TestDiscoveryTemporalNarrowing.test_parse_bound
  (let [p tools/session-parse-iso-bound
        now (js/Math.floor (/ (.now js/Date) 1000))
        unix (fn [y mo d] (js/Math.floor (/ (js/Date.UTC y (dec mo) d) 1000)))]
    (is (nil? (p nil)))
    (is (nil? (p "")))
    (doseq [[value expected] [["24h" 86400] ["1d" 86400] ["2w" (* 2 604800)]
                              ["7D" (* 7 86400)] [" 3 d " (* 3 86400)]]]
      (is (< (js/Math.abs (- (- now (p value)) expected)) 5) value))
    (is (= (unix 2026 6 1) (p "2026-06-01")))
    (is (= (+ (unix 2026 6 1) 43200) (p "2026-06-01T12:00:00Z")))
    (doseq [bad ["7x" "not-a-date"]]
      (let [e (try (p bad) nil (catch :default e e))]
        (is (instance? js/Error e) bad)
        (is (= (str "invalid time bound: '" bad "' (expected ISO date/datetime like 2026-07-01, "
                    "or a relative duration like 7d, 24h, 2w)")
               (.-message e)) bad)))))

(deftest exclude-id-normalization
  ;; `_normalize_exclude_session_ids`: deduped, stripped ids from a string or
  ;; list, capped at `_EXCLUDE_SESSION_IDS_CAP` (20).
  (is (= ["a"] (tools/session-normalize-exclude-ids " a ")))
  (is (= ["a" "b"] (tools/session-normalize-exclude-ids ["a" " a " "b" 7 nil])))
  (is (= 20 (count (tools/session-normalize-exclude-ids (mapv #(str "id-" %) (range 30))))))
  (is (= [] (tools/session-normalize-exclude-ids {"not" "a list"}))))

(deftest discovery-time-bounds-in-sql
  ;; Hermes test_iso_window_is_applied_in_sql_not_as_a_post_filter: the bound is
  ;; `s.started_at >= ?` / `s.started_at < ?` inside the query (`_search_filter_clauses`)
  ;; so LIMIT cannot be filled by out-of-window hits; an invalid bound is a tool
  ;; error (`_dispatch` surfaces `str(e)`), not a silent unbounded search.
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")
        epoch (fn [y mo d] (js/Math.floor (/ (js/Date.UTC y (dec mo) d) 1000)))
        aug-sessions (mapv (fn [i] {:id (str "s_aug_" i) :title "aug" :started (epoch 2026 8 10)})
                           (range 4))
        aug-msgs (vec (mapcat (fn [i]
                                [{:id (inc (* 2 i)) :session (str "s_aug_" i) :role "user"
                                  :content "modpack modpack modpack modpack"}
                                 {:id (+ 2 (* 2 i)) :session (str "s_aug_" i) :role "assistant"
                                  :content "modpack details"}])
                              (range 4)))]
    (make-state-db! (h/join work "state.db")
                    (conj aug-sessions {:id "s_june" :title "june" :started (epoch 2026 6 15)})
                    (conj aug-msgs
                          {:id 100 :session "s_june" :role "user" :content "modpack"}
                          {:id 101 :session "s_june" :role "assistant" :content "ok"}))
    (let [ctx {:home work :cwd work}]
      (testing "the window is SQL-side: limit 2 cannot be filled by out-of-window rows"
        (let [res (call ctx {"query" "modpack" "limit" 2 "after" "2026-01-01" "before" "2026-07-01"})]
          (is (= "discover" (get res "mode")))
          (is (= 1 (get res "count")))
          (is (= ["s_june"] (distinct (mapv #(get % "session_id") (get res "results")))))))
      (testing "an invalid bound is a tool error, not a silent unbounded search"
        (let [res (call ctx {"query" "modpack" "after" "not-a-date"})]
          (is (= (str "invalid time bound: 'not-a-date' (expected ISO date/datetime like 2026-07-01, "
                      "or a relative duration like 7d, 24h, 2w)")
                 (get res "error"))))))
    (h/rm root)))

(deftest discovery-relative-bounds-and-exclusion
  ;; Hermes test_relative_bounds_reach_the_tool_through_the_inline_executor:
  ;; after="7d" keeps the last week, before="7d" keeps everything older,
  ;; exclude_session_ids omits the named hits.
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")
        now (js/Math.floor (/ (.now js/Date) 1000))
        day 86400]
    (make-state-db! (h/join work "state.db")
                    [{:id "s_newest" :title "newest" :started (- now (* 2 day))}
                     {:id "s_middle" :title "middle" :started (- now (* 30 day))}
                     {:id "s_oldest" :title "oldest" :started (- now (* 60 day))}]
                    [{:id 1 :session "s_newest" :role "user" :content "modpack newest"}
                     {:id 2 :session "s_newest" :role "assistant" :content "modpack answer"}
                     {:id 3 :session "s_middle" :role "user" :content "modpack middle"}
                     {:id 4 :session "s_middle" :role "assistant" :content "modpack answer"}
                     {:id 5 :session "s_oldest" :role "user" :content "modpack oldest"}
                     {:id 6 :session "s_oldest" :role "assistant" :content "modpack answer"}])
    (let [ctx {:home work :cwd work}
          sids (fn [res] (set (mapv #(get % "session_id") (get res "results"))))]
      (testing "after=\"7d\" keeps the last week"
        (is (= #{"s_newest"} (sids (call ctx {"query" "modpack" "limit" 5 "after" "7d"})))))
      (testing "before=\"7d\" keeps everything older"
        (is (= #{"s_middle" "s_oldest"} (sids (call ctx {"query" "modpack" "limit" 5 "before" "7d"})))))
      (testing "exclude_session_ids omits the named session"
        (is (= #{"s_middle" "s_oldest"}
               (sids (call ctx {"query" "modpack" "limit" 5 "exclude_session_ids" ["s_newest"]}))))))
    (h/rm root)))

(deftest fts-syntax-errors-degrade-but-io-errors-surface
  ;; the R1 gate: only fts5 SYNTAX errors become "no content rows"; a
  ;; blanket catch would turn corruption/IO into a successful empty result
  (testing "an unbalanced-quote query degrades to empty content rows, not a throw"
    (let [root (h/join (h/tmp-dir) (str "itonami-fts-degrade-" (h/random-hex 4)))
          work (h/join root "profiles" "work")]
      (make-state-db! (h/join work "state.db")
                      [{:id "s1" :title "don't panic" :started 100}]
                      [{:id 1 :session "s1" :role "user" :content "don't panic"}])
      (let [res (call {:home work :cwd work} {"query" "don't"})]
        (is (nil? (get res "error")) "an fts5 syntax error is not a tool error")
        (is (map? res))))))

(deftest fts-corruption-surfaces-never-empties
  ;; the negative control for the degrade gate, pinned at the BOUNDARY and
  ;; FUNCTIONALLY: an fts5 corruption message must NOT satisfy the degrade
  ;; predicate (an earlier version of this test 'corrupted' the index with
  ;; integrity-check + DELETE, neither of which corrupts anything — it
  ;; verified nothing), and a real schema failure surfaces as a tool error
  (testing "the degrade predicate is syntax-only"
    (is (true? (#'tools/fts-syntax-error? (js/Error. "fts5: syntax error near \"x\""))))
    (is (false? (#'tools/fts-syntax-error? (js/Error. "fts5: corrupt structure record"))))
    (is (false? (#'tools/fts-syntax-error? (js/Error. "disk I/O error")))))
  (testing "a missing fts table surfaces as a tool error, not an empty result"
    (let [root (h/join (h/tmp-dir) (str "itonami-fts-corrupt-" (h/random-hex 4)))
          work (h/join root "profiles" "work")]
      (make-state-db! (h/join work "state.db")
                      [{:id "s1" :title "alpha" :started 100}]
                      [{:id 1 :session "s1" :role "user" :content "needle"}])
      (let [db (sqlite/DatabaseSync. (h/join work "state.db"))]
        (.exec db "DROP TABLE messages_fts")
        (.close db))
      (let [res (try {:r (call {:home work :cwd work} {"query" "needle"})}
                     (catch :default e {:e (str e)}))]
        ;; the handler raises and the dispatch layer (tools/call) maps that
        ;; to a named error — either way it must NOT read as a clean empty
        ;; discovery
        (is (or (:e res) (string? (get-in res [:r "error"])))
            "a schema failure surfaces — it is not a clean empty discovery")))))

(deftest exclusion-drops-whole-lineage
  ;; Hermes test_exclude_session_ids_drops_whole_lineage (`_excluded_lineage_roots`):
  ;; a child id also hides its parent chain, and the exclusion backfills from the
  ;; scan instead of starving the limit. Without exclusion the parent/child
  ;; lineage surfaces ONCE (`_discover`'s dedup), so the assertion pins count,
  ;; not the exact winning session.
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")]
    (make-state-db! (h/join work "state.db")
                    [{:id "s_root" :title "root" :started 100}
                     {:id "s_child" :title "child" :started 200 :parent "s_root"}]
                    [{:id 1 :session "s_root" :role "user" :content "unique lineage token alpha"}
                     {:id 2 :session "s_root" :role "assistant" :content "noted unique lineage token alpha"}
                     {:id 3 :session "s_child" :role "user" :content "follow-up unique lineage token alpha"}
                     {:id 4 :session "s_child" :role "assistant" :content "child unique lineage token alpha"}])
    (let [ctx {:home work :cwd work}
          sids (fn [res] (set (mapv #(get % "session_id") (get res "results"))))]
      (testing "without exclusion the lineage is one hit (deduped), not two"
        (let [res (call ctx {"query" "unique lineage token alpha" "limit" 5})]
          (is (= 1 (get res "count")))
          (is (= 1 (count (sids res))))
          (is (contains? #{"s_root" "s_child"} (first (sids res))))))
      (testing "excluding the child drops the child AND its parent chain"
        (is (= #{} (sids (call ctx {"query" "unique lineage token alpha" "limit" 5
                                    "exclude_session_ids" ["s_child"]})))))
      (testing "excluding the parent drops the whole lineage (a bare string is one id)"
        (is (= #{} (sids (call ctx {"query" "unique lineage token alpha" "limit" 5
                                    "exclude_session_ids" "s_root"}))))))
    (h/rm root)))

(deftest discovery-sort-temporal-bias
  ;; hermes_state_search.py `_FTS_ORDER_BY`: "newest" = `ORDER BY m.timestamp DESC,
  ;; rank`, "oldest" = `ORDER BY m.timestamp ASC, rank`; an unknown sort value is
  ;; rank-only (session_search_tool._dispatch passes None through).
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")]
    (make-state-db! (h/join work "state.db")
                    [{:id "s_a" :title "a" :started 100}
                     {:id "s_b" :title "b" :started 200}
                     {:id "s_c" :title "c" :started 300}]
                    [{:id 1 :session "s_a" :role "user" :content "needle alpha" :timestamp 30}
                     {:id 2 :session "s_b" :role "user" :content "needle beta" :timestamp 20}
                     {:id 3 :session "s_c" :role "user" :content "needle gamma" :timestamp 10}])
    (let [ctx {:home work :cwd work}
          first-sid (fn [res] (get (first (get res "results")) "session_id"))]
      (testing "newest: the most recent matching message first"
        (is (= "s_a" (first-sid (call ctx {"query" "needle" "sort" "newest"})))))
      (testing "oldest: the oldest matching message first"
        (is (= "s_c" (first-sid (call ctx {"query" "needle" "sort" "oldest"})))))
      (testing "an unknown sort value is rank-only"
        (is (= 3 (get (call ctx {"query" "needle" "sort" "bogus"}) "count")))))
    (h/rm root)))

(deftest title-match-surfaces-titled-session
  ;; Hermes `_title_match_result`: a query matching a session TITLE surfaces that
  ;; session as a discovery entry even when no message matches — `role`
  ;; "session_title", `snippet` "Session title matched: <title>", anchored on the
  ;; session's first message, always detail "full".
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")]
    (make-state-db! (h/join work "state.db")
                    [{:id "s_titled" :title "quasar ledger reconciliation" :started 100}]
                    [{:id 1 :session "s_titled" :role "user" :content "filler one"}
                     {:id 2 :session "s_titled" :role "assistant" :content "filler two"}])
    (let [ctx {:home work :cwd work}]
      (testing "the title hit anchors on the first message and hydrates full"
        (let [res (call ctx {"query" "quasar ledger reconciliation"})
              entry (get-in res ["results" 0])]
          (is (= "discover" (get res "mode")))
          (is (= 1 (get res "count")))
          (is (= "s_titled" (get entry "session_id")))
          (is (= "session_title" (get entry "role")))
          (is (= "Session title matched: quasar ledger reconciliation" (get entry "snippet")))
          (is (= "full" (get entry "detail")))
          (is (= 1 (get entry "match_message_id")))
          (is (true? (some #(get % "anchor") (get entry "messages"))))
          (is (= ["filler one" "filler two"] (mapv #(get % "content") (get entry "messages"))))
          (is (= [] (get entry "bookend_start")))
          (is (= [] (get entry "bookend_end")))))
      (testing "a quoted remembered title still matches (Hermes strips surrounding ' and \")"
        (is (= ["s_titled"] (mapv #(get % "session_id")
                                  (get (call ctx {"query" "'quasar ledger reconciliation'"}) "results"))))
        (is (= ["s_titled"] (mapv #(get % "session_id")
                                  (get (call ctx {"query" "\"quasar ledger reconciliation\""}) "results")))))
      (testing "a query matching neither titles nor messages finds nothing"
        (is (= 0 (get (call ctx {"query" "no such topic anywhere"}) "count")))))
    (h/rm root)))

(deftest title-match-resolution-precedence
  ;; Hermes `resolve_session_by_title`: a `title #N` continuation outranks the
  ;; exact title (newest started_at first), and LIKE wildcards in titles are
  ;; escaped (hermes_state_common.escape_like) so `test_project` cannot resolve
  ;; through `testXproject #2`.
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")]
    (make-state-db! (h/join work "state.db")
                    [{:id "s_exact" :title "modpack overhaul plan" :started 100}
                     {:id "s_num" :title "modpack overhaul plan #2" :started 200}
                     {:id "s_under" :title "test_project" :started 100}
                     {:id "s_x" :title "testXproject #2" :started 200}]
                    [{:id 1 :session "s_exact" :role "user" :content "filler one"}
                     {:id 2 :session "s_num" :role "user" :content "filler two"}
                     {:id 3 :session "s_under" :role "user" :content "filler three"}
                     {:id 4 :session "s_x" :role "user" :content "filler four"}])
    (let [ctx {:home work :cwd work}
          sid-of (fn [q] (get-in (call ctx {"query" q}) ["results" 0 "session_id"]))]
      (testing "the newest <title> #N continuation outranks the exact title"
        (is (= "s_num" (sid-of "modpack overhaul plan")))
        (is (= "s_num" (sid-of "'modpack overhaul plan'"))))
      (testing "LIKE wildcards are escaped: test_project resolves exactly, never testXproject #2"
        (is (= "s_under" (sid-of "test_project")))))
    (h/rm root)))

(deftest title-match-gates
  ;; The title hit bypasses the bounded FTS query, so `_discover` re-checks the
  ;; after/before window in code; hidden/integration sessions are gated like
  ;; every discovery row; exclusion drops the title lineage; and the title hit
  ;; owns one `limit` slot and the `full` detail slot under adaptive.
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")
        epoch (fn [y mo d] (js/Math.floor (/ (js/Date.UTC y (dec mo) d) 1000)))]
    (make-state-db! (h/join work "state.db")
                    [{:id "s_titled" :title "deep dive widgets" :started (epoch 2026 6 15)}
                     {:id "s_fts" :title "fts side" :started (epoch 2026 8 10)}
                     {:id "s_hidden" :title "ghost story" :started (epoch 2026 9 1) :hidden true}
                     {:id "s_tool" :title "tooling topic" :started (epoch 2026 9 2) :source "tool"}]
                    [{:id 1 :session "s_titled" :role "user" :content "filler one"}
                     {:id 2 :session "s_titled" :role "assistant" :content "filler two"}
                     {:id 3 :session "s_fts" :role "user" :content "deep dive widgets in content"}
                     {:id 4 :session "s_hidden" :role "user" :content "filler three"}
                     {:id 5 :session "s_tool" :role "user" :content "filler four"}])
    (let [ctx {:home work :cwd work}
          sids (fn [res] (mapv #(get % "session_id") (get res "results")))]
      (testing "the title hit leads and takes the adaptive `full` slot; FTS hits stay compact"
        (let [res (call ctx {"query" "deep dive widgets"})]
          (is (= 2 (get res "count")))
          (is (= ["s_titled" "s_fts"] (sids res)))
          (is (= "session_title" (get-in res ["results" 0 "role"])))
          (is (= "full" (get-in res ["results" 0 "detail"])))
          (is (= "compact" (get-in res ["results" 1 "detail"])))))
      (testing "the title hit owns one limit slot"
        (let [res (call ctx {"query" "deep dive widgets" "limit" 1})]
          (is (= ["s_titled"] (sids res)))))
      (testing "the window is re-checked for the title hit (it bypasses the bounded FTS query)"
        (let [res (call ctx {"query" "deep dive widgets" "after" "2026-07-01"})]
          (is (= ["s_fts"] (sids res)))))
      (testing "exclusion drops the title lineage"
        (let [res (call ctx {"query" "deep dive widgets" "exclude_session_ids" ["s_titled"]})]
          (is (= ["s_fts"] (sids res)))))
      (testing "hidden and integration sessions hold no discoverable title"
        (is (= 0 (get (call ctx {"query" "ghost story"}) "count")))
        (is (= 0 (get (call ctx {"query" "tooling topic"}) "count")))))
    (h/rm root)))

(deftest lineage-dedup-one-hit-per-lineage
  ;; Hermes `_discover`'s dedup: one hit per lineage root (first surviving scan
  ;; row wins) — parent/child runs of one session never surface as duplicate
  ;; hits, and a child hit carries `parent_session_id` (Hermes
  ;; `_discovery_entry`). Rank ties fall to `m.id DESC`, so with identical
  ;; contents the newest matching message's session owns the hit.
  (let [root (h/join (h/tmp-dir) (str "itonami-session-search-" (h/random-hex 4)))
        work (h/join root "profiles" "work")]
    (make-state-db! (h/join work "state.db")
                    [{:id "s_root" :title "root" :started 100}
                     {:id "s_child" :title "shared lineage recap" :started 200 :parent "s_root"}
                     {:id "s_alone" :title "alone" :started 300}]
                    [{:id 1 :session "s_root" :role "user" :content "shared lineage token"}
                     {:id 2 :session "s_child" :role "user" :content "shared lineage token"}
                     {:id 3 :session "s_alone" :role "user" :content "shared lineage token"}])
    (let [ctx {:home work :cwd work}]
      (testing "parent and child collapse to one hit, grouped under the lineage root"
        (let [res (call ctx {"query" "shared lineage token" "limit" 5})]
          (is (= 2 (get res "count")))
          (is (= ["s_alone" "s_child"] (mapv #(get % "session_id") (get res "results"))))
          (is (= [nil "s_root"] (mapv #(get % "parent_session_id") (get res "results"))))))
      (testing "a title hit in a child groups under its lineage root too"
        (let [res (call ctx {"query" "shared lineage recap"})
              entry (get-in res ["results" 0])]
          (is (= 1 (get res "count")))
          (is (= "s_child" (get entry "session_id")))
          (is (= "s_root" (get entry "parent_session_id")))
          (is (= "session_title" (get entry "role")))))
      (testing "excluding a lineage member leaves the unrelated hit"
        (let [res (call ctx {"query" "shared lineage token" "limit" 5 "exclude_session_ids" ["s_child"]})]
          (is (= ["s_alone"] (mapv #(get % "session_id") (get res "results")))))))
    (h/rm root)))
