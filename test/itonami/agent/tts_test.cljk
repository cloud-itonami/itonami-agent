(ns itonami.agent.tts-test
  "text_to_speech slice 1: provider-backed synthesis — configured answers
  nothing when incomplete, the request is pure, and the audio lands in the
  workspace with a named result (or a named error)."
  (:require [cljs.test :refer [deftest is testing async]]
            [promesa.core :as p]
            [itonami.agent.host :as h]
            [itonami.agent.tts :as tts]))

(deftest configured-never-guesses
  (is (nil? (tts/configured {})))
  (is (nil? (tts/configured {"tts" {"provider" "murakumo"}})))
  (is (nil? (tts/configured {"tts" {"model" "x"}})))
  (let [c (tts/configured {"tts" {"provider" "murakumo" "model" "tts-1"}})]
    (is (= "murakumo" (:provider c)))
    (is (= "tts-1" (:model c)))
    (is (= "alloy" (:voice c))))
  (is (= "nova" (:voice (tts/configured {"tts" {"provider" "p" "model" "m" "voice" "nova"}}))))
  (testing "a blank configured voice is unset: it defaults to alloy"
    (is (= "alloy" (:voice (tts/configured {"tts" {"provider" "p" "model" "m" "voice" ""}}))))
    (is (= "alloy" (:voice (tts/configured {"tts" {"provider" "p" "model" "m" "voice" "   "}}))))))

(deftest speech-request-shape
  (let [req (tts/speech-request {:base-url "https://api.x/v1" :model "tts-1" :token "T" :headers {}} "nova" "hi" "mp3")]
    (is (= "https://api.x/v1/audio/speech" (:url req)))
    (is (= "Bearer T" (get-in req [:headers "Authorization"])))
    (is (= "application/json" (get-in req [:headers "Content-Type"])))
    (let [body (js->clj (js/JSON.parse (:body req)))]
      (is (= "tts-1" (get body "model")))
      (is (= "nova" (get body "voice")))
      (is (= "hi" (get body "input")))
      (is (= "mp3" (get body "response_format"))))))

(deftest timeout-clamp-floors-and-caps
  (testing "the floor: tiny values cannot abort instantly"
    (is (= 1 (tts/clamp-timeout-s 0.001)))
    (is (= 1 (tts/clamp-timeout-s 0.5))))
  (testing "the cap: huge values cannot collapse Node's setTimeout"
    (is (= 600 (tts/clamp-timeout-s 2147484)))
    (is (= 600 (tts/clamp-timeout-s 1e12))))
  (testing "numeric strings coerce; unusable values land on the cap"
    (is (= 30 (tts/clamp-timeout-s "30")))
    (is (= 600 (tts/clamp-timeout-s "abc")))
    (is (= 600 (tts/clamp-timeout-s nil)))
    (is (= 600 (tts/clamp-timeout-s -5))))
  (testing "in range, unchanged; the hop's 900 s default is capped"
    (is (= 300 (tts/clamp-timeout-s 300)))
    (is (= 600 (tts/clamp-timeout-s 900)))))

(deftest synthesize-fails-named-on-every-branch
  ;; async: the assertions ride the promise chain and the test awaits them
  (async done
    (let [cfg {"tts" {"provider" "x" "model" "m"} "providers" {"x" {"kind" "send_json_base" "base_url" "https://api.x/v1" "model" "m"}}}]
      (-> (tts/synthesize! cfg "/tmp/tts-no-home" {"text" "hi" "format" "mp3"}
                           (fn [_ _] (js/Promise.reject (js/Error. "ECONNRESET")))
                           (constantly true))
          (promesa.core/then (fn [r]
                               (is (re-find #"speech request failed: ECONNRESET" (str (get r "error"))))))
          (promesa.core/then (fn [_]
                               (tts/synthesize! cfg "/tmp/tts-no-home" {"text" "hi" "format" "mp3"}
                                                (fn [_ _] (js/Promise.resolve #js {:ok false :status 502}))
                                                (constantly true))))
          (promesa.core/then (fn [r]
                               (is (= "speech request failed: HTTP 502" (get r "error")))))
          (promesa.core/then (fn [_] (done)))
          (promesa.core/catch (fn [e] (is false (str "unexpected: " (str e))) (done)))))))

(deftest synthesize-refuses-a-path-outside-roots
  ;; the roots gate runs BEFORE the write and refuses it — like write-file
  (async done
    (let [cfg {"tts" {"provider" "x" "model" "m"} "providers" {"x" {"kind" "send_json_base" "base_url" "https://api.x/v1" "model" "m"}}}
          ;; a FRESH home per run: a fixed path accumulates stale artifacts
          ;; that make the no-file assertion lie (it did)
          home (h/join (h/tmp-dir) (str "test-tts-refuse-" (.-pid js/process) "-" (h/random-hex 4)))
          fake-fetch (fn [_ _] (js/Promise.resolve #js {:ok true :status 200
                                                        :arrayBuffer (fn [] (js/Promise.resolve (js/Buffer.from "abc")))}))]
      (-> (tts/synthesize! cfg home {"text" "hi" "format" "mp3"} fake-fetch (constantly false))
          (promesa.core/then (fn [r]
                               (is (= "speech write refused: outside the permitted roots" (get r "error")))
                               (is (nil? (get r "path")))
                               ;; and NO file was created — the gate runs before
                               ;; the write. The out-path is DERIVED with the
                               ;; repo's own hash functions: a hardcoded hex
                               ;; would silently go vacuous (a prior round's
                               ;; did — it matched no cache key variant)
                               (let [voice (get (tts/configured cfg) :voice)
                                     model (get (tts/configured cfg) :model)
                                     out-path (h/join home "workspace" "tts"
                                                      (str (h/sha256-hex (h/json-str ["hi" voice model "mp3" "x" "https://api.x/v1"])) ".mp3"))]
                                 (is (not (h/file? out-path))))))
          (promesa.core/then (fn [_] (done)))
          (promesa.core/catch (fn [e] (is false (str "unexpected: " (str e))) (done)))))))

(deftest synthesize-fails-named-on-read-and-write
  (async done
    (let [cfg {"tts" {"provider" "x" "model" "m"} "providers" {"x" {"kind" "send_json_base" "base_url" "https://api.x/v1" "model" "m"}}}]
      (-> (tts/synthesize! cfg "/tmp/tts-no-home" {"text" "hi" "format" "mp3"}
                           (fn [_ _] (js/Promise.resolve #js {:ok true :status 200
                                                              :arrayBuffer (fn [] (js/Promise.reject (js/Error. "body EOF")))}))
                           (constantly true))
          (p/then (fn [r] (is (re-find #"speech read failed: body EOF" (str (get r "error"))))))
          (p/then (fn [_]
                    ;; deterministic write failure: workspace/tts pre-created
                    ;; as a REGULAR FILE, so h/mkdirs cannot make the dir
                    (let [home "/tmp/tts-nowrite-home"]
                      (h/mkdirs home)
                      (h/spit (h/join home "workspace-file-keeper") "x")
                      (h/mkdirs (h/join home "workspace"))
                      (h/spit (h/join home "workspace" "tts") "not a directory")
                      (tts/synthesize! cfg home {"text" "hi" "format" "mp3"}
                                       (fn [_ _] (js/Promise.resolve #js {:ok true :status 200
                                                                          :arrayBuffer (fn [] (js/Promise.resolve (js/Buffer.from "abc")))}))
                                       (constantly true)))))
          (p/then (fn [r] (is (re-find #"speech write failed" (str (get r "error"))))))
          (p/then (fn [_] (done)))
          (p/catch (fn [e] (is false (str "unexpected: " (str e))) (done)))))))

(deftest synthesize-writes-the-audio
  (async done
    (let [home (h/join (h/tmp-dir) (str "test-tts-" (.-pid js/process) "-" (h/random-hex 4)))
          captured (atom nil)
          fake-fetch (fn [url opts]
                       (reset! captured {:url url :body (.-body opts)})
                       (p/resolved #js {:ok true
                                        :status 200
                                        :arrayBuffer (fn [] (p/resolved (js/Buffer.from "AUDIO"))) }))
          config {"tts" {"provider" "p1" "model" "tts-1" "voice" "nova"}
                  "providers" {"p1" {"base_url" "https://api.x/v1" "key_env" "X_TOKEN"}}}]
      (aset (.-env js/process) "X_TOKEN" "TOK")
      (-> (tts/synthesize! config home {"text" "hello world"} fake-fetch)
          (p/then (fn [r]
                    (is (nil? (get r "error")))
                    (is (= "mp3" (get r "format")))
                    (is (h/file? (get r "path")))
                    (is (re-find #"workspace/tts/" (get r "path")))
                    (is (re-find #"audio/speech" (:url @captured)))
                    (testing "the wire body carries model and voice"
                      (let [body (h/json-parse (str (:body @captured)))]
                        (is (= "tts-1" (get body "model")))
                        (is (= "nova" (get body "voice")))))))
          (p/finally (fn [] (js-delete (.-env js/process) "X_TOKEN") (done)))
          (p/catch (fn [e] (is false (str "unexpected: " (str e))) (done)))))))

(deftest synthesize-hardening
  (async done
    (let [home (h/join (h/tmp-dir) (str "test-tts-hardening-" (.-pid js/process) "-" (h/random-hex 4)))
          config {"tts" {"provider" "p1" "model" "tts-1" "voice" "nova"}
                  "providers" {"p1" {"base_url" "https://api.x/v1" "key_env" "X_TOKEN"}}}
          fake-ok (fn [_ _] (p/resolved #js {:ok true :status 200
                                             :arrayBuffer (fn [] (p/resolved (js/Buffer.from "AUDIO")))}))]
      (aset (.-env js/process) "X_TOKEN" "TOK")
      (-> (tts/synthesize! config home {"text" "t" "format" "x/../../../evil"} fake-ok)
          (p/then (fn [r]
                    (testing "a traversal format is refused before any send"
                      (is (re-find #"alphanumeric" (str (get r "error")))))))
          (p/then (fn [_] (tts/synthesize! config home {"text" "t" "format" "" "voice" "" "model" ""} fake-ok)))
          (p/then (fn [r]
                    (testing "empty strings fall back to the configured defaults"
                      (is (nil? (get r "error")))
                      (is (= "mp3" (get r "format"))))))
          (p/then (fn [_] (tts/synthesize! config home {"text" "same" "voice" "v1"} fake-ok)))
          (p/then (fn [r1]
                    (-> (tts/synthesize! config home {"text" "same" "voice" "v2"} fake-ok)
                        (p/then (fn [r2]
                                  (testing "same text with a different voice lands in a different file"
                                    (is (not= (get r1 "path") (get r2 "path")))))))))
          (p/then (fn [_] (tts/synthesize! config home {"text" "a|b" "voice" "c"} fake-ok)))
          (p/then (fn [r1]
                    (-> (tts/synthesize! config home {"text" "a" "voice" "b|c"} fake-ok)
                        (p/then (fn [r2]
                                  (testing "delimiter-bearing fields cannot collide on one path"
                                    (is (not= (get r1 "path") (get r2 "path")))))))))
          (p/then (fn [_]
                    (js-delete (.-env js/process) "X_TOKEN")
                    (tts/synthesize! config home {"text" "t"} fake-ok)))
          (p/then (fn [r]
                    (testing "an unset credential is a named error, not a doomed 401"
                      (is (re-find #"missing credentials" (str (get r "error")))))))
          (p/then (fn [_] (done)))
          (p/catch (fn [e] (is false (str "unexpected: " (str e))) (done)))))))

(deftest synthesize-named-errors
  (async done
    (let [home "/tmp/nope"
          called (atom false)
          fake-fetch (fn [_ _] (reset! called true) (p/resolved #js {:ok true :status 200}))]
      (-> (tts/synthesize! {} home {"text" "x"} fake-fetch)
          (p/then (fn [r] (is (re-find #"not configured" (str (get r "error"))))))
          (p/then (fn [_] (tts/synthesize! {"tts" {"provider" "p1" "model" "m"}}
                                           home {"text" "  "} fake-fetch)))
          (p/then (fn [r] (is (re-find #"text is required" (str (get r "error"))))))
          (p/then (fn [_]
                    (tts/synthesize! {"tts" {"provider" "p1" "model" "m"}
                                      "providers" {"p1" {"base_url" "https://api.x/v1"}}}
                                     home {"text" "x"}
                                     (fn [_ _] (p/resolved #js {:ok false :status 500})))))
          (p/then (fn [r] (is (re-find #"HTTP 500" (str (get r "error"))))))
          (p/then (fn [_] (is (false? @called))))
          (p/then (fn [_] (done)))
          (p/catch (fn [e] (is false (str "unexpected: " (str e))) (done)))))))
