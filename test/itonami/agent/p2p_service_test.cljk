(ns itonami.agent.p2p-service-test
  "ADR-0145 P1's client adapter: kekkai :netmap/services records become the
  peer-info fragments infer-peers resolves against. The fail-closed rule is
  the point -- an offer without a digest is unverified and never a candidate."
  (:require [cljs.test :refer [deftest is testing]]
            [itonami.agent.p2p :as p2p]))

(def ok-rec
  {:service/did "did:key:zServer"
   :service/multiaddr "/ip4/127.0.0.1/tcp/41643"
   :service/engine "kotoba-inference"
   :service/model-id "mishima"
   :service/digest "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
   :service/epoch 7})

(deftest valid-records-become-peer-infos
  (is (= [{:did "did:key:zServer" "models" ["mishima"] "load" 0}]
         (p2p/service-records->peer-infos [ok-rec]))))

(deftest same-did-merges-model-lists
  (let [got (p2p/service-records->peer-infos
             [ok-rec (assoc ok-rec :service/model-id "qwen3.8" :service/epoch 2)])]
    (is (= 1 (count got)))
    (is (= ["mishima" "qwen3.8"] (get (first got) "models")))))

(deftest invalid-records-are-dropped-not-repaired
  (testing "no digest -> unverified -> never a candidate"
    (is (= [] (p2p/service-records->peer-infos [(dissoc ok-rec :service/digest)]))))
  (testing "bad epoch / missing keys / wrong shapes drop individually"
    (is (= [] (p2p/service-records->peer-infos [(assoc ok-rec :service/epoch 0)])))
    (is (= [] (p2p/service-records->peer-infos [{:service/did "did:key:zX"}])))
    (is (= [] (p2p/service-records->peer-infos ["not-a-map"]))))
  (testing "a mixed batch keeps only the valid entries"
    (is (= ["did:key:zServer"]
           (mapv :did (p2p/service-records->peer-infos
                       [ok-rec (dissoc ok-rec :service/model-id)]))))))

(deftest empty-in-empty-out
  (is (= [] (p2p/service-records->peer-infos [])))
  (is (= [] (p2p/service-records->peer-infos nil))))

;; ── overlay: records are the offer of record, discovery is liveness ─────────

(def live-infos
  [{:did "did:key:zServer" "models" ["stale-name"] "load" 2}
   {:did "did:key:zOther" "models" ["qwen3.8"] "load" 5}
   {:did "did:key:zDown" :error "unreachable" "models" []}])

(deftest overlay-lets-records-name-the-lend-list
  (let [got (p2p/overlay-service-records live-infos [ok-rec])]
    (is (= ["mishima"] (get (first (filter #(= "did:key:zServer" (:did %)) got)) "models")))
    (testing "load and liveness come from discovery, not from records"
      (is (= 2 (get (first (filter #(= "did:key:zServer" (:did %)) got)) "load"))))))

(deftest overlay-leaves-recordless-dids-untouched
  (let [got (p2p/overlay-service-records live-infos [ok-rec])]
    (is (= ["qwen3.8"] (get (first (filter #(= "did:key:zOther" (:did %)) got)) "models")))
    (is (= 3 (count got)))))

(deftest overlay-ignores-invalid-records
  (let [got (p2p/overlay-service-records live-infos [(dissoc ok-rec :service/digest)])]
    (is (= ["stale-name"] (get (first (filter #(= "did:key:zServer" (:did %)) got)) "models")))))

(deftest overlay-does-not-append-unreachable-offers
  ;; zGhost has a valid record but discovery never reached it: not a candidate.
  (let [got (p2p/overlay-service-records live-infos [(assoc ok-rec :service/did "did:key:zGhost")])]
    (is (= 3 (count got)))
    (is (nil? (some #(= "did:key:zGhost" (:did %)) got)))))

(deftest overlay-honors-everything-at-once
  (let [got (p2p/overlay-service-records
             live-infos
             [ok-rec
              (assoc ok-rec :service/model-id "qwen3.8" :service/epoch 9)
              (assoc ok-rec :service/did "did:key:zDown" :service/model-id "mishima")
              (dissoc ok-rec :service/digest)])]
    (is (= ["mishima" "qwen3.8"]
           (get (first (filter #(= "did:key:zServer" (:did %)) got)) "models")))
    (is (= ["mishima"] (get (first (filter #(= "did:key:zDown" (:did %)) got)) "models")))))
