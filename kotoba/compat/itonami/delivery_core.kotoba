(ns itonami.delivery-core
  "The pure half of the delivery queue port (ledger 8 design A, consumer 2:
  delivery_queue.cljk's 18 SQL). Queue semantics kept: enqueue is INSERT OR
  IGNORE (first wins), claim flips pending -> delivering exactly once, finish
  records a terminal status + error, claim-next takes the FIRST pending in
  enqueue order. The order comes from an append-only journal; the per-id
  state lives in one file per execution id (notepad's hashed naming).

  Status is one of 0 pending / 1 delivering / 2 terminal. State file content
  is the status digit, a newline, then the error text. Self-contained: only
  native-qualified ops."
  (:require [itonami.journal-core :as jc])
  (:export [id-ok state-encode state-encode-at state-status state-error state-at
            terminal-ok finish-from-ok ledger-outcome status-name
            test-id-ok test-state test-terminal]))

(defn- token-in [s :string token :string] :bool
  (>= (string-index-of s token) 0))

(defn- blank-run [s :string i :i64 n :i64] :i64
  (if (>= i n)
    n
    (let [c (string-code-point-at s i)]
      (if (or (= c 32) (or (= c 9) (or (= c 10) (or (= c 11) (or (= c 12) (= c 13))))))
        (blank-run s (+ i 1) n)
        i))))

(defn id-ok [id :string] :i64
  ;; parity: non-empty execution id; narrowed: no newline (journal line).
  (if (= (blank-run id 0 (string-length id)) (string-length id))
    0
    (if (token-in id "
") 0 1)))

(defn state-encode-at [status :i64 error :string at :string] :string
  ;; three columns: status digit / error / finished_at (empty when the
  ;; caller has no clock reading -- old two-field rows answer "" from
  ;; state-at, fail-closed).
  (string-concat (state-encode status error) (string-concat "\n" at)))

(defn state-at [content :string] :string
  (jc/piece content "\n" 2))

(defn state-encode [status :i64 error :string] :string
  (string-concat (string-substring "012345" status (+ status 1))
                 (string-concat "
" error)))

(defn state-status [content :string] :i64
  (if (= 0 (string-length content))
    -1
    (- (string-code-point-at content 0) 48)))

(defn state-error [content :string] :string
  (let [i (string-index-of content "
")]
    (if (< i 0) "" (string-substring content (+ i 1) (string-length content)))))



(defn status-name [code :i64] :string
  (if (= code 0) "pending"
    (if (= code 1) "delivering"
      (if (= code 2) "delivered"
        (if (= code 3) "failed"
          (if (= code 4) "unknown"
            (if (= code 5) "suppressed" "")))))))

(defn terminal-ok [status :i64] :i64
  ;; terminal-statuses: delivered(2) failed(3) unknown(4) suppressed(5).
  (if (and (>= status 2) (<= status 5)) 1 0))

(defn finish-from-ok [status :i64] :i64
  ;; finish! is fenced: WHERE status IN ('pending','delivering').
  (if (or (= status 0) (= status 1)) 1 0))

(defn ledger-outcome [status :string] :string
  ;; the measured map: delivered->delivered, suppressed->suppressed,
  ;; failed->failed, unknown->FAILED (a lost send surfaces as failure --
  ;; the user cannot be told the result arrived).
  (if (string=? status "unknown") "failed" status))

(defn test-id-ok [] :bool
  (and (= 1 (id-ok "exec-1"))
       (= 0 (id-ok ""))
       (= 0 (id-ok "   "))
       (= 0 (id-ok "a
b"))))

(defn test-terminal [] :bool
  (and (= 1 (terminal-ok 2))
       (= 1 (terminal-ok 5))
       (= 0 (terminal-ok 0))
       (= 0 (terminal-ok 1))
       (= 0 (terminal-ok 6))
       (= 1 (finish-from-ok 0))
       (= 1 (finish-from-ok 1))
       (= 0 (finish-from-ok 2))
       (string=? "delivered" (ledger-outcome "delivered"))
       (string=? "suppressed" (ledger-outcome "suppressed"))
       (string=? "failed" (ledger-outcome "unknown"))
       (string=? "failed" (ledger-outcome "failed"))))

(defn test-state [] :bool
  (and (string=? "0
" (state-encode 0 ""))
       (string=? "2
boom" (state-encode 2 "boom"))
       (= 0 (state-status (state-encode 0 "")))
       (= 1 (state-status (state-encode 1 "x")))
       (= 2 (state-status (state-encode 2 "boom")))
       (= -1 (state-status ""))
       (string=? "boom" (state-error (state-encode 2 "boom")))
       (string=? "" (state-error (state-encode 0 "")))))
