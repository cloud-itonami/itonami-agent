(ns itonami.tasks
  "The effect half of the tasks-table port: one state file per task id
  (notepad's hashed naming). The SQLite transitions are CONDITIONAL
  (UPDATE ... WHERE status=...), so task-transition flips only when the row
  is in the expected status; claim takes ready -> claimed with the assignee
  and claim lock; done takes running -> done with the result.

  Parity notes: claim_expires / heartbeats / block_kind columns are folded
  out of this slice (timestamps and recurrence need the clock wiring); the
  status set is the measured seven.

  Shape rule measured earlier: typed-cap-call only in a typed defn's return
  position."
  (:require [itonami.tasks-state :as ts]
            [itonami.notepad :as np])
  (:export [task-create task-status task-transition task-claim task-done
            task-get-field task-set-block task-clear-block task-set-run
            task-clear-run task-block-rec task-ids])
  (:capabilities #{:fs/app-data}))

(defn- wire-exists [path :string] :string
  (typed-cap-call :fs/app-data :string :string (string-concat path "EXISTS_SEP")))

(defn- wire-read [path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn- wire-write [path :string content :string] :string
  (typed-cap-call :fs/app-data :string :string
                  (string-concat path (string-concat "WRITE_SEP" content))))

(defn- exists? [path :string] :i64
  (let [a (wire-exists path)]
    (if (= 0 (string-length a))
      0
      (if (= 49 (string-code-point-at a 0)) 1 0))))

(defn- tpath [base :string id :string] :string
  (np/note-path base (string-concat "t" id)))

(defn- wire-append [path :string content :string] :string
  (typed-cap-call :fs/app-data :string :string
                  (string-concat path (string-concat "APPEND_SEP" content))))

(defn- rpath [base :string] :string
  (string-concat base "/registry.tasks"))

(defn- rappend [base :string id :string] :string
  ;; the creation registry (delivery's queue-journal shape): one id per
  ;; line, appended when the task file is first written. Task ids are
  ;; [A-Za-z0-9_-], so lines carry exactly one id.
  (let [p (rpath base)]
    (if (= 1 (exists? p))
      (wire-append p (string-concat id "\n"))
      (wire-write p (string-concat id "\n")))))

(defn task-ids [base :string] :string
  ;; the created ids in creation order (the kanban list order).
  (let [p (rpath base)]
    (if (= 0 (exists? p))
      ""
      (wire-read p))))

(defn task-create [base :string id :string status :i64] :i64
  (if (= 0 (string-length id))
    0
    (if (< status 0)
      0
      (if (> status 6)
        0
        (let [p (tpath base id)]
          (if (= 1 (exists? p))
            0
            (let [w (wire-write p (ts/row-encode status "" "" "" ""))]
              (let [r (rappend base id)]
                1))))))))

(defn task-status [base :string id :string] :i64
  (let [p (tpath base id)]
    (if (= 0 (exists? p))
      -1
      (let [content (wire-read p)]
        (ts/row-status content)))))

(defn task-get-field [base :string id :string n :i64] :string
  (let [p (tpath base id)]
    (if (= 0 (exists? p))
      ""
      (let [content (wire-read p)]
        (ts/row-field content n)))))

(defn task-transition [base :string id :string from :i64 to :i64] :i64
  (if (or (< to 0) (> to 6))
    0
    (let [p (tpath base id)]
      (if (= 0 (exists? p))
        0
        (let [content (wire-read p)]
          (if (= from (ts/row-status content))
            (let [w (wire-write p (ts/row-encode to (ts/row-field content 1)
                                                  (ts/row-field content 2)
                                                  (ts/row-field content 3)
                                                  (ts/row-field content 4)))]
              1)
            0))))))

(defn task-claim [base :string id :string assignee :string lock :string] :i64
  (let [p (tpath base id)]
    (if (= 0 (exists? p))
      0
      (let [content (wire-read p)]
        (if (= 1 (ts/row-status content))
          (let [w (wire-write p (ts/row-encode 2 assignee lock "" ""))]
            1)
          0)))))

(defn task-done [base :string id :string result :string] :i64
  (let [p (tpath base id)]
    (if (= 0 (exists? p))
      0
      (let [content (wire-read p)]
        (if (= 3 (ts/row-status content))
          (let [w (wire-write p (ts/row-encode 6 (ts/row-field content 1) ""
                                               (ts/row-field content 3) result))]
            1)
          0)))))

(defn task-set-block [base :string id :string kind :string] :i64
  ;; the measured UPDATE: SET block_kind=?, block_recurrences=1
  ;; WHERE id=? AND status='blocked' AND block_kind IS NULL
  ;;   AND current_run_id IS NULL
  (if (= 0 (string-length kind))
    0
    (let [p (tpath base id)]
      (if (= 0 (exists? p))
        0
        (let [content (wire-read p)]
          (if (and (= 4 (ts/row-status content))
                   (= 0 (string-length (ts/row-field content 5)))
                   (= 0 (string-length (ts/row-field content 3))))
            (let [w (wire-write p (ts/row-encode7 4 (ts/row-field content 1)
                                                  (ts/row-field content 2)
                                                  (ts/row-field content 3)
                                                  (ts/row-field content 4)
                                                  kind "1"))]
              1)
            0))))))

(defn task-clear-block [base :string id :string] :i64
  ;; the unblock side: clear the block columns (status moves via
  ;; task-transition).
  (let [p (tpath base id)]
    (if (= 0 (exists? p))
      0
      (let [content (wire-read p)]
        (let [w (wire-write p (ts/row-encode7 (ts/row-status content)
                                              (ts/row-field content 1)
                                              (ts/row-field content 2)
                                              (ts/row-field content 3)
                                              (ts/row-field content 4)
                                              "" ""))]
          1)))))

(defn task-set-run [base :string id :string run :string] :i64
  (let [p (tpath base id)]
    (if (= 0 (exists? p))
      0
      (let [content (wire-read p)]
        (let [w (wire-write p (ts/row-encode7 (ts/row-status content)
                                              (ts/row-field content 1)
                                              (ts/row-field content 2)
                                              run
                                              (ts/row-field content 4)
                                              (ts/row-field content 5)
                                              (ts/row-field content 6)))]
          1)))))

(defn task-clear-run [base :string id :string] :i64
  ;; the measured UPDATE: SET current_run_id=NULL WHERE id=?
  (task-set-run base id ""))

(defn task-block-rec [base :string id :string] :string
  (ts/row-block-rec (wire-read (tpath base id))))
