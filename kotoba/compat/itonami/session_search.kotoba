(ns itonami.session-search
  "The session-search store pilot (ledger measurement 34, slice 1): the
  core of the session_search tool family over the ported per-session
  message journals (itonami.messages) -- a substring search across
  sessions and the lineage root walk. The full tool surface (profile
  resolution, ISO bounds, detail modes, exclusions) stays at the handler
  trench; this is the store semantics the 17 SQL express.

  Layout: sessions are directories under base (the messages module owns
  their journals and titles); a session's parent link is one file beside
  them (s<session>.parent), written whole. ss-root walks parents up to
  64 hops (a cycle answers the last id seen), ss-root of an unknown
  session is the session itself.

  ss-search answers up to limit lines of session<TAB>message-index<TAB>
  role<TAB>content for messages whose content contains the query (the
  SQL LIKE semantics), sessions and messages in store order.

  Shape rule measured earlier: typed-cap-call only in a typed defn's return
  position."
  (:require [itonami.messages :as m]
            [itonami.tasks-state :as ts]
            [itonami.journal-core :as jc])
  (:export [ss-set-parent ss-parent ss-root ss-search ss-search-bounded ss-search-sorted])
  (:capabilities #{:fs/browse :fs/app-data}))

(defn- wire-exists [path :string] :string
  (typed-cap-call :fs/app-data :string :string (string-concat path "EXISTS_SEP")))

(defn- wire-read [path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn- wire-write [path :string content :string] :string
  (typed-cap-call :fs/app-data :string :string
                  (string-concat path (string-concat "WRITE_SEP" content))))

(defn- wire-browse [dir :string] :string
  (typed-cap-call :fs/browse :string :string dir))

(defn- ppath [base :string session :string] :string
  (string-concat base (string-concat "/s" (string-concat session ".parent"))))

(defn ss-set-parent [base :string session :string parent :string] :i64
  (let [r (wire-write (ppath base session) parent)]
    1))

(defn ss-parent [base :string session :string] :string
  (let [p (ppath base session)]
    (let [a (wire-exists p)]
      (if (or (= 0 (string-length a)) (not (= 49 (string-code-point-at a 0))))
        ""
        (wire-read p)))))

(defn- root-walk [base :string session :string depth :i64] :string
  (if (>= depth 64)
    session
    (let [p (ss-parent base session)]
      (if (= 0 (string-length p))
        session
        (root-walk base p (+ depth 1))))))

(defn ss-root [base :string session :string] :string
  (root-walk base session 0))

(defn- entry-name [line :string] :string
  (jc/piece line "	" 0))

(defn- entry-isdir [line :string] :i64
  (let [f (jc/piece line "	" 1)]
    (if (string=? f "1") 1 0)))

(defn- count-lines [s :string] :i64
  (if (= 0 (string-length s)) 0 (jc/count-pieces s "\n")))

(defn- dec-le [a :string b :string] :i64
  ;; decimal compare for non-negative integers without leading zeros (the
  ;; clock millis text): shorter is smaller, equal length compares
  ;; lexicographically.
  (if (= 0 (string-length a))
    1
    (if (= 0 (string-length b))
      1
      (let [la (string-length a)]
        (let [lb (string-length b)]
          (if (< la lb)
            1
            (if (> la lb)
              0
              (if (<= (string-compare a b) 0) 1 0))))))))

(defn- in-bounds? [at :string after :string before :string] :i64
  (if (= 0 (dec-le after at))
    0
    (if (= 0 (dec-le at before))
      0
      1)))

(defn- hit-line [session :string k :i64 role :string at :string content :string] :string
  ;; fields: session / index / role / at / content (content last -- a
  ;; content carrying a tab breaks the field walk, the same shape limit
  ;; the earlier lines had).
  (string-concat session
    (string-concat "	" (string-concat (string-from-i64 k)
      (string-concat "	" (string-concat role (string-concat "	" (string-concat at (string-concat "	" content)))))))))

(defn- msg-scan [base :string session :string query :string after :string before :string k :i64 n :i64 left :i64 acc :string] :string
  (if (or (>= k n) (= 0 left))
    acc
    (let [c (m/msg-content-at base session k)]
      (if (and (>= (string-index-of c query) 0) (= 1 (in-bounds? (m/msg-at base session k) after before)))
        (let [line (hit-line session k (m/msg-role-at base session k) (m/msg-at base session k) c)
              acc2 (if (= 0 (string-length acc)) line (string-concat acc (string-concat "
" line)))]
          (msg-scan base session query after before (+ k 1) n (- left 1) acc2))
        (msg-scan base session query after before (+ k 1) n left acc)))))

(defn- stored-session [base :string name :string] :string
  ;; a session state file carries its session name in row slot 2; the
  ;; message journals carry nothing there. The store is hash-named, so the
  ;; name comes from the content, never the filename.
  (if (= 0 (string-length name))
    ""
    (if (not (= 110 (string-code-point-at name 0)))
      ""
      (let [content (wire-read (string-concat base (string-concat "/" name)))]
        (ts/row-field content 2)))))

(defn- sess-scan [base :string listing :string query :string after :string before :string i :i64 ns :i64 left :i64 acc :string] :string
  (if (or (>= i ns) (= 0 left))
    acc
    (let [line (jc/piece listing "
" i)]
      (let [s (stored-session base (entry-name line))]
        (if (= 0 (string-length s))
          (sess-scan base listing query after before (+ i 1) ns left acc)
          (let [hits (msg-scan base s query after before 0 (m/msg-count base s) left "")]
            (let [left2 (- left (count-lines hits))]
              (let [acc2 (if (= 0 (string-length hits))
                           acc
                           (if (= 0 (string-length acc)) hits (string-concat acc (string-concat "
" hits))))]
                (sess-scan base listing query after before (+ i 1) ns left2 acc2)))))))))

(defn ss-search-bounded [base :string query :string limit :i64 after :string before :string] :string
  ;; the bounds are clock millis text (the handler parses ISO and passes
  ;; millis); empty sides are open. Decimal compare -- no parse builtin.
  (let [listing (wire-browse base)]
    (if (= 0 (string-length listing))
      ""
      (sess-scan base listing query after before 0 (jc/count-pieces listing "
") limit ""))))

(defn- line-at [line :string] :string
  (jc/piece line "	" 3))

(defn- append-line [acc :string line :string] :string
  (if (= 0 (string-length acc)) line (string-concat acc (string-concat "
" line))))

(defn- find-pos [acc :string a :string n :i64 i :i64 desc :i64] :i64
  ;; the first line index whose order breaks (asc: a <= b; desc: a >= b).
  (if (>= i n)
    n
    (let [b (line-at (jc/piece acc "
" i))]
      (if (= 1 (if (= 1 desc) (dec-le b a) (dec-le a b)))
        i
        (find-pos acc a n (+ i 1) desc)))))

(defn- rebuild [acc :string line :string pos :i64 i :i64 n :i64 out :string] :string
  ;; acc with line inserted before line index pos (indices, not chars).
  (if (>= i n)
    (if (>= pos n) (append-line out line) out)
    (let [cur (jc/piece acc "
" i)]
      (let [out1 (if (= i pos) (append-line out line) out)]
        (let [out2 (append-line out1 cur)]
          (rebuild acc line pos (+ i 1) n out2))))))

(defn- insert-line [acc :string line :string desc :i64] :string
  (if (= 0 (string-length acc))
    line
    (let [n (jc/count-pieces acc "
")]
      (rebuild acc line (find-pos acc (line-at line) n 0 desc) 0 n ""))))

(defn- sort-pass [hits :string n :i64 i :i64 desc :i64 acc :string] :string
  (if (>= i n)
    acc
    (let [line (jc/piece hits "
" i)]
      (sort-pass hits n (+ i 1) desc (insert-line acc line desc)))))

(defn ss-search-sorted [base :string query :string limit :i64 after :string before :string sort :string] :string
  ;; sort: 'oldest' ascending by the message clock text, 'newest'
  ;; descending (the cljk semantics: only these two count), anything else
  ;; keeps the store order (rank-only).
  (let [hits (ss-search-bounded base query limit after before)]
    (if (or (= 0 (string-length hits)) (= 0 (string-length sort)))
      hits
      (if (string=? sort "oldest")
        (sort-pass hits (jc/count-pieces hits "
") 0 0 "")
        (if (string=? sort "newest")
          (sort-pass hits (jc/count-pieces hits "
") 0 1 "")
          hits)))))

(defn ss-search [base :string query :string limit :i64] :string
  (ss-search-bounded base query limit "" ""))
