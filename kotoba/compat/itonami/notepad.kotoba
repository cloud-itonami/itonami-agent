(ns itonami.notepad
  "The effect half of the per-job KV notepad port: one file per key, the file
  named by the hex-encoded sha256 of the key (safe for any hash answer shape,
  <= 128 hex chars) and holding entry-encode(key, value) so a get verifies the
  stored key it got. Set is a whole-file WRITE (upsert = last write wins),
  delete is the loader's UNLINK_SEP mutation form. All refusals answer
  fail-closed (0 / empty) before any wire write, so an oversized write leaves
  the store untouched -- parity with notepad.cljk.

  The documented caps are complete here (measured 2026-10-21): key <= 128
  characters, value <= 16KB (notepad-core), and the 64KB per-job total is
  enforced before every write by summing the store (browse over the job's
  key files + each entry's content length) -- the bounded directory scan the
  old note called open until amu#1423 made browse production-usable. The new
  entry's bytes count too, and the target key's old file is excluded (an
  upsert accounts correctly).

  No derived key index: the listing reads the store itself, so set and
  delete never maintain a second copy of the key list.

  Shape rule measured earlier: typed-cap-call only in a typed defn's return
  position."
  (:require [itonami.notepad-core :as core]
            [itonami.journal-core :as jc])
  (:export [note-path note-stored-key notepad-set notepad-get notepad-delete
            notepad-clear])
  (:capabilities #{:fs/app-data :hash/sha256 :fs/browse}))

(def max-job-total-bytes 65536)

(defn- wire-hash [key :string] :string
  (typed-cap-call :hash/sha256 :string :string key))

(defn- wire-exists [path :string] :string
  (typed-cap-call :fs/app-data :string :string (string-concat path "EXISTS_SEP")))

(defn- wire-read [path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn- wire-write [path :string content :string] :string
  (typed-cap-call :fs/app-data :string :string
                  (string-concat path (string-concat "WRITE_SEP" content))))

(defn- wire-unlink [path :string] :string
  (typed-cap-call :fs/app-data :string :string (string-concat path "UNLINK_SEP")))

(defn- wire-browse [dir :string] :string
  (typed-cap-call :fs/browse :string :string dir))

(defn- exists? [path :string] :i64
  (let [a (wire-exists path)]
    (if (= 0 (string-length a))
      0
      (if (= 49 (string-code-point-at a 0)) 1 0))))

(defn note-path [base :string key :string] :string
  (string-concat base
                 (string-concat "/n"
                                (string-concat (core/hex-encode (wire-hash key))
                                               ".txt"))))

(defn note-stored-key [path :string] :string
  ;; the entry's first line -- the stored key -- so a listing recovers keys
  ;; from the hash-named files. Empty when the file is absent or holds no
  ;; line break (a malformed entry lists as no key).
  (if (= 0 (exists? path))
    ""
    (let [content (wire-read path)]
      (let [i (string-index-of content "
")]
        (if (< i 0)
          ""
          (string-substring content 0 i))))))

(defn- entry-name [line :string] :string
  (jc/piece line "	" 0))

(defn- note-file? [name :string] :i64
  (if (= 0 (string-length name))
    0
    (if (not (= 110 (string-code-point-at name 0)))
      0
      (if (< (string-length name) 5)
        0
        (if (string=? (string-substring name (- (string-length name) 4) (string-length name)) ".txt")
          1
          0)))))

(defn- other-bytes-run [base :string skip :string listing :string i :i64 n :i64 acc :i64] :i64
  ;; the store's bytes excluding the upsert target's file -- the SQL
  ;; SUM(LENGTH(key)+LENGTH(value)) WHERE key<>? shape over file contents.
  (if (>= i n)
    acc
    (let [name (entry-name (jc/piece listing "
" i))]
      (let [acc2 (if (= 1 (note-file? name))
                   (if (string=? name skip)
                     acc
                     (let [c (wire-read (string-concat base (string-concat "/" name)))]
                       (+ acc (string-length c))))
                   acc)]
        (other-bytes-run base skip listing (+ i 1) n acc2)))))

(defn- other-bytes [base :string skip :string] :i64
  (let [listing (wire-browse base)]
    (if (= 0 (string-length listing))
      0
      (other-bytes-run base skip listing 0 (jc/count-pieces listing "
") 0))))

(defn notepad-set [base :string key :string value :string] :i64
  (if (= 0 (core/key-ok key))
    0
    (if (= 0 (core/value-ok value))
      0
      (let [p (note-path base key)]
        (let [skip (string-concat "n" (string-concat (core/hex-encode (wire-hash key)) ".txt"))
              entry (+ (string-length key) (string-length value))
              others (other-bytes base skip)]
          (if (> (+ others entry) max-job-total-bytes)
            0
            (let [r (wire-write p (core/entry-encode key value))]
              1)))))))

(defn notepad-get [base :string key :string] :string
  (let [p (note-path base key)]
    (if (= 0 (exists? p))
      ""
      (let [content (wire-read p)]
        (let [i (string-index-of content "
")]
          (if (< i 0)
            ""
            (let [stored (string-substring content 0 i)]
              (if (string=? stored key)
                (string-substring content (+ i 1) (string-length content))
                ""))))))))

(defn- clear-run [base :string listing :string i :i64 n :i64 acc :i64] :i64
  ;; every key file unlinked -- the job reset cron performs between runs.
  (if (>= i n)
    acc
    (let [name (entry-name (jc/piece listing "\n" i))]
      (let [acc2 (if (= 1 (note-file? name))
                   (let [u (wire-unlink (string-concat base (string-concat "/" name)))]
                     (+ acc 1))
                   acc)]
        (clear-run base listing (+ i 1) n acc2)))))

(defn notepad-clear [base :string] :i64
  (let [listing (wire-browse base)]
    (if (= 0 (string-length listing))
      0
      (clear-run base listing 0 (jc/count-pieces listing "\n") 0))))

(defn notepad-delete [base :string key :string] :i64
  (let [p (note-path base key)]
    (if (= 0 (exists? p))
      0
      (let [r (wire-unlink p)]
        1))))