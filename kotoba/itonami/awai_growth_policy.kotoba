(ns itonami.awai-growth-policy (:export [main]))

(defn main [] :i64
  (let [written (typed-cap-call :io/write :string :string
"{:yakuwari/capabilities
 [{:capability :read_source :decision :autonomous :note \"Only operator-supplied public source snapshots; no credentials or network access\"}
  {:capability :review_source :decision :autonomous :note \"Evidence review only; no approval minting\"}
  {:capability :draft_artifact :decision :autonomous :note \"Own host-local workspace only; draft is not publication\"}
  {:capability :record_local_receipt :decision :autonomous :note \"Own job evidence only; no paid-work or settlement claim\"}
  {:capability :delegate_task :decision :blocked}
  {:capability :external_messaging :decision :blocked}
  {:capability :publish :decision :blocked}
  {:capability :spend :decision :blocked}
  {:capability :transfer_funds :decision :blocked}
  {:capability :storage_upload :decision :blocked}
  {:capability :delete_data :decision :blocked}
  {:capability :manage_services :decision :blocked}
  {:capability :git_push :decision :blocked}
  {:capability :git_merge :decision :blocked}
  {:capability :use_signing_identity :decision :blocked}
  {:capability :export_private_keys :decision :blocked}
  {:capability :enable_cron :decision :blocked}]
 :yakuwari/runners [{:runner :itonami-agent :weight 1}]}
")]
    0))
