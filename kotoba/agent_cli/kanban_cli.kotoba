(ns agent-cli-kanban
  "The kanban-list tool handler guest (the session_search pilot's shape):
  one-shot kexe, args on wire 38, one JSON document on wire 37.

  argv: 0 base / 1 status filter (decimal, -1 = all). The document:

    {tasks:[{id:t1, status:1}, ...]}

  in creation order (the registry journal is the list order, the delivery
  queue-journal shape). Task ids are [A-Za-z0-9_-], so no string escaping
  is needed on this path (pinned here on purpose -- the escaping walk
  lives in session_search_cli and is verified there)."
  (:require [itonami.tasks :as t]
            [itonami.task-comments :as cm]
            [itonami.task-attachments :as at]
            [itonami.links :as lk]
            [itonami.tasks-events :as te]
            [itonami.task-heartbeat :as th]
            [itonami.tasks-state :as ts]
            [itonami.journal-core :as jc])
  (:export [kanban-cli])
  (:capabilities #{:cli/args :io/write}))

(defn- wire-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 i)))

(defn- wire-say [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn- item-json [id :string status :i64] :string
  (let [p1 (string-concat "{\"id\":\"" id)]
    (let [p2 (string-concat p1 "\",\"status\":")]
      (string-concat p2 (string-concat (string-from-i64 status) "}")))))

(defn- keep? [st :i64 filter-s :string] :i64
  ;; the filter travels as decimal text (no parse builtin): -1 or empty
  ;; keeps everything, otherwise the status must match the text.
  (if (= 0 (string-length filter-s))
    1
    (if (string=? filter-s "-1")
      1
      (if (string=? (string-from-i64 st) filter-s) 1 0))))

(defn- walk-json [base :string ids :string i :i64 n :i64 filter-s :string acc :string] :string
  (if (>= i n)
    acc
    (let [id (jc/piece ids "\n" i)]
      (if (= 0 (string-length id))
        (walk-json base ids (+ i 1) n filter-s acc)
        (let [st (t/task-status base id)]
          (if (= 0 (keep? st filter-s))
            (walk-json base ids (+ i 1) n filter-s acc)
            (let [item (item-json id st)]
              (let [acc2 (if (= 0 (string-length acc)) item (string-concat acc (string-concat "," item)))]
                (walk-json base ids (+ i 1) n filter-s acc2)))))))))

(defn- run-show [base :string id :string] :i64
  (let [st (t/task-status base id)]
    (let [n (cm/cm-count base id)]
      (let [hb (th/hb-get base id)]
        (let [d1 (string-concat "{\"id\":\"" id)]
          (let [d2 (string-concat d1 "\",\"status\":")]
            (let [d3 (string-concat d2 (string-from-i64 st))]
              (let [d4 (string-concat d3 ",\"comments\":")]
                (let [d5 (string-concat d4 (string-from-i64 n))]
                  (let [d6 (string-concat d5 ",\"heartbeat\":")]
                    (let [d7 (string-concat d6 (if (= 0 (string-length hb)) "0" hb))]
                      (let [w (wire-say (string-concat d7 (string-concat "}" "
")))]
                        0))))))))))))

(defn- run-create [base :string id :string status-s :string] :i64
  (let [r (t/task-create base id (ts/status-code status-s))]
    (let [w (wire-say (if (= 1 r) "{\"ok\":1}" "{\"ok\":0}"))]
      0)))

(defn- run-complete [base :string id :string] :i64
  ;; the kanban-complete shape: terminal done (status 6) through the
  ;; measured from-conditional transition.
  (let [st (t/task-status base id)]
    (let [r (t/task-transition base id st 6)]
      (let [w (wire-say (if (= 1 r) "{\"ok\":1}" "{\"ok\":0}"))]
        0))))

(defn- list-entry [base :string filter-s :string] :i64
  (let [ids (t/task-ids base)]
    (let [body (if (= 0 (string-length ids))
                 ""
                 (walk-json base ids 0 (jc/count-pieces ids "\n") filter-s ""))]
      (let [doc (string-concat "{\"tasks\":[" (string-concat body "]}"))]
        (let [w (wire-say (string-concat doc "
"))]
          0)))))

(defn- run-comment [base :string id :string author :string body :string] :i64
  (let [r (cm/cm-add base id "" author body)]
    (let [w (wire-say (if (= 1 r) "{\"ok\":1}" "{\"ok\":0}"))]
      0)))

(defn- run-attach [base :string id :string filename :string ctype :string content :string] :i64
  (let [r (at/at-add base id filename ctype content)]
    (let [w (wire-say (if (= 1 r) "{\"ok\":1}" "{\"ok\":0}"))]
      0)))

(defn- cmt-json [base :string id :string k :i64] :string
  (let [a (cm/cm-author-at base id k)]
    (let [b (cm/cm-body-at base id k)]
      (string-concat (string-concat "{\"author\":\"" a)
        (string-concat "\",\"body\":\"" (string-concat b "\"}"))))))

(defn- cmts-json [base :string id :string k :i64 n :i64 acc :string] :string
  (if (>= k n)
    acc
    (let [item (cmt-json base id k)]
      (let [acc2 (if (= 0 (string-length acc)) item (string-concat acc (string-concat "," item)))]
        (cmts-json base id (+ k 1) n acc2)))))

(defn- run-comments [base :string id :string] :i64
  (let [n (cm/cm-count base id)]
    (let [body (if (= 0 n) "" (cmts-json base id 0 n ""))]
      (let [doc (string-concat "{\"comments\":[" (string-concat body "]}"))]
        (let [w (wire-say doc)]
          0)))))

(defn- ok1 [r :i64] :i64
  (let [w (wire-say (string-concat (if (= 1 r) "{\"ok\":1}" "{\"ok\":0}") "
"))]
    0))

(defn- run-claim [base :string id :string assignee :string lock :string] :i64
  (ok1 (t/task-claim base id assignee lock)))

(defn- run-block [base :string id :string kind :string] :i64
  ;; the measured UPDATE needs the task already at status blocked (4)
  ;; with no block and no run -- the verb walks the status there first,
  ;; then records the kind (the tools' two-step shape).
  (let [st (t/task-status base id)]
    (let [t1 (if (= st 4) 1 (t/task-transition base id st 4))]
      (ok1 (t/task-set-block base id kind)))))

(defn- run-unblock [base :string id :string] :i64
  (ok1 (t/task-clear-block base id)))

(defn- run-finish [base :string id :string result :string] :i64
  (ok1 (t/task-done base id result)))

(defn- run-review [base :string id :string] :i64
  ;; the request-review shape: into review (5) plus the event row.
  (let [st (t/task-status base id)]
    (let [r (t/task-transition base id st 5)]
      (let [ev (te/ev-append base id "" "review" "")]
        (ok1 r)))))

(defn- run-link [base :string parent :string child :string] :i64
  (ok1 (lk/link-add base parent child)))

(defn- parents-done? [base :string id :string q :string n :i64 i :i64 acc :i64] :i64
  ;; every parent (a registry id whose children journal names id) must be
  ;; done (6); acc counts unfinished parents. The registry walk is the
  ;; parent scan (links are parent-keyed).
  (if (>= i n)
    acc
    (let [other (tc-piece q i)]
      (let [acc2 (if (or (= 0 (string-length other)) (string=? other id))
                   acc
                   (if (= 1 (lk/link-has base other id))
                     (if (= 6 (t/task-status base other)) acc (+ acc 1))
                     acc))]
        (parents-done? base id q n (+ i 1) acc2)))))

(defn- tc-piece [q :string i :i64] :string
  (jc/piece q "\n" i))

(defn- recompute-one [base :string id :string q :string n :i64] :i64
  (if (= 0 (t/task-status base id))
    (if (= 0 (parents-done? base id q n 0 0))
      (t/task-transition base id 0 1)
      0)
    0))

(defn- recompute-run [base :string q :string i :i64 n :i64 acc :i64] :string
  (if (>= i n)
    (string-from-i64 acc)
    (let [id (tc-piece q i)]
      (let [r (if (= 0 (string-length id)) 0 (recompute-one base id q n))]
        (recompute-run base q (+ i 1) n (+ acc r))))))

(defn- run-recompute [base :string] :i64
  ;; kanban-recompute-ready: todo (0) tasks whose parents are all done
  ;; flip to ready (1) -- the measured 0->1 from-conditional flip.
  (let [q (t/task-ids base)]
    (let [n (if (= 0 (string-length q)) 0 (jc/count-pieces q "\n"))]
      (let [flipped (recompute-run base q 0 n 0)]
        (let [w (wire-say (string-concat "{\"ok\":" (string-concat flipped "}")))]
          0)))))

(defn- run-heartbeat [base :string id :string] :i64
  (ok1 (th/hb-set base id)))

(defn kanban-cli [] :i64
  (let [verb (wire-arg 0) base (wire-arg 1) a2 (wire-arg 2)]
    (if (string=? verb "show")
      (run-show base a2)
      (if (string=? verb "create")
        (run-create base a2 (wire-arg 3))
        (if (string=? verb "complete")
          (run-complete base a2)
          (if (string=? verb "comment")
            (run-comment base a2 (wire-arg 3) (wire-arg 4))
            (if (string=? verb "attach")
              (run-attach base a2 (wire-arg 3) (wire-arg 4) (wire-arg 5))
              (if (string=? verb "comments")
                (run-comments base a2)
                (if (string=? verb "claim")
                (run-claim base a2 (wire-arg 3) (wire-arg 4))
                (if (string=? verb "block")
                  (run-block base a2 (wire-arg 3))
                  (if (string=? verb "unblock")
                    (run-unblock base a2)
                    (if (string=? verb "finish")
                      (run-finish base a2 (wire-arg 3))
                      (if (string=? verb "review")
                      (run-review base a2)
                      (if (string=? verb "link")
                        (run-link base a2 (wire-arg 3))
                        (if (string=? verb "recompute")
                          (run-recompute base)
                          (if (string=? verb "heartbeat")
                            (run-heartbeat base a2)
                            (list-entry base a2)))))))))))))))))
