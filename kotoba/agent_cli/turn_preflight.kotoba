(ns agent-cli.turn-preflight
  (:export [main])
  (:capabilities #{:cli/args :fs/app-data :io/write :io/write-error}))

;; KFR1 reads a bounded whole file relative to the inherited directory FD.
;; The build appends Amu's pinned SHA-256 source.
(defn- profile-read [] :bytes
  (typed-cap-call :fs/app-data :bytes :bytes
    (string-to-utf8 "\u0000KFR1\u0000/profiles/awai-hiring-ops/itonami.edn")))

(defn- profile-arg [] :string
  (typed-cap-call :cli/args :string :string "0"))

(defn- profile-ok? [] :bool
  (let [raw (profile-read)
        size (bytes-count raw)]
    (and (= size 2679)
         (= (bytes-at raw 0) 1)
         (string=? (sh-bytes (vector-i64-from-bytes (bytes-slice raw 1 size)))
                   "fc067293035d312546395bf737e6ebf2fd527853d34b72fa00fa3bcc56c1dac5"))))

(defn- say [value :string] :string
  (typed-cap-call :io/write :string :string value))

(defn- error [value :string] :string
  (typed-cap-call :io/write-error :string :string value))

(defn main [] :i64
  (cond
    (not (string=? (profile-arg) "awai-hiring-ops"))
      (let [_ (error "turn preflight: unsupported profile\n")] 2)
    (not (profile-ok?))
      (let [_ (error "turn preflight: profile missing or pin mismatch\n")] 2)
    :else
      (let [_ (say "turn preflight: awai-hiring-ops profile pin verified; inference blocked\n")] 0)))
