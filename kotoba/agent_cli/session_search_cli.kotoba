(ns agent-cli-session-search
  "The session_search tool handler pilot (ledger measurement 34, strategy
  2): the tool result JSON built by string construction in the guest, over
  the session-search store slice -- a one-shot kexe guest that reads its
  args on wire 38 and writes one JSON document on wire 37. Every string is
  JSON-escaped by a code-point walk (quote 34, backslash 92, newline 10,
  tab 9, CR 13). The full tool surface (profile resolution, ISO bounds,
  detail modes) stays at the remaining handler work."
  (:require [itonami.session-search :as ss]
            [itonami.journal-core :as jc])
  (:export [session-search-cli])
  (:capabilities #{:cli/args :io/write}))

(defn- wire-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 i)))

(defn- wire-say [s :string] :string
  (typed-cap-call :io/write :string :string s))

(def bs1 "\\")

(defn- piece-quote [] :string (string-concat bs1 "\""))
(defn- piece-backslash [] :string "\\\\")
(defn- piece-nl [] :string "\\n")
(defn- piece-tab [] :string "\\t")
(defn- piece-cr [] :string "\\r")

(defn- esc-run [s :string i :i64 acc :string] :string
  (if (>= i (string-length s))
    acc
    (let [c (string-code-point-at s i)]
      (if (= c 34)
        (esc-run s (+ i 1) (string-concat acc (piece-quote)))
        (if (= c 92)
          (esc-run s (+ i 1) (string-concat acc (piece-backslash)))
          (if (= c 10)
            (esc-run s (+ i 1) (string-concat acc (piece-nl)))
            (if (= c 9)
              (esc-run s (+ i 1) (string-concat acc (piece-tab)))
              (if (= c 13)
                (esc-run s (+ i 1) (string-concat acc (piece-cr)))
                (esc-run s (+ i 1) (string-concat acc (string-substring s i (+ i 1))))))))))))

(defn- json-str [s :string] :string
  (string-concat "\"" (string-concat (esc-run s 0 "") "\"")))

(defn- snippet [content :string] :string
  ;; the match window the SQL snippets carried: the first 80 characters.
  (if (<= (string-length content) 80)
    content
    (string-substring content 0 80)))

(defn- hit-json [line :string hydrate :i64] :string
  (let [session (jc/piece line "\t" 0)]
    (let [index (jc/piece line "\t" 1)]
      (let [role (jc/piece line "\t" 2)]
        (let [content (if (= 1 hydrate) (jc/piece line "\t" 3) (snippet (jc/piece line "\t" 3)))]
          (let [p1 (string-concat "{\"session\":" (json-str session))]
            (let [p2 (string-concat p1 (string-concat ",\"index\":" index))]
              (let [p3 (string-concat p2 (string-concat ",\"role\":" (json-str role)))]
                (let [p4 (string-concat p3 (string-concat ",\"content\":" (json-str content)))]
                  (string-concat p4 "}"))))))))))

(defn- hits-json [hits :string i :i64 n :i64 detail :string acc :string] :string
  (if (>= i n)
    acc
    (let [h (hit-json (jc/piece hits "\n" i) (if (string=? detail "full") 1 (if (= 0 i) 1 0)))]
      (let [acc2 (if (= 0 (string-length acc)) h (string-concat acc (string-concat "," h)))]
        (hits-json hits (+ i 1) n detail acc2)))))

(defn session-search-cli [] :i64
  (let [base (wire-arg 0) query (wire-arg 1) limit-s (wire-arg 2) detail (wire-arg 5)]
    (let [hits (ss/ss-search base query 100)]
      (let [body (if (= 0 (string-length hits))
                   ""
                   (hits-json hits 0 (jc/count-pieces hits "\n") detail ""))]
        (let [doc (string-concat "{\"query\":" (json-str query))]
          (let [doc2 (string-concat doc ",\"hits\":[")]
            (let [doc3 (string-concat doc2 body)]
              (let [doc4 (string-concat doc3 "]}")]
                (let [w (wire-say doc4)]
                  0)))))))))
