(ns agent-cli-turn-loop
  "The turn with tool dispatch (the next slice after turn_cli): a loop
  guest that asks the model, parses a tool request from the generation,
  runs the tool against the ported stores, and reports. The dispatch
  grammar is the measured minimal one -- a generation line
  `tool:<name>:<arg>` is honored (notepad get/set, kanban show, search);
  anything else is the final answer.

  This pins the 逐次面 loop shape: prompt -> model -> tool -> model ...
  straight-line recursion in the guest; the orchestration (which job,
  when) stays the host loop's business."
  (:require [itonami.notepad-render :as nr]
            [itonami.notepad :as np]
            [itonami.tasks :as t]
            [itonami.session-search :as ss]
            [itonami.journal-core :as jc])
  (:export [turn-loop-cli])
  (:capabilities #{:cli/args :io/write :llm/generate}))

(defn- wire-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 i)))

(defn- wire-say [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn- wire-llm [p :string] :string
  (typed-cap-call :llm/generate :string :string p))

(defn- tool-run [base :string call :string] :string
  ;; call = tool:<name>:<arg>  (three colon fields; the arg carries no
  ;; colon in this grammar)
  (let [name (jc/piece call ":" 1)]
    (let [arg (jc/piece call ":" 2)]
      (if (string=? name "notepad-get")
        (np/notepad-get base arg)
        (if (string=? name "kanban-show")
          (string-concat "status:" (string-from-i64 (t/task-status base arg)))
          (if (string=? name "search")
            (let [h (ss/ss-search base arg 5)]
              (if (= 0 (string-length h)) "no hits" h))
            "unknown tool"))))))

(defn- turn-once [base :string job :string prompt :string depth :i64] :string
  (if (>= depth 4)
    "budget exhausted"
    (let [answer (wire-llm prompt)]
      (if (= 116 (string-code-point-at answer 0))
        ;; the generation opens with t = a tool request line
        (let [observed (tool-run base answer)]
          (turn-once base job
                     (string-concat prompt
                       (string-concat "
observation: " observed))
                     (+ depth 1)))
        answer))))

(defn turn-loop-cli [] :i64
  (let [base (wire-arg 0) job (wire-arg 1) task (wire-arg 2)]
    (let [notes (nr/render-notes base job)]
      (let [final (turn-once base job (string-concat notes (string-concat "task: " task)) 0)]
        (let [w (wire-say (string-concat final "
"))]
          0)))))
