(ns itonami.agent.loop
  "The turn loop: system prompt assembly and model -> tools -> model until the
  model answers without tool calls, max_turns is reached or the run budget
  runs out. Semantics follow Hermes agent/conversation_loop.py (the parity
  target kotoba-lang/agent turn_loop.kotoba was transcribed from):

    - iterate while api_call_count < max_turns
    - at 80% of agent.run_budget_seconds, append the wrap-up notice to the
      newest tool result so the model finishes instead of being cut off
    - exit reasons: completed | max_iterations_reached(N/N) | budget_exhausted | provider_error"
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]
            [itonami.agent.provider :as provider]
            [itonami.agent.process :as proc]
            [itonami.agent.browser :as browser-runtime]
            [itonami.agent.computer-use :as computer-use]
            [itonami.agent.tools :as tools]
            [itonami.agent.mcp :as mcp]
            [itonami.agent.yaml :as yaml]
            [itonami.agent.confine :as confine]))

(def wrapup-notice
  "Hermes agent/conversation_loop.RUN_BUDGET_WRAPUP_NOTICE, verbatim."
  "[SYSTEM NOTICE — run time budget nearly exhausted] Run time budget nearly exhausted. Stop new discovery/verification work now. Produce the required final deliverable (answer/JSON/summary) from the state you already have, completing only mandatory writes.")

(defn wrap-up?
  "Hermes' _maybe_inject_run_budget_wrapup threshold: the notice fires at
  elapsed >= 0.8 * budget — 5 * elapsed >= 4 * budget in whole milliseconds,
  the `wrap-up` rule of system-one/loop.edn — and never on a non-positive
  budget (Hermes treats an unset budget as dormant)."
  [elapsed-ms budget-ms]
  (and (pos? budget-ms) (>= (* 5 elapsed-ms) (* 4 budget-ms))))

(defn maybe-inject-run-budget-wrapup
  "Hermes agent/conversation_loop._maybe_inject_run_budget_wrapup: append the
  one-shot wrap-up notice (\"\\n\\n\" + notice) to the NEWEST tool result.
  `injected?` (an atom) latches only on a successful append, so a round with
  no tool results leaves it open and a later round delivers the notice."
  [results injected? budget-ms elapsed-ms]
  (if (and (seq results) (not @injected?) (wrap-up? elapsed-ms budget-ms))
    (do (reset! injected? true)
        (update-in results [(dec (count results)) "content"] #(str % "\n\n" wrapup-notice)))
    results))

(def guidance
  "## Finishing the job
Work until the task is done, then answer with a short report: what changed, what is verified, what is left. If you could not measure something, say UNMEASURED instead of guessing.

## Tool use
Use tools to act; do not describe a tool call instead of making it. Independent tool calls may be made in one turn.")

(defn- skills-index [home]
  (let [root (h/join home "skills")
        files (if (h/dir? root) (h/walk-files root (fn [_] false)) [])
        entries (keep (fn [rel]
                        (let [parts (str/split rel #"/")
                              skill-path (vec (butlast parts))]
                          (when (and (= "SKILL.md" (last parts)) (#{1 2} (count skill-path)))
                            (let [f (h/join root rel)
                                  content (h/slurp f)
                                  frontmatter (second (re-find #"(?s)^---\s*\n(.*?)\n---(?:\n|$)" content))
                                  meta (when frontmatter
                                         (try (yaml/parse frontmatter) (catch :default _ nil)))]
                              (when (map? meta)
                                {:category (when (= 2 (count skill-path)) (first skill-path))
                                 :name (last skill-path)
                                 :description (get meta "description" "")}))))) files)]
    (when (seq entries)
      (str "## Skills\n<available_skills>\n"
           (str/join "\n" (for [[cat grp] (sort-by (comp str key) (group-by :category entries))]
                            (str (when cat (str "category: " cat "\n"))
                                 (str/join "\n" (for [{:keys [name description]} (sort-by :name grp)]
                                                    (str "- " name ": " description))))))
           "\n</available_skills>\nLoad one with skill_view(name) before following it."))))

(defn- context-file
  "First match wins, like Hermes: .hermes.md / HERMES.md, else AGENTS.md,
  else CLAUDE.md, looked up from cwd towards /."
  [cwd]
  (loop [d cwd]
    (when (and d (not= d (h/dirname d)))
      (if-let [f (first (filter h/file? (map #(h/join d %) [".hermes.md" "HERMES.md" "AGENTS.md" "CLAUDE.md"])))]
        (let [t (h/slurp f)] (str "# Project context (" f ")\n" (subs t 0 (min 20000 (count t)))))
        (recur (h/dirname d))))))

(defn history-messages
  "Normalize prior user/assistant messages for a new agent turn. System/developer
  instructions are supplied separately; tool messages belong to the previous
  turn and are intentionally omitted from the desktop-compatible history."
  [history]
  (vec (for [m (or history [])
             :let [role (or (get m "role") (:role m))
                   content (or (get m "content") (:content m))]
             :when (contains? #{"user" "assistant"} role)]
         {"role" role
          "content" (cond
                      (string? content) content
                      (sequential? content)
                      (str/join "\n" (keep (fn [part]
                                                (when (or (= "text" (get part "type"))
                                                          (= "text" (:type part)))
                                                  (or (get part "text") (:text part) "")))
                                              content))
                      (nil? content) ""
                      :else (str content))})))

(defn system-prompt
  "skills? false leaves out the skills index: listing skills to a run that has
  no skill_view tool only costs tokens (on a busy rail, minutes per turn)."
  [{:keys [soul home]} {:keys [cwd platform load-context? skills? instructions]
                        :or {skills? true}}]
  (str/join "\n\n"
            (remove str/blank?
                    [(or soul "You are a helpful agent running on the itonami plane.")
                     (when-not (str/blank? instructions)
                       (str "# Session instructions\n" instructions))
                     guidance
                     (when skills? (skills-index home))
                     (when load-context? (context-file cwd))
                     (str "# Runtime environment\n"
                          "- engine: itonami-agent (kotoba, Hermes-compatible)\n"
                          "- platform: " (or platform "cli") "\n"
                          "- profile home: " home "\n"
                          "- cwd: " cwd "\n"
                          "- time: " (h/iso-local))])))

;; ---------------------------------------------------------------- max_turns resolution
;; Hermes hermes_cli/config.py:resolve_turn_limit and
;; hermes_cli/cli_init_mixin._init_turn_limits (the case list mirrors
;; tests/hermes_cli/test_resolve_turn_limit.py).

(def turn-limit-unlimited
  "Hermes' TURN_LIMIT_UNLIMITED is sys.maxsize (2^63-1); the JS runtime plays
  the sentinel with Number.MAX_SAFE_INTEGER. Neither is reachable as an actual
  turn count, so only the 'no finite cap' behavior is observable."
  (.-MAX_SAFE_INTEGER js/Number))

(def unlimited-spellings
  "Hermes' _UNLIMITED_SPELLINGS, matched against the trimmed, lowercased
  string."
  #{"none" "null" "unlimited" "infinite" "infinity" "inf" "∞" "-1" "0"})

(defn- parse-turn-count
  "Python's int(s), then int(float(s)) as the fallback: optional sign, decimal
  digits (single `_` separators between digits, which Python's int/float
  accept), optional fraction and exponent. Returns the truncated integer, or
  nil when Python would raise (hex, garbage, non-finite)."
  [s]
  (let [norm (str/replace s #"(\d)_(?=\d)" "$1")]
    (when (re-matches #"[+-]?(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?" norm)
      (let [f (js/Number norm)]
        (when (js/Number.isFinite f) (js/Math.trunc f))))))

(defn resolve-turn-limit
  "Hermes hermes_cli/config.py:resolve_turn_limit — normalize a raw
  `agent.max_turns` value into an int iteration cap (always >= 1). nil, bools,
  unknown types and unparseable strings return the default (unlimited at every
  call site); numbers truncate toward zero and any n <= 0 is unlimited. The
  spelling table maps none/null/unlimited/infinite/infinity/inf/∞/-1/0 to
  unlimited."
  ([raw] (resolve-turn-limit raw turn-limit-unlimited))
  ([raw default]
   (cond
     (or (nil? raw) (boolean? raw)) default
     (number? raw) (if (js/Number.isFinite raw)
                     (let [n (js/Math.trunc raw)]
                       (if (<= n 0) turn-limit-unlimited n))
                     default)
     (string? raw) (let [s (str/trim (str/lower-case raw))]
                     (cond
                       (str/blank? s) default
                       (contains? unlimited-spellings s) turn-limit-unlimited
                       :else (if-let [n (parse-turn-count s)]
                               (if (<= n 0) turn-limit-unlimited n)
                               default)))
     :else default)))

(defn resolve-max-turns
  "Hermes hermes_cli/cli_init_mixin._init_turn_limits — the turn cap is the
  first NON-nil of (CLI/API value, agent.max_turns, root-level max_turns,
  HERMES_MAX_ITERATIONS) resolved through resolve-turn-limit. Unset is
  unlimited, never a fixed default; a present `false` is resolved (and becomes
  unlimited), not skipped."
  [opt-val config env-val]
  (resolve-turn-limit
   (reduce (fn [_ x] (if (some? x) (reduced x) nil)) nil
           [opt-val (get-in config ["agent" "max_turns"]) (get config "max_turns") env-val])))

(declare run delegated-tasks)

(defn run
  "One conversation. Resolves to
   {:final str :exit-reason str :turns n :messages [...] :usage {...}
    :provider str :model str :attempts [...] :writes [abs-paths]}"
  [{:keys [config env] :as prof} prompt {:keys [model provider pinned? toolsets tool-names cwd roots platform
                                                load-context? max-turns budget-s on-event peer? steer-queue cancelled?
                                                reasoning-effort max-tokens
                                                task-id session-key subagent
                                                history instructions before-tool tool-overrides]
                                         :as options}]
  (let [max-turns (resolve-max-turns max-turns config (h/env "HERMES_MAX_ITERATIONS"))
        budget-ms (* 1000 (or budget-s (get-in config ["agent" "run_budget_seconds"]) 0))
        hops (provider/decentralize (provider/chain config {:model model :provider provider :pinned? pinned?})
                                    (:itonami prof) config)
        requested-sets (when (nil? tool-names) (or toolsets ["hermes-cli"]))
        disabled (tools/execution-disabled-toolsets config platform)
        all-requested (or tool-names requested-sets)
        mcp-servers (if (and requested-sets (not peer?)) (mcp/names-for config requested-sets disabled) [])
        unknown-sets (tools/unsupported-toolsets requested-sets (set (keys (get config "mcp_servers" {}))))
        _ (when (seq unknown-sets)
            (throw (ex-info (str "Kotoba agent does not recognize Hermes toolsets: "
                                 (str/join ", " unknown-sets))
                            {:unsupported-toolsets unknown-sets})))
        ;; agent.disabled_toolsets travels in the bundle (not host-local), so a
        ;; peer turn drops the same tools; a -t / peer opts toolsets cannot re-add them
        browser-cdp-configured? (or (not (str/blank? (get env "BROWSER_CDP_URL")))
                                    (not (str/blank? (get-in config ["browser" "cdp_url"])))
                                    (not (str/blank? (get-in config ["browser" "cdp_endpoint"]))))
        names (tools/runtime-tool-names all-requested disabled browser-cdp-configured?
                                         (browser-runtime/cli-available?)
                                         (computer-use/cli-available? env))
        mcp-data (mcp/discover config env mcp-servers (:home prof))
        mcp-index (:index mcp-data)
        mcp-names (vec (keys mcp-index))
        names (into names mcp-names)
        unsupported (tools/unsupported-tools (remove (set mcp-names) names))
        _ (when (seq unsupported)
            (throw (ex-info (str "Kotoba agent cannot run this Hermes toolset yet; unsupported tools: "
                                 (str/join ", " unsupported))
                            {:unsupported-tools unsupported})))
        schemas (into (tools/tool-schemas names)
                      (:schemas mcp-data))
        mcp-overrides (into {} (for [[wire [server raw]] mcp-index]
                                 [wire (fn [_ args] (mcp/call config env server raw args (:home prof)))]))
        writes (atom [])
        todo-state (tools/todo-history-state history)
        cwd (or cwd (some-> (get-in config ["terminal" "cwd"]) h/expand) (h/join (:home prof) "workspace"))
        _ (h/mkdirs cwd)
        ;; one task id per agent run (Hermes binds a fresh one per turn in
        ;; `turn_context._bind_turn_identity`): the raw owner id under which
        ;; this run's background processes register
        task-id (or task-id (str "task-" (h/random-hex 8)))
        session-key (or session-key "")
        ctx {:cwd cwd :home (:home prof) :profile (:name prof) :roots roots :writes writes :tool-env env
             :task-id task-id :session-key session-key :subagent subagent
             :browser-config (get config "browser" {})
             :browser-session (str "kotoba-" (h/random-hex 12))
             :browser-used? (atom false)
             :computer-config (get config "computer_use" {})
             :computer-session (str "kotoba-" (h/random-hex 12))
             :computer-state (atom {})
             :approval-available? (boolean before-tool)
             :model-hops hops :reasoning-effort reasoning-effort
             :todos (atom (:todos todo-state)) :todo-revision (atom (:revision todo-state))
             :mcp-config config :mcp-index mcp-index
             :tool-overrides (merge mcp-overrides tool-overrides)
             :peer? peer?
             :terminal-policy (confine/policy (:itonami prof) {:peer? peer?})}
        t0 (h/now-ms)
        emit (or on-event (fn [_]))
        mcp-notice (cond
                     peer? "\n\n## MCP tools unavailable\nCustom MCP servers are disabled for peer runs. Do not claim that you used them."
                     (seq (:errors mcp-data))
                     (str "\n\n## MCP server issues\n"
                          (str/join "\n" (map (fn [e] (str "- " (get e "server") ": " (get e "error")))
                                       (:errors mcp-data)))
                          "\nThese tools are unavailable in this run; do not claim that you used them.")
                     :else nil)
        usage (atom {"prompt_tokens" 0 "completion_tokens" 0 "total_tokens" 0})
        wrapup-injected? (atom false)
        add-usage! (fn [u] (when u (swap! usage #(merge-with + % (select-keys u ["prompt_tokens" "completion_tokens" "total_tokens"])))))]
      (p/finally
       (p/loop [messages (into [{"role" "system" "content"
                                (str (system-prompt prof {:cwd cwd :platform platform
                                                          :load-context? load-context?
                                                          :skills? (boolean (some #{"skill_view"} names))
                                                          :instructions instructions})
                                     (or mcp-notice ""))}]
                              (concat (history-messages history)
                                      [{"role" "user" "content" prompt}]))
             n 0
             attempts []
             last-hop nil]
      (cond
        (and cancelled? @cancelled?)
        {:final nil :exit-reason "interrupted" :turns n :messages messages :usage @usage
         :attempts attempts :writes @writes :provider (:provider last-hop) :model (:model last-hop)}

        (>= n max-turns)
        {:final nil :exit-reason (str "max_iterations_reached(" n "/" max-turns ")") :turns n
         :messages messages :usage @usage :attempts attempts :writes @writes
         :provider (:provider last-hop) :model (:model last-hop)}

        (and (pos? budget-ms) (> (- (h/now-ms) t0) budget-ms))
        {:final nil :exit-reason "budget_exhausted" :turns n :messages messages :usage @usage
         :attempts attempts :writes @writes :provider (:provider last-hop) :model (:model last-hop)}

        :else
        ;; pushed background-process completions (Hermes' completion queue)
        ;; re-enter as a message between model turns, batched as Hermes batches
        ;; them (ProcessNotificationBatch.render)
        (let [notice (proc/pending-notification-text
                      {:session-key session-key
                       :surface-child? (boolean (get-in config ["delegation" "surface_child_process_notifications"]))})
              messages (cond-> messages notice (conj {"role" "user" "content" notice}))]
        (p/let [r (provider/complete hops env {:messages messages :tools schemas
                                               :reasoning-effort (or reasoning-effort
                                                                     (get-in config ["agent" "reasoning_effort"]))
                                               :max-tokens (or max-tokens
                                                               (get-in config ["model" "max_tokens"]))
                                               :deadline-ms (when (pos? budget-ms) (+ t0 budget-ms))
                                               :on-hop (fn [hop r ms]
                                                         (emit {:event :hop :provider (:provider hop) :model (:model hop)
                                                                :ms ms :ok (boolean (:ok r))
                                                                :error (get-in r [:err :error])}))})]
          (let [attempts (into attempts (:attempts r))]
            (if-let [err (:err r)]
              {:final nil :exit-reason "provider_error" :error err :turns n :messages messages
               :usage @usage :attempts attempts :writes @writes}
              (let [{:keys [message] :as resp} (:ok r)
                    _ (add-usage! (:usage resp))
                    calls (get message "tool_calls")
                    assistant (cond-> {"role" "assistant" "content" (get message "content")}
                                (seq calls) (assoc "tool_calls" calls))
                    messages (conj messages assistant)]
                (emit {:event :assistant :turn (inc n) :provider (:provider resp) :model (:model resp)
                       :content (get message "content") :tool-calls (count calls)})
                (if (empty? calls)
                  {:final (or (get message "content") "") :exit-reason "completed" :turns (inc n)
                   :messages messages :usage @usage :attempts attempts :writes @writes
                   :provider (:provider resp) :model (:model resp)}
                  (p/let [images (atom [])
                          results (p/loop [[c & more] calls acc []]
                                    (if (nil? c)
                                      acc
                                      (p/let [nm (get-in c ["function" "name"])
                                              args (get-in c ["function" "arguments"])
                                              args-map (try (if (string? args) (h/json-parse (if (str/blank? args) "{}" args)) args)
                                                            (catch :default _ nil))
                                              approved? (if (and before-tool (tools/approval-required? nm args-map))
                                                          (before-tool {:id (get c "id") :name nm :arguments args})
                                                          true)
                                              t1 (h/now-ms)
                                              _ (emit {:event :tool-start :name nm
                                                       :args (if (or (some #{nm} tools/browser-tools)
                                                                     (= nm "computer_use"))
                                                               "[sensitive UI arguments redacted]"
                                                               (subs (str args) 0 (min 160 (count (str args)))))})
                                              out-result (if approved?
                                                    (if (= nm "delegate_task")
                                                      (if (map? args-map)
                                                        (delegated-tasks prof names (assoc options
                                                                                           :task-id task-id
                                                                                           :session-key session-key)
                                                                         args-map)
                                                        (h/json-str {"error" "delegate_task arguments must be a JSON object"}))
                                                      (tools/call (assoc ctx :tool-approved? approved?) names nm args))
                                                    (h/json-str {"error" "Tool call denied by user."}))
                                              out (tools/tool-result-text out-result)
                                              out (let [steered (when steer-queue (not-empty @steer-queue))]
                                                    (if steered
                                                      (do (reset! steer-queue [])
                                                          (str out "\n\n[STEER from the parent turn]\n" (str/join "\n" steered)))
                                                      out))
                                              _ (swap! images into (tools/tool-result-images out-result))]
                                        (emit {:event :tool :name nm :bytes (count out)
                                               :ms (- (h/now-ms) t1) :denied (not approved?)})
                                        (p/recur more (conj acc {"role" "tool" "tool_call_id" (get c "id") "content" out})))))
                          results (maybe-inject-run-budget-wrapup
                                   results wrapup-injected? budget-ms (- (h/now-ms) t0))]
                    (let [image-message (when (seq @images)
                                          {"role" "user"
                                           "content" (into [{"type" "text"
                                                             "text" "Image output from the preceding tool call(s):"}]
                                                           @images)})]
                      (p/recur (cond-> (into messages results) image-message (conj image-message))
                               (inc n) attempts resp)))))))))))
       (fn [] (browser-runtime/close-session ctx)))))

(def delegate-children
  "subagent_id -> {goal status summary}. Children are registered while they
  run and kept afterwards, so action=list stays truthful."
  (atom {}))

(def delegate-delivered (atom #{}))

(defn delegate-pending-results!
  "Finished background children not yet delivered — one message per call, as
  Hermes delivers background results between turns. Marked delivered."
  []
  (let [pending (vec (for [[id c] @delegate-children
                           :when (and (not= "running" (get c "status"))
                                      (not (contains? @delegate-delivered id)))]
                       (assoc c "subagent_id" id)))]
    (when (seq pending)
      (swap! delegate-delivered into (map #(get % "subagent_id") pending)))
    pending))

(def delegate-ctl
  "subagent_id -> {:steer (atom [message]) :cancel (atom bool)}. steer queues
  the correction into the child's next tool result; cancel ends the child
  early with an 'interrupted' completion carrying its partial output."
  (atom {}))

(defn- delegate-validate-schema
  "The parent-side check after a child returns: the final answer must parse
  as a JSON object carrying every required key. {\"schema_valid\" …} plus
  \"schema_errors\" on failure; the raw text is always kept as the summary."
  [schema final]
  (let [required (vec (get schema "required"))]
    (if (empty? required)
      {"schema_valid" true}
      (let [obj (try (h/json-parse (str final)) (catch :default _ nil))]
        (if (and (map? obj) (every? #(contains? obj %) required))
          {"schema_valid" true}
          {"schema_valid" false
           "schema_errors" (if (map? obj)
                             (vec (remove #(contains? obj %) required))
                             ["final answer is not a JSON object"])})))))

(defn- delegate-child-prompt
  "goal + context + image hints + output_schema instruction — everything the
  child needs, because it knows nothing of this conversation."
  [{:strs [goal context images output_schema]}]
  (str "## Delegated goal\n" goal
       (when-not (str/blank? (str context))
         (str "\n\n## Context\n" (subs (str context) 0 (min 20000 (count (str context))))))
       (when (seq images)
         (str "\n\n## Images (max 8; read them yourself if your tools allow)\n"
              (str/join ", " (take 8 images))))
       (when output_schema
         (str "\n\n## Output\nYour final answer must be a single JSON object matching "
              "this JSON Schema — no prose outside the JSON:\n" (h/json-str output_schema)))
       "\n\nWork only on this delegated task. Do not delegate further."))

(defn delegated-tasks
  "delegate_task, the Hermes delegation API: same name and same argument
  shape (tasks[].goal/context/output_schema/images, action spawn|list|steer|
  stop, subagent_id, message). Children are bounded foreground turns in
  Kotoba with recursive delegation, clarify, memory and cron management
  removed; each receives only its own goal and explicit context, never the
  parent's transcript. One-shot sessions (CLI -z, cron) join their children
  and return the results in this call, as Hermes does for a session without
  a later-result consumer. Foreground children have no mid-run inbox and no
  cancel: steer/stop answer honestly instead of pretending."
  [prof parent-names parent-options {:strs [tasks action subagent_id message]}]
  (case (or action "spawn")
    "list" (h/json-str {"results" (vec (for [[id c] (sort-by key @delegate-children)]
                                         (merge {"subagent_id" id} c)))})

    "stop" (if-let [c (get @delegate-children subagent_id)]
             (if (= "running" (get c "status"))
               (if-let [ctl (get @delegate-ctl subagent_id)]
                 (do (reset! (:cancel ctl) true)
                     (h/json-str {"subagent_id" subagent_id "status" "stopping"
                                  "note" "the child ends early with an interrupted completion carrying its partial output"}))
                 (h/json-str {"error" (str "stop: " subagent_id " has no live control channel")}))
               (h/json-str {"subagent_id" subagent_id "status" (get c "status")}))
             (h/json-str {"error" (str "no such subagent: " subagent_id)}))

    "steer" (if-let [ctl (get @delegate-ctl subagent_id)]
              (do (swap! (:steer ctl) conj (str message))
                  (h/json-str {"subagent_id" subagent_id
                               "status" (get-in @delegate-children [subagent_id "status"])
                               "steered" true}))
              (if (contains? @delegate-children subagent_id)
                (h/json-str {"error" (str "steer: this child has no live mid-run inbox (message: "
                                          (pr-str message) ") — re-delegate with the correction in the goal")})
                (h/json-str {"error" (str "no such subagent: " subagent_id)})))

    ;; spawn (default)
    (let [tasks (if (vector? tasks) tasks [])
          configured-max (get-in (:config prof) ["delegation" "max_concurrent_children"])
          max-children (if (and (number? configured-max) (pos? configured-max))
                         (min 10 (js/Math.floor configured-max))
                         10)]
      (cond
        (empty? tasks) (h/json-str {"error" "delegate_task requires at least one task"})
        (> (count tasks) max-children)
        (h/json-str {"error" (str "delegate_task accepts at most " max-children " tasks for this profile")})
        (some #(or (not (map? %)) (not (string? (get % "goal"))) (str/blank? (get % "goal"))) tasks)
        (h/json-str {"error" "each delegated task needs a non-empty goal"})
        :else
        (let [child-names (vec (remove #(or (#{"delegate_task" "clarify" "memory" "cronjob_manage"} %)
                                            (str/starts-with? % "kanban_")) parent-names))
              configured-budget (:budget-s parent-options)
              budget-s (if (and (number? configured-budget) (pos? configured-budget))
                         (min 300 configured-budget)
                         300)
              t0 (h/now-ms)
              ;; one delegation id per delegate_task call, the id shape of
              ;; Hermes' live-transcript batch
              ;; (`tools/delegation_live_log.create_live_transcripts`:
              ;; `deleg_` + 8 hex) — every child of the batch shares it
              delegation-id (str "deleg_" (h/random-hex 4))
              ids (mapv (fn [_] (str "sub-" (h/random-hex 6))) tasks)
              child-run (fn [id task]
                          (let [goal (get task "goal")
                                schema (get task "output_schema")
                                prompt (delegate-child-prompt task)
                                ctl {:steer (atom []) :cancel (atom false)}
                                child-options (assoc parent-options
                                                     :tool-names child-names
                                                     :toolsets nil
                                                     :history []
                                                     :task-id id
                                                     :session-key (str (or (:session-key parent-options) ""))
                                                     ;; the child's live-parent record
                                                     ;; (Hermes tools/delegate_tool_registry
                                                     ;; ._active_subagents + the child agent's
                                                     ;; _delegate_parent_ref): gates
                                                     ;; process_manage handoff
                                                     :subagent {:parent-owner (str (or (:task-id parent-options) ""))
                                                                :parent-session-key (str (or (:session-key parent-options) ""))
                                                                :handed (atom [])}
                                                     :steer-queue (:steer ctl)
                                                     :cancelled? (:cancel ctl)
                                                     :instructions "You are a Kotoba child agent. Return a concise result for the parent task.")
                                done (fn [result extra]
                                       (let [base (merge {"subagent_id" id
                                                          "goal" goal
                                                          "status" (:exit-reason result)
                                                          "summary" (when-let [summary (:final result)]
                                                                      (subs summary 0 (min 8000 (count summary))))
                                                          "error" (get-in result [:error :error])} extra)]
                                         (swap! delegate-children assoc id {"goal" goal
                                                                            "status" (get base "status")
                                                                            "summary" (get base "summary")})
                                         (swap! delegate-ctl dissoc id)
                                         ;; Hermes tools/delegate_tool_registry._unregister_subagent:
                                         ;; the record moves to the bounded recent FIFO
                                         (proc/unregister-subagent-attribution! id)
                                         base))]
                            (swap! delegate-children assoc id {"goal" goal "status" "running"})
                            (swap! delegate-ctl assoc id ctl)
                            ;; Hermes tools/delegate_tool_registry._register_child:
                            ;; the process-notice attribution record
                            (proc/register-subagent-attribution!
                             {"subagent_id" id "goal" goal "delegation_id" delegation-id})
                            (-> (run prof prompt (assoc child-options :budget-s budget-s))
                                (p/then (fn [result]
                                          (if-not schema
                                            (done result nil)
                                            (let [v (delegate-validate-schema schema (:final result))]
                                              (if (get v "schema_valid")
                                                (done result v)
                                                ;; one bounded correction retry, then keep the raw
                                                ;; summary and report the errors beside it
                                                (-> (run prof (str prompt "\n\n# Correction\nYour previous answer "
                                                                   "failed validation: " (str/join ", " (get v "schema_errors"))
                                                                   "\nPrevious answer:\n" (subs (str (:final result)) 0 (min 4000 (count (str (:final result))))))
                                                         (assoc child-options :budget-s budget-s))
                                                    (p/then (fn [r2] (done r2 (delegate-validate-schema schema (:final r2)))))
                                                    (p/catch (fn [_] (done result v)))))))))
                                (p/catch (fn [e]
                                           (swap! delegate-children assoc id {"goal" goal "status" "failed"})
                                           (proc/unregister-subagent-attribution! id)
                                           {"subagent_id" id "goal" goal "status" "failed" "error" (.-message e)})))))
              child-runs (mapv child-run ids tasks)]
          (if (false? (:join-children? parent-options))
            ;; background: dispatch returns live handles now; finished
            ;; results re-enter as a new message between turns
            (p/resolved (h/json-str {"background" true
                                     "results" (vec (for [[id task] (map vector ids tasks)]
                                                      {"subagent_id" id "goal" (get task "goal")
                                                       "status" "running"}))}))
            (p/then (p/all child-runs)
                    (fn [results]
                      (h/json-str {"results" (vec results)
                                   "total_duration_seconds" (/ (- (h/now-ms) t0) 1000)})))))))))
