(ns itonami.agent.delivery-queue
  "The delivery queue -- the HOST-ADAPTER splice of this surface (trench
  3): the node:sqlite implementation is replaced by delegation to
  itonami.delivery (the guest implementation proven node-free, ledger
  measurement 21: the 6-status vocabulary, fenced finish, the recover
  safety side, the ledger-outcome mapping).

  API drift measured (the subset has no exceptions, maps, or sets --
  recorded, not papered over):
    enqueue!           -> 1 queued / 0 refused (was: a row map; the
                          tombstone case answers 0 where SQLite returned
                          the terminal outcome -- the module parity note
                          covers this: terminal rows are kept, a re-enqueue
                          of a terminal id answers 0)
    get-status         -> the i64 status code, -1 unknown (was: a status
                          string with a tombstone fallback)
    claim-row!         -> 1 claimed / 0 (was: a row map)
    claim-next!        -> the claimed id or the empty string (was: a row
                          map)
    finish!            -> status as a STRING maps to the code vocabulary
                          (pending 0 / delivering 1 / delivered 2 /
                          failed 3 / unknown 4 / suppressed 5); answers
                          1 finished / 0
    recover-abandoned! -> 1 recovered / 0 (was: a row count)
    ledger-outcome     -> ledger-outcome-of, a FUNCTION (was: a map for
                          (get ...)); delivered -> delivered, suppressed ->
                          suppressed, failed -> failed, unknown -> failed
                          (the intentional asymmetry: a loss whose outcome
                          cannot be told is a failure)
    terminal-statuses  -> terminal-status?, a predicate (was: a set)
    prune-terminal!    -> answers 0 and prunes nothing (the module keeps
                          terminal rows; max-terminal-deliveries stays as
                          the documented cap for the SQLite store)

  finished_at timestamps are dropped (the guest has no clock wiring in
  this slice) and the job/content/for-failure? columns are not carried --
  the queue journal holds enqueue order and per-id state only; content
  delivery rides the send path. The callers keep the function names and
  splice at their own trench."
  (:require [itonami.delivery :as dq])
  (:export [db-path enqueue! get-status claim-row! claim-next! finish!
            recover-abandoned! ledger-outcome-of terminal-status?
            prune-terminal! max-terminal-deliveries]))

(defn max-terminal-deliveries [] :i64 1000)

(defn db-path [home :string] :string home)

(defn- base-of [home :string job :string] :string home)

(defn enqueue! [home :string execution-id :string job :string content :string for-failure? :string] :i64
  (dq/dq-enqueue (base-of home job) execution-id))

(defn get-status [home :string execution-id :string] :i64
  (dq/dq-status (base-of home "") execution-id))

(defn claim-row! [home :string execution-id :string] :i64
  (dq/dq-claim-row (base-of home "") execution-id))

(defn claim-next! [home :string] :string
  (dq/dq-claim-next (base-of home "")))

(defn- status-code [status :string] :i64
  (if (string=? status "pending") 0
    (if (string=? status "delivering") 1
      (if (string=? status "delivered") 2
        (if (string=? status "failed") 3
          (if (string=? status "unknown") 4
            (if (string=? status "suppressed") 5 -1)))))))

(defn finish! [home :string execution-id :string status :string error :string] :i64
  (dq/dq-finish (base-of home "") execution-id (status-code status) error))

(defn recover-abandoned! [home :string execution-id :string] :i64
  (dq/dq-recover (base-of home "") execution-id))

(defn ledger-outcome-of [status :string] :string
  (if (string=? status "suppressed") "suppressed"
    (if (string=? status "delivered") "delivered"
      (if (string=? status "failed") "failed" "failed"))))

(defn terminal-status? [status :string] :i64
  (if (string=? status "delivered") 1
    (if (string=? status "failed") 1
      (if (string=? status "unknown") 1
        (if (string=? status "suppressed") 1 0)))))

(defn prune-terminal! [home :string] :i64
  (let [n 0]
    n))
