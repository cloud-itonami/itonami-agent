(ns itonami.agent.profile
  "A profile, read the way Hermes reads it, plus the itonami layer.

  Layout (identical format in both stores; the stores themselves are separate):
    <home>/SOUL.md profile.yaml config.yaml .env cron/jobs.json scripts/ skills/ workspace/

  The itonami store is <itonami-root>/profiles/<name>/ (ITONAMI_DIR,
  default ~/.itonami). The Hermes home (~/.hermes) is a different store that
  this agent never writes to; `profile import` / `profile export` copy a
  profile's DEFINITION between the two, and state and DBs never cross.

  itonami layer (additive; a plain Hermes profile has none of it):
    <home>/itonami.edn          what the profile is on the itonami plane:
                                identity, placement (local | p2p), inference
                                rail, state policy, bundle CID
    <home>/.itonami/            host-local itonami state (run receipts, peer
                                bundle cache). Never exported, never sent.

  A profile with an itonami.edn is an *itonami profile*. It stays a valid
  Hermes-format profile: deleting itonami.edn returns it to plain Hermes."
  (:require [clojure.string :as str]
            ["node:fs" :as fs]
            [cljs.reader :as reader]
            [itonami.agent.host :as h]
            [itonami.agent.manifest :as manifest]
            [itonami.agent.yaml :as yaml]))

(def manifest-schema manifest/schema-v2)

(defn itonami-root
  "The itonami home: profiles and state live here. The Hermes home is a
  different store — the two share file FORMATS (a profile directory is a
  valid profile directory on either side), never files."
  []
  (h/expand (or (h/env "ITONAMI_DIR") "~/.itonami")))

(defn profiles-root [] (h/join (itonami-root) "profiles"))

(defn hermes-root
  "The Hermes home. itonami-agent never writes here: `profile import` reads
  it as the migration source (ITONAMI_HERMES_ROOT points it elsewhere)."
  []
  (h/expand (or (h/env "ITONAMI_HERMES_ROOT") "~/.hermes")))

(defn valid-name?
  "A profile name: a lowercase token of at most 64 chars. Non-strings refuse —
  the coercion is for callers passing keyword/string twins, not for numbers."
  [n]
  (boolean (and (string? n) (re-matches #"^[a-z0-9][a-z0-9_-]{0,63}$" n))))

(defn home-in
  "Profile name -> its home directory in an explicit store root. `default` is
  the root itself, as in the Hermes layout. A non-default name MUST satisfy
  `valid-name?` — this join is the one place a name becomes a path, so
  `-p ../..` cannot escape the store (defense in depth; `-main` gates too)."
  [root name]
  (cond
    (or (nil? name) (= name "default")) root
    (valid-name? name) (h/join root "profiles" name)
    :else (throw (js/Error. (str "invalid profile name: " (pr-str name))))))

(defn home
  "Profile name -> its home directory in the itonami store. `default` is the
  root itself."
  [name]
  (home-in (itonami-root) name))

(defn names-in [root]
  (let [d (h/join root "profiles")]
    (vec (filter #(and (valid-name? %) (h/dir? (h/join d %))) (h/ls d)))))

(defn names [] (names-in (itonami-root)))

;; ---------------------------------------------------------------- definition copy (store -> store)

(def definition-files
  "What a profile IS, in the format both stores share. Everything else under
  a profile home is state (sessions, run logs, cron output) and stays with
  the store that produced it: profiles move, DBs never do."
  ["SOUL.md" "profile.yaml" "config.yaml" ".env" "secrets.command"
   "yakuwari.edn" "itonami.edn" "cron/jobs.json"])

(def definition-dirs ["scripts" "skills"])

(defn copy-profile!
  "Copy one profile's DEFINITION from one store's home to another's, byte for
  byte (the formats are identical on both sides). State and DBs — sessions/,
  workspace/, memories/, logs/, .itonami/, cron/output/, cron/usage_audit.jsonl,
  cron/ticker_*, cron/itonami-runs.jsonl — never cross. Returns
  {:copied [rel ...]}. A non-empty target is refused unless :force?."
  [from-home to-home {:keys [force?]}]
  (when-not (h/dir? from-home)
    (throw (ex-info (str "profile not found: " from-home) {:itonami/error :profile-not-found :home from-home})))
  (when (and (not force?) (h/dir? to-home) (seq (h/ls to-home)))
    (throw (ex-info (str "target is not empty: " to-home) {:itonami/error :target-not-empty :home to-home})))
  (let [files (concat
               (for [f definition-files
                     :let [p (h/join from-home f)]
                     :when (h/file? p)]
                 [f p])
               (for [d definition-dirs
                     r (h/walk-files (h/join from-home d) #(str/starts-with? (h/basename %) "."))
                     :let [p (h/join from-home d r)]]
                 [(str d "/" r) p]))]
    (doseq [[rel p] files]
      (h/copy-file! p (h/join to-home rel)))
    {:copied (mapv first files)}))

;; ---------------------------------------------------------------- env

(defn parse-dotenv [text]
  (into {}
        (keep (fn [line]
                (let [l (str/trim line)]
                  (when-not (or (str/blank? l) (str/starts-with? l "#"))
                    (when-let [[_ k v] (re-matches #"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$" l)]
                      (let [v (str/trim v)
                            v (cond
                                (and (str/starts-with? v "\"") (str/ends-with? v "\"") (> (count v) 1)) (subs v 1 (dec (count v)))
                                (and (str/starts-with? v "'") (str/ends-with? v "'") (> (count v) 1)) (subs v 1 (dec (count v)))
                                :else (str/trim (str/replace v #"\s+#.*$" "")))]
                        [k v])))))
        (str/split-lines (or text "")))))

(defn- secrets-command-env
  "Hermes `secrets.command`: a helper that prints KEY=VAL lines (e.g. from the
  macOS keychain). Run only when enabled; a failing helper yields {}."
  [config]
  (let [c (get-in config ["secrets" "command"])
        {:strs [enabled command helper_timeout_seconds]} (if (map? c) c {})]
    (if (and enabled (string? command) (not (str/blank? command)))
      (let [r (h/run-process command {:shell true :timeout-ms (* 1000 (or helper_timeout_seconds 10))})]
        (if (zero? (:exit r)) (parse-dotenv (:stdout r)) {}))
      {})))

;; ---------------------------------------------------------------- load

(defn read-edn-file [p] (when (h/file? p) (reader/read-string (h/slurp p))))

(defn read-yaml-file [p] (if (h/file? p) (yaml/parse (h/slurp p)) {}))

(defn read-jobs [home]
  (let [p (h/join home "cron" "jobs.json")]
    (if (h/file? p) (h/json-parse (h/slurp p)) {"jobs" []})))

(declare load-profile*)

(defn load-profile
  "Everything a run needs, as data. Secrets are resolved into :env and never
  leave this map except into the provider call that names them."
  ([name] (load-profile name {}))
  ([name opts] (load-profile* (home name) name opts)))

(defn load-profile*
  "load-profile for an explicit home directory (a peer's materialized bundle).
  opts {:secrets? false} skips .env / secrets.command (for commands that only
  read the definition: list, show, itonamify, bundle)."
  ([home name] (load-profile* home name {}))
  ([home name {:keys [secrets?] :or {secrets? true}}]
  (do
    (when-not (h/dir? home)
      (throw (ex-info (str "profile not found: " name) {:itonami/error :profile-not-found :profile name})))
    (let [config (read-yaml-file (h/join home "config.yaml"))
          root-env (when (= home (itonami-root)) (parse-dotenv (when (h/file? (h/join home ".env")) (h/slurp (h/join home ".env")))))
          prof-env (parse-dotenv (when (h/file? (h/join home ".env")) (h/slurp (h/join home ".env"))))
          env (if secrets? (merge (h/process-env) root-env (secrets-command-env config) prof-env) {})]
      {:name (or name "default")
       :home home
       :soul (when (h/file? (h/join home "SOUL.md")) (h/slurp (h/join home "SOUL.md")))
       :profile-yaml (read-yaml-file (h/join home "profile.yaml"))
       :config config
       :env env
       :jobs (read-jobs home)
       :itonami (read-edn-file (h/join home "itonami.edn"))}))))

(defn description [p] (get-in p [:profile-yaml "description"]))

;; ---------------------------------------------------------------- bundle (content-addressed profile)

(def host-local-config-keys
  "Same set scripts/hermes-profile-repo.cljk keeps on the host."
  #{"secrets" "command_allowlist" "onboarding" "terminal" "skills"})


(defn- reader-coerces?
  "TRUE when yaml.cljk's scalar reader would turn this PLAIN token into a
  non-string (or throw on it). The exclusion set is exactly that reader's
  behavior — ints, floats, its null/bool spellings, its sequence/map shapes,
  its refused block-scalar/anchor markers — not YAML-1.1 folklore."
  [s]
  (or (= s "")
      (contains? #{"~" "null" "Null" "NULL"
                   "true" "True" "TRUE" "false" "False" "FALSE"
                   "[]"} s)
      (= s "{}")
      (and (str/starts-with? s "[") (str/ends-with? s "]"))
      (re-matches #"-?\d+" s)
      (re-matches #"-?\d+\.\d+([eE][-+]?\d+)?" s)
      (contains? #{"|" ">" "|-" ">-"} s)
      (or (str/starts-with? s "&") (str/starts-with? s "*") (str/starts-with? s "!"))))

(defn- yaml-scalar
  "Write a value as a safe YAML scalar: plain ONLY when the project's own
  scalar reader will hand it back as the same string (reader-coerces? is
  that reader's exact coercion set), otherwise a JSON double-quoted string
  (YAML 1.2 superset) — `: `, `#` and newlines can never corrupt the line."
  [v]
  (let [s (str v)]
    (if (and (re-matches #"[A-Za-z0-9._/-]+" s)
             (not (reader-coerces? s)))
      s
      (js/JSON.stringify s))))

(defn set-model-text
  "Hermes `hermes model NAME` writes the default model into config.yaml.
  The edit is TEXTUAL (like bundle-config-text): comments, formatting and
  keys outside model.default/model.provider survive verbatim. The block is
  the top-level `model:` opener (a bare key, or one carrying a trailing
  comment); its END is the next non-blank COLUMN-0 line (any top-level key
  shape, including dotted/quoted keys, or a top-level comment). Keys are
  replaced IN PLACE at the block's child indent (derived from the first
  non-comment indented line) — a provider not given here is kept."
  [text model provider]
  (let [lines (str/split-lines (str text))
        ;; comments are TRANSPARENT to the reader (comment-only lines are
        ;; stripped before parsing), so they must not end the block — only a
        ;; column-0 non-comment line does (the R4 silent-no-op gate)
        top-line? (fn [l] (and (not (str/blank? l))
                               (not (re-matches #"\s+.*" l))
                               (not (str/starts-with? (str/trim l) "#"))))
        ;; the top-level model: opener: `model:` alone, or with a trailing
        ;; comment (the reader's strip-comment accepts both). LAST wins —
        ;; the reader keeps the last duplicate mapping (the R4 block gate)
        start (last (keep-indexed (fn [i l]
                                    (when (and (top-line? l)
                                               (re-matches #"model:(\s*(#.*)?)?" l))
                                      i))
                                  lines))
        block-end (if (nil? start)
                    nil
                    (or (first (for [i (range (inc start) (count lines))
                                     :let [l (nth lines i)]
                                     :when (top-line? l)]
                                 i))
                        (count lines)))
        body (when start (vec (subvec (vec lines) start block-end)))
        ;; the block's child indent comes from the first indented NON-COMMENT
        ;; line — a differently-indented comment must not set it
        child-indent (when body (or (first (for [l (rest body)
                                                 :when (and (re-matches #"\s+\S.*" l)
                                                            (not (re-matches #"\s*#.*" l)))]
                                             (count (re-find #"^\s*" l))))
                                    2))
        pad (apply str (repeat child-indent " "))
        ;; the key shapes the reader's split-key accepts: quoted (double or
        ;; single) or bare, with optional spaces before the colon
        key-rx (fn [k] (re-pattern (str "^" pad "(?:\"|')?" k "(?:\"|')?\\s*:.*$")))
        trailing-comment (fn [l] (second (re-find #"(\s+#.*)$" l)))
        replace-key (fn [ls k value]
                      (let [rx (key-rx k)
                            hits (keep-indexed (fn [i l] (when (re-matches rx l) i)) ls)
                            ;; the reader keeps the LAST duplicate key —
                            ;; replace THAT one and drop the earlier ones
                            idx (last hits)
                            keep (remove (set (butlast hits)) (vec (range (count ls))))
                            ls (mapv #(nth ls %) keep)
                            idx (last (keep-indexed (fn [i l] (when (re-matches rx l) i)) ls))
                            comment (when idx (trailing-comment (nth ls idx)))
                            line (str pad k ": " (yaml-scalar value) (or comment ""))]
                        (if (nil? idx)
                          (conj (vec ls) line)
                          (assoc (vec ls) idx line))))]
    (cond
      (nil? start)
      (str (str text)
           (when-not (str/blank? (str text)) "\n")
           (str/join "\n" (filter some? ["model:"
                                          (str "  default: " (yaml-scalar model))
                                          (when-not (str/blank? (str provider))
                                            (str "  provider: " (yaml-scalar provider)))]))
           "\n")

      :else
      ;; replace-key replaces IN PLACE when the key exists (the R2 gate: no
      ;; drop-then-append, so comments stay attached to their keys and the
      ;; key order is preserved); a model-only write never touches provider
      (let [body (cond-> body
                   true (replace-key "default" model)
                   (not (str/blank? (str provider))) (replace-key "provider" provider))]
        (str (str/join "\n" (concat (subvec (vec lines) 0 start) body (subvec (vec lines) block-end)))
             (when (seq lines) "\n"))))))

(defn set-config-model!
  "Persist the default model (and optional provider) in the profile's
  config.yaml. Atomic: write to a sibling temp file, then rename. The file's
  MODE is preserved (config.yaml can hold literal auth headers — the repo
  convention for such files is 0600, and a rename-replace would otherwise
  silently loosen a stricter operator mode to umask 0644); a symlink is
  followed to its target so the link itself is never replaced."
  [home model provider]
  (let [p (h/join home "config.yaml")
        st (try (fs/lstatSync p) (catch :default _ nil))
        p (if (and st (.-isSymbolicLink st))
            (try (fs/realpathSync p) (catch :default _ p))
            p)
        mode (try (bit-and 511 (.-mode (fs/statSync p))) (catch :default _ 384))
        text (if (h/file? p) (h/slurp p) "")
        tmp (str p ".tmp-" (.-pid js/process) "-" (h/random-hex 4))]
    ;; the tmp file is created OWNER-ONLY before any secret content lands
    ;; (the R4 gate: umask 0644 must never hold config text) and renamed
    ;; into place; the target keeps its own mode
    (fs/writeFileSync tmp (set-model-text text model provider) #js {:mode mode})
    (fs/renameSync tmp p)
    (fs/chmodSync p mode)
    p))

(def job-definition-keys
  #{"id" "name" "prompt" "skills" "skill" "script" "no_agent" "schedule" "deliver" "enabled"
    "enabled_toolsets" "model" "provider" "base_url" "workdir" "context_from"})

(defn- bundle-config-text [home]
  (let [p (h/join home "config.yaml")]
    (when (h/file? p)
      ;; drop host-local top-level blocks textually, so the bundle keeps the
      ;; operator's formatting and comments for everything it does carry
      (let [lines (str/split-lines (h/slurp p))]
        (loop [[l & more] lines skip? false out []]
          (if (nil? l)
            (str (str/join "\n" out) "\n")
            (let [top (second (re-matches #"^([A-Za-z_][A-Za-z0-9_-]*):.*$" l))]
              (cond
                top (if (host-local-config-keys top) (recur more true out) (recur more false (conj out l)))
                skip? (recur more true out)
                :else (recur more false (conj out l))))))))))

(defn bundle-files
  "path -> string content of what crosses to a peer: the profile's definition,
  never its secrets, workspace, sessions, memories or run state."
  [home {:keys [skills dirs]}]
  (let [f (fn [rel] (let [p (h/join home rel)] (when (h/file? p) [rel (h/slurp p)])))
        jobs (read-jobs home)
        scripts (->> (h/walk-files (h/join home "scripts") (fn [r] (or (str/includes? r "__pycache__") (str/starts-with? (h/basename r) "."))))
                     (remove #(re-find #"\.(sh|bash)$" %))
                     (map #(f (str "scripts/" %))))
        ;; extra directories the profile declares in itonami.edn :bundle :dirs
        ;; (e.g. the data a bot's scripts read), so a peer gets them by CID too
        dir-files (for [d dirs
                        :when (and (string? d) (not (str/includes? d "..")) (not (str/starts-with? d "/"))
                                   (not (#{"workspace" "sessions" "memories" "logs" "cache" "cron" "skills"} d)))
                        r (h/walk-files (h/join home d) (fn [r] (str/starts-with? (h/basename r) ".")))]
                    (f (str d "/" r)))
        skill-files (for [s skills
                          r (h/walk-files (h/join home "skills" s) (fn [r] (str/starts-with? (h/basename r) ".")))]
                      (f (str "skills/" s "/" r)))]
    (into (sorted-map)
          (remove nil?
                  (concat [(f "SOUL.md") (f "profile.yaml") (f "itonami.edn")
                           (when-let [c (bundle-config-text home)] ["config.yaml" c])
                           ["cron/jobs.json" (h/json-str {"jobs" (mapv #(select-keys % job-definition-keys) (get jobs "jobs"))} 2)]]
                          scripts dir-files skill-files)))))

(defn bundle-manifest
  "Sorted [path sha256] pairs; its CID names the bundle. itonami.edn is left
  out of its own CID (it records the CID)."
  [files]
  ;; sorted by path: a bundle that crossed the wire as JSON comes back as a
  ;; hash map whose order is not the sender's
  (vec (for [[p c] (sort-by key files) :when (not= p "itonami.edn")] [p (h/sha256-hex c)])))

(defn bundle-cid [files]
  (h/cid-raw (h/json-str (bundle-manifest files))))

(defn verify-bundle
  "true when files hash to cid."
  [cid files]
  (= cid (bundle-cid files)))

;; ---------------------------------------------------------------- itonami.edn

(defn- capabilities-from-yakuwari [home]
  (when-let [y (try (read-edn-file (h/join home "yakuwari.edn")) (catch :default _ nil))]
    (vec (for [c (:yakuwari/capabilities y)] (select-keys c [:capability :decision :note])))))

(defn default-manifest
  "The itonami.edn a Hermes profile gets when it joins the itonami plane.
  Nothing here grants authority: capabilities are copied from yakuwari.edn
  (which already decides them) and placement only says where a turn MAY run."
  [p]
  (let [home (:home p)
        cron? (seq (get-in p [:jobs "jobs"]))
        files (bundle-files home {})]
    {:itonami/schema manifest-schema
     :profile/id (:name p)
     :profile/description (description p)
     :profile/hermes-compatible true
     :runtime {:engine :itonami-agent
               ;; who ticks cron for this profile. :hermes until `adopt` hands it
               ;; over, so the two schedulers never both fire one job
               :scheduler :hermes}
     :placement {:mode :p2p
                 ;; a turn runs where its inference and tools are allowed to:
                 ;; a trusted peer first (pulls the bundle by CID); local when none is available
                 :order [:peer :local]
                 :peers :trusted
                 :inference-rail :murakumo}
     ;; rails a turn may use: murakumo only. itonami-p2p (this node's / peers'
     ;; own servers) is opt-in via `profile rail`; third-party relays are
     ;; dropped from the chain
     :inference {:rails [:murakumo]
                 ;; the authority server behind the rail: used while healthy,
                 ;; behind a circuit breaker; still tried when it is the last rail
                 :authorities ["api.murakumo.cloud"]
                 :deny-hosts ["openrouter.ai"]}
     :state {:workspace :host-local
             :results :cid-receipts
             :secrets :never-leave-host}
     :bundle {:cid (bundle-cid files)
              :files (count files)
              :skills []}
     :capabilities (or (capabilities-from-yakuwari home) [])
     :cron? (boolean cron?)}))

(def rail-authorities
  "The authority server behind each operator rail. itonami-p2p has none of
  its own; the profile's config chain keeps the default authorities guarded."
  {:murakumo ["api.murakumo.cloud"]
   :kotoba ["api.kotoba.cloud"]
   :itonami-p2p ["api.kotoba.cloud" "api.murakumo.cloud"]})

(defn with-inference-rail
  "Point an itonami manifest at one inference rail: :placement
  :inference-rail (what a peer puts on the chain) and :inference :rails /
  :authorities (what the chain keeps). Other keys are untouched."
  [m rail]
  (-> m
      (assoc-in [:placement :inference-rail] rail)
      (assoc-in [:inference :rails] [rail])
      (assoc-in [:inference :authorities] (get rail-authorities rail []))
      (update-in [:inference :deny-hosts] #(or % ["openrouter.ai"]))))

(defn write-manifest! [home m]
  (h/spit-atomic (h/join home "itonami.edn")
                 (str ";; itonami profile (" (:itonami/schema m manifest-schema) "). Additive to the Hermes layout:\n"
                      ";; Hermes ignores this file; removing it returns the profile to plain Hermes.\n"
                      (pr-str m) "\n")))

(defn with-bundle
  "The manifest with its bundle CID and file count recomputed from the
  profile's current SOUL, config, jobs, scripts and declared skills/dirs."
  [home m]
  (let [files (bundle-files home (select-keys (:bundle m) [:skills :dirs]))]
    (assoc m :bundle (merge (:bundle m) {:cid (bundle-cid files) :files (count files)}))))

(defn with-derived
  "The manifest with everything derived from the profile's own files
  recomputed: the bundle (`with-bundle`) and, when the profile has a
  yakuwari.edn, :capabilities — a verbatim copy of what yakuwari.edn decides
  (itonami.edn grants nothing itself). Without yakuwari.edn the
  capabilities are left as they are."
  [home m]
  (let [m (with-bundle home m)]
    (if (h/file? (h/join home "yakuwari.edn"))
      (assoc m :capabilities (or (capabilities-from-yakuwari home) []))
      m)))

(defn refresh-bundle-cid
  "Recompute the bundle CID of an itonami profile (after its SOUL, config,
  jobs or scripts changed) and write it back. Returns the manifest."
  [home]
  (let [m (with-bundle home (read-edn-file (h/join home "itonami.edn")))]
    (write-manifest! home m)
    m))

(def soul-blocks
  "Managed SOUL blocks every itonami profile is expected to carry."
  {:workspace-locations "<!-- managed-agent-workspace-locations -->"
   :reward-contract "<!-- itonami:reward-contract:v1 -->"})

(defn check
  "What `profile check` reports for one loaded profile: manifest problems
  (`manifest/validate`, plus an id that is not the directory's) and drift
  between the manifest and the files it describes — a stale bundle CID, a
  config provider other than the declared rail, a missing managed SOUL
  block. Reads the profile's files; writes nothing."
  [p]
  (let [m (:itonami p)]
    (if-not m
      {:profile (:name p) :problems [{:level :warn :path [] :message "no itonami.edn"}] :drift []}
      (let [recorded (get-in m [:bundle :cid])
            actual (get-in (with-bundle (:home p) m) [:bundle :cid])
            rail (get-in m [:placement :inference-rail])
            provider (get-in p [:config "model" "provider"])
            soul (or (:soul p) "")]
        {:profile (:name p)
         :problems (cond-> (manifest/validate m)
                     (not= (:name p) (:profile/id m))
                     (conj {:level :error :path [:profile/id]
                            :message (str (pr-str (:profile/id m)) " but the directory is " (:name p))}))
         :drift (cond-> []
                  (not= recorded actual)
                  (conj {:drift :bundle-cid :recorded recorded :actual actual})
                  (and (keyword? rail) (not= :itonami-p2p rail) (not= (name rail) provider))
                  (conj {:drift :config-provider :declared rail :config provider})
                  (not (str/includes? soul (:workspace-locations soul-blocks)))
                  (conj {:drift :soul-block :missing :workspace-locations})
                  (not (str/includes? soul (:reward-contract soul-blocks)))
                  (conj {:drift :soul-block :missing :reward-contract}))}))))
