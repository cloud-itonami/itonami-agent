(ns itonami.agent.main
  "itonami-agent — a Hermes-compatible agent written in kotoba.

  Hermes-compatible surface (same profile homes, same files):
    itonami-agent [-p P] -z PROMPT [-m MODEL] [--provider P] [-t toolsets]
    itonami-agent [-p P] chat
    itonami-agent bridge < request.json   one JSON request in; JSONL events/result out
    itonami-agent [-p P] cron list | create <schedule> [prompt] [--name n --script s --no-agent]
                              [--monitor-script s --monitor-url u --deliver d]
                              | run <id> | tick [--force] | runs [--limit n] | status
                              | incidents [ack <id>]
    itonami-agent profile list | show <p>

  itonami layer:
    itonami-agent profile itonamify <p>|--all [--dry-run]   write itonami.edn (additive)
    itonami-agent profile readiness <p>|--all              audit Kotoba cron compatibility
    itonami-agent profile adopt <p>|--all|--ready-only [--dry-run] itonami ticks selected cron; Hermes stops
    itonami-agent profile hy-stage <p>|--all <artifact-dir> [--dry-run] copy verified sibling .hy sources into profile scripts/
    itonami-agent profile hy-migrate <p>|--all [--dry-run]  switch eligible Kotoba-owned script refs to sibling .hy files
    itonami-agent profile release <p>|--all [--dry-run]     hand selected cron back to Hermes
    itonami-agent profile rail <p>|--all --to R [--dry-run] inference rail: murakumo | kotoba | itonami-p2p
    itonami-agent profile check <p>|--all [--summary]       validate itonami.edn and report drift (read-only)
    itonami-agent profile refresh <p>|--all [--dry-run]     recompute the bundle CID
    itonami-agent profile organize <p>|--all --registry F [--dry-run]
                                                            place profiles in the organisation (schema v2)
    itonami-agent profile bundle <p>                        print the bundle CID and file list
    itonami-agent profile refresh-bundle <p>                recompute CID after profile files change
    itonami-agent gateway run [--interval 60]               tick every adopted profile (resident)
    itonami-agent doctor [--profile P]          named findings, exit 1 when any
    itonami-agent sessions [list] [--limit N] | show <id> | resume <id>
    itonami-agent model | fallback [--profile P]   show the effective resolution
    itonami-agent status | pause [reason] | resume
    itonami-agent send --chat-id C [--platform P] [--thread-id T] [--profile P] <text>
    itonami-agent gateway serve [--platform telegram] [--interval seconds]
                                        poll the platform and run inbound turns
                                        (--interval = the poll-error backoff)
    itonami-agent dapps                                     itonami_dapps MCP servers and how they resolve here
    itonami-agent peer id | serve [--port 7420 --url U --max-runs 2]
                       | add <url> [--did D --trust] | trust <did> | list
                       | run -p P -z PROMPT                  run one turn on a trusted peer
                       | rails [detect [--dry-run] | add <base-url> --models a,b [--small]]  own rails
                       | authorities                         breaker state of the authority servers

  -z prints only the final text (exit 0), or `itonami-agent -z: <reason>` on
  stderr with exit 1, as `hermes -z` does."
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]
            [itonami.agent.profile :as profile]
            [itonami.agent.identity :as identity]
            [itonami.agent.soul :as soul]
            [itonami.agent.manifest :as manifest]
            [itonami.agent.loop :as agent-loop]
            [itonami.agent.process :as proc]
            [itonami.agent.quiet :as quiet]
            [itonami.agent.tools :as tools]
            [itonami.agent.browser :as browser]
            [itonami.agent.computer-use :as computer-use]
            [itonami.agent.cron :as cron]
            [itonami.agent.notepad :as notepad]
            [itonami.agent.vault :as vault]
            [itonami.agent.oauth :as oauth]
            [itonami.agent.mcp :as mcp]
            [itonami.agent.dapps :as dapps]
            [itonami.agent.execution-ledger :as execution-ledger]
            [itonami.agent.p2p :as p2p]
            [itonami.agent.rails :as rails]
            [itonami.agent.provider :as provider]
            [itonami.agent.chat-platform :as chat]
            [itonami.agent.platform-adapters :as platforms]
            [itonami.agent.pause :as pause]
            ["node:readline" :as readline]
            ["node:crypto" :as crypto]))

(def ^:private boolean-flags
  "Flags whose values are true/false — the ONLY keys opt-value coerces."
  #{:force :verbose :trust})

(defn- opt-value
  "Value shaping for the generic `--flag value` / `--flag=value` branch.
  Semantics: a value is a value — everything is verbatim, EXCEPT toolsets
  (comma split, both spellings agree) and the known boolean flags (literal
  true/false coerce, so `--force=false` is false). Named value flags
  (-p/-z/-m/--provider/--model/--provider) are arbitrary strings in BOTH
  spellings; short flags never take `=`."
  [k v]
  (cond
    (= k :toolsets) (str/split (str v) #",")
    (contains? boolean-flags k) (cond (= "true" (str v)) true
                                      (= "false" (str v)) false
                                      :else v)
    :else v))

(defn parse-args
  "Hermes-style: -p/--profile anywhere, flags with values, the rest positional.
  `--flag=value` carries the whole value. A following token is a VALUE when it
  is not dash-prefixed or is a negative number — Telegram group chat ids are
  exactly `-100123...` and must not be read as a boolean flag."
  [args]
  (loop [[a & more] args opts {} pos []]
    (cond
      (nil? a) [opts pos]
      ;; value flags take their value verbatim — a prompt or a model name may
      ;; be any string (`-z false` is the prompt "false"), so no flag
      ;; coercion here; only --toolsets shapes (comma split)
      (#{"-p" "--profile"} a) (recur (rest more) (assoc opts :profile (first more)) pos)
      (#{"-z" "--oneshot"} a) (recur (rest more) (assoc opts :oneshot (first more)) pos)
      (#{"-m" "--model"} a) (recur (rest more) (assoc opts :model (first more)) pos)
      (= "--provider" a) (recur (rest more) (assoc opts :provider (first more)) pos)
      (#{"-t" "--toolsets"} a) (recur (rest more) (assoc opts :toolsets (str/split (first more) #",")) pos)
      (str/starts-with? a "--")
      (if-let [eq (str/index-of a "=")]
        (let [k (keyword (subs a 2 eq))]
          (recur more (assoc opts k (opt-value k (subs a (inc eq)))) pos))
        (let [k (keyword (subs a 2))
              v (first more)]
          (if (or (nil? v)
                  (and (str/starts-with? v "-")
                       (not (re-matches #"-?\d+(\.\d+)?" v))))
            (recur more (assoc opts k true) pos)
            (recur (rest more) (assoc opts k (opt-value k v)) pos))))
      :else (recur more opts (conj pos a)))))

(defn- die [code msg] (binding [*print-fn* *print-err-fn*] (println msg)) (js/process.exit code))

(defn- executor [opts]
  (p2p/placement-executor {:origin-url (:origin opts) :force-peer? (:peer opts)}))

(defn- log-event [e]
  (binding [*print-fn* *print-err-fn*]
    (println (str "[itonami-agent] " (name (:event e)) " "
                  (pr-str (dissoc e :event :content))))))

(defn- run-opts [opts prof]
  (cond-> {:model (:model opts) :provider (:provider opts) :pinned? (boolean (:model opts))
           :toolsets (:toolsets opts) :platform "cli" :load-context? true :cwd (js/process.cwd)
           :join-children? (:join-children? opts)
           :tool-overrides {"cronjob_manage" (fn [_ args] (cron/manage prof args))}}
    (:verbose opts) (assoc :on-event log-event)))

(defn bridge
  "JSONL local-host protocol. First line is the request; later approval lines
  resolve tool calls before execution. Unsupported tools fail closed."
  []
  (let [rl (readline/createInterface #js {:input js/process.stdin :crlfDelay js/Infinity})
        started? (atom false)
        pending (atom {})]
    (defn send-row [row] (println (h/json-str row)))
    (defn start-request [request]
      (let [profile-name (or (get request "profile") "default")
            prompt (get request "prompt")
            requested-tools (get request "tool_names")
            unsupported (tools/unsupported-tools requested-tools)]
        (when-not (string? prompt)
          (throw (ex-info "bridge request requires a string prompt" {})))
        (when-not (vector? requested-tools)
          (throw (ex-info "bridge request requires an explicit tool_names array" {})))
        (when (seq unsupported)
          (throw (ex-info (str "Kotoba agent does not implement requested tools: "
                               (str/join ", " unsupported))
                          {:unsupported-tools unsupported})))
        (let [prof (profile/load-profile profile-name)
              ask-before-tool (fn [{:keys [name arguments]}]
                                (let [request-id (.randomUUID crypto)]
                                  (js/Promise.
                                   (fn [resolve]
                                     (swap! pending assoc request-id resolve)
                                     (send-row {"type" "approval.request"
                                                "request_id" request-id
                                                "choices" ["once" "deny"]
                                                "tool" name "arguments" arguments
                                                "description" (str "Allow Kotoba agent to run " name "?")})))))
              options {:model (get request "model")
                       :provider (get request "provider")
                       :pinned? (boolean (get request "model"))
                       :tool-names requested-tools
                       :history (get request "history")
                       :instructions (get request "instructions")
                       :cwd (or (get request "cwd") (js/process.cwd))
                       :platform "api_server"
                       :load-context? true
                       :max-turns (get request "max_turns")
                       :budget-s (get request "budget_s")
                       :before-tool ask-before-tool
                       :tool-overrides {"cronjob_manage" (fn [_ args] (cron/manage prof args))}
                       :on-event (fn [event]
                                   (send-row {"type" "event" "event" event}))}]
          (-> (agent-loop/run prof prompt options)
              (p/then (fn [result]
                        (let [usage (:usage result)]
                          (send-row
                           {"type" "result"
                            "result" {"final_response" (:final result)
                                      "completed" (= "completed" (:exit-reason result))
                                      "exit_reason" (:exit-reason result)
                                      "error" (or (get-in result [:error :error])
                                                  (when-not (= "completed" (:exit-reason result))
                                                    (:exit-reason result)))
                                      "usage" {"input_tokens" (or (get usage "prompt_tokens") 0)
                                               "output_tokens" (or (get usage "completion_tokens") 0)
                                               "total_tokens" (or (get usage "total_tokens") 0)}
                                      "model" (:model result)
                                      "provider" (:provider result)}})))
              (p/catch (fn [e]
                         (send-row {"type" "error" "error" (.-message e)})
                         (set! (.-exitCode js/process) 1)))
              (p/finally (fn [] (.close rl))))))))
    (.on rl "line"
         (fn [line]
           (try
             (let [message (h/json-parse line)]
               (if-not @started?
                 (do
                   (reset! started? true)
                   (start-request message))
                 (let [request-id (get message "request_id")
                       choice (get message "choice")
                       resolve (get @pending request-id)]
                   (when (and (= (get message "type") "approval")
                              (contains? #{"once" "deny"} choice) resolve)
                     (swap! pending dissoc request-id)
                     (resolve (= choice "once"))))))
             (catch :default e
               (send-row {"type" "error" "error" (.-message e)})
               (set! (.-exitCode js/process) 1)
               (.close rl)))))
    nil))

;; ---------------------------------------------------------------- -z / chat

(defn oneshot [opts]
  ;; Hermes `_run_quiet_single_query` + `_finalize_single_query` phase 3: the
  ;; turn, then — when it did not fail — `continue_quiet_notify_completions`
  ;; (owned `notify_on_complete` completions re-enter as follow-up turns under
  ;; ONE shared linger budget and may displace the printed answer), then the
  ;; bounded exit linger, skipped when the notify loop already consumed the
  ;; budget (`_quiet_notify_linger_done`).
  (let [linger-done? (atom false)
        history (atom nil)]
    (p/let [prof (profile/load-profile (:profile opts))
            config (:config prof)
            run-turn (fn [prompt]
                       (p/let [r ((executor opts) prof prompt
                                  (assoc (run-opts opts prof) :history @history))]
                         (when (seq (:messages r)) (reset! history (:messages r)))
                         r))
            r (run-turn (:oneshot opts))
            r (if (quiet/turn-failed? r)
                r
                (do (reset! linger-done? true)
                    (p/then (quiet/continue-quiet-notify-completions!
                             "" run-turn {:config config})
                            (fn [continued] (if (map? continued) continued r)))))
            _ (quiet/oneshot-exit-linger! config @linger-done?)]
      (if (and (= "completed" (:exit-reason r)) (not (str/blank? (:final r))))
        (do (println (:final r))
            (when (:verbose opts)
              (binding [*print-fn* *print-err-fn*]
                (println (str "[itonami-agent] " (:provider r) "/" (:model r) " turns=" (:turns r)
                              (when (:peer r) (str " peer=" (:peer r))))))))
        (die 1 (str "itonami-agent -z: " (:exit-reason r)
                    (when-let [e (get-in r [:error :error])] (str ": " e))))))))

(defn chat [opts]
  (let [prof (profile/load-profile (:profile opts))
        rl (readline/createInterface #js {:input js/process.stdin :output js/process.stdout})
        history (atom nil)
        clarify-ask
        ;; Hermes' CLI clarify callback: ask each question on the readline,
        ;; number-pick a choice (comma-separated for multi_select) or type
        ;; free text; answers are keyed by qid
        (fn [questions]
          (js/Promise.
           (fn [resolve]
             (let [answers (atom {})
                   settled (atom false)
                   close-handler (atom nil)
                   ;; settle exactly once, dropping the close listener so a
                   ;; long chat never stacks them (Hermes' CLI modal too)
                   settle (fn [reply]
                            (when (compare-and-set! settled false true)
                              (when-let [h @close-handler] (.removeListener rl "close" h))
                              (resolve reply)))
                   qs (vec questions)
                   ask-at (fn ask-at [i]
                            (if-let [q (get qs i)]
                              (do (println (str "\n[clarify] " (get q "question")))
                                  (doseq [[ci c] (map-indexed vector (get q "choices"))]
                                    (println (str "  " (inc ci) ". " c)))
                                  (when (seq (get q "choices")) (println "  (or type your own answer)"))
                                  (.question rl (str (get q "qid") "> ")
                                             (fn [line]
                                               (let [line (str/trim (str line))
                                                     choices (vec (get q "choices"))
                                                     multi? (true? (get q "multi_select"))
                                                     pick1 (fn [tok]
                                                             (let [tok (str/trim (str tok))
                                                                   n (js/parseInt tok 10)]
                                                               (if (and (re-matches #"\d+" tok)
                                                                        (<= 1 n (count choices)))
                                                                 (nth choices (dec n))
                                                                 tok)))
                                                     picked (cond
                                                              (str/blank? line) nil
                                                              multi? (mapv pick1 (remove str/blank? (str/split line #",")))
                                                              :else (pick1 line))]
                                                 (swap! answers assoc (get q "qid") picked)
                                                 (ask-at (inc i))))))
                              (settle {"answers" @answers "outcome" "submitted"})))]
               ;; stdin closing must SETTLE the promise — a dropped
               ;; .question callback would wedge the whole run mid-tool
               ;; (Hermes' CLI modal keeps the answers already locked in)
               (reset! close-handler
                       (fn [] (settle {"answers" @answers
                                       "outcome" "cancelled"
                                       "notice" "input closed before the questions were answered"})))
               (.on rl "close" @close-handler)
               (ask-at 0)))))
        ask-before-tool (fn [{:keys [name arguments]}]
                          (let [arguments (if (map? arguments) arguments
                                            (try (h/json-parse (str arguments)) (catch :default _ {})))]
                            (if (and (= name "computer_use")
                                   (not (contains? #{"capture" "list_apps" "list_windows" "wait"}
                                                   (get arguments "action"))))
                            (js/Promise.
                             (fn [resolve]
                               (.question rl (str "Approve computer_use " (get arguments "action") "? [y/N] ")
                                  (fn [answer] (resolve (= "y" (str/lower-case (str/trim answer))))))))
                            true)))]
    (println (str "itonami-agent · profile " (:name prof) " · /exit to quit"))
    (letfn [(run-notices [notices]
              ;; one turn per group_process_notifications group, as the CLI's
              ;; pending input queue does (`_pending_input.put` per group)
              (if (seq notices)
                (-> ((executor opts) prof (first notices)
                     ;; clarify is wired for the whole CLI session (Hermes
                     ;; wires clarify_callback once per agent session): every
                     ;; turn the user is present for may ask — not just the
                     ;; prompt turn
                     (assoc (run-opts opts prof) :clarify-fn clarify-ask))
                    (p/then (fn [r]
                              (when (:final r) (println (:final r)))
                              (run-notices (rest notices)))))
                (p/resolved nil)))
            (ask []
              (let [pending (agent-loop/delegate-pending-results!)
                    notices (proc/pending-notification-messages {:session-key ""})]
                (cond
                  (seq pending)
                  ;; background results re-enter as a message between turns
                  ;; (one message per call): acknowledge, then end the turn
                  (-> ((executor opts) prof
                       (str "## Delegated task results (arrived between your turns)\n"
                            (str/join "\n" (for [r pending]
                                             (str "- " (get r "goal") " [" (get r "status") "]: "
                                                  (or (get r "summary") (get r "error")))))
                            "\n\nAcknowledge these results in one line, then end your turn.")
                       (assoc (run-opts (assoc opts :join-children? false) prof)
                              :clarify-fn clarify-ask))
                      (p/then (fn [r]
                                (when (:final r) (println (:final r)))
                                (ask))))

                  ;; pushed background-process notices (Hermes' completion
                  ;; queue) enter as their own turns, as the CLI's pending
                  ;; input does
                  (seq notices)
                  (-> (run-notices notices)
                      (p/then (fn [_] (ask))))

                  :else
                  (.question rl "> "
                         (fn [line]
                           (if (or (nil? line) (#{"/exit" "/quit"} (str/trim line)))
                             (.close rl)
                             (let [prompt (if @history
                                            (str "Conversation so far:\n" @history "\n\nUser: " line)
                                            line)]
                               (-> ((executor opts) prof prompt
                                    (assoc (run-opts opts prof)
                                           :before-tool ask-before-tool
                                           :clarify-fn clarify-ask))
                                   (p/then (fn [r]
                                             (println (or (:final r) (str "[" (:exit-reason r) "] " (get-in r [:error :error]))))
                                             (swap! history #(str % "\nUser: " line "\nAssistant: " (:final r)))
                                             (ask)))))))))))]
      (ask))))

;; ---------------------------------------------------------------- cron

(defn- print-job [j]
  (println (str "  " (get j "id") " [" (if (cron/active? j) "active" (or (get j "state") "paused")) "]"))
  (doseq [[k v] [["Name" (get j "name")]
                 ["Schedule" (or (get j "schedule_display") (get-in j ["schedule" "display"]))]
                 ["Repeat" (let [{:strs [times completed]} (get j "repeat")] (if times (str completed "/" times) "∞"))]
                 ["Next run" (get j "next_run_at")]
                 ["Deliver" (get j "deliver")]
                 ["Script" (get j "script")]
                 ["Workdir" (get j "workdir")]
                 ["Last run" (when (get j "last_run_at") (str (get j "last_run_at") "  " (get j "last_status")))]]
          :when v]
    (println (str "    " (.padEnd (str k ":") 11) v)))
  (println))

(defn cron-cmd [opts [sub & args]]
  (let [prof (profile/load-profile (:profile opts))
        home (:home prof)]
    (case sub
      ("list" nil)
      (do (println (str "Scheduled jobs · profile " (:name prof) " · scheduler " (name (cron/scheduler-of prof))))
          (println)
          (doseq [j (cron/read-jobs home) :when (or (:all opts) (cron/active? j))] (print-job j)))

      ("create" "add")
      (let [[schedule prompt] args
            no-agent (boolean (:no-agent opts))
            _ (when (or (str/blank? (str schedule))
                        (and no-agent (str/blank? (str (:script opts))))
                        (and (not no-agent) (str/blank? (str prompt))))
                (die 2 "create requires a schedule and either a prompt or --no-agent with --script"))
            j (cron/new-job {:schedule schedule :prompt prompt :name (:name opts) :script (:script opts)
                             :monitor-script (:monitor-script opts) :monitor-url (:monitor-url opts)
                             :no-agent no-agent
                             :deliver (:deliver opts) :model (:model opts) :provider (:provider opts)
                             :toolsets (:toolsets opts) :workdir (:workdir opts)})]
        (cron/write-jobs! home (conj (cron/read-jobs home) j))
        (print-job j))

      "run"
      (do
        (when (pause/active?)
          (die 2 (str "paused: cron dispatch is stopped (" (pause/since) ") — lift with: itonami-agent resume")))
        (let [j (or (cron/find-job home (first args)) (die 2 (str "no such job: " (first args))))]
        (p/let [r (cron/run-job prof j {:executor (executor opts) :manual? true})]
          (println (str "  Ran now: " (if (= "error" (:status r)) "failed." "succeeded.")))
          (println (str "  Output: " (:output-file r)))
          (when (= "error" (:status r)) (js/process.exit 1)))))

      "tick"
      (if (pause/active?)
        (println (str "tick skipped: paused (" (pause/since) ") — lift with: itonami-agent resume"))
        (p/let [r (cron/tick prof {:force? (:force opts) :executor (executor opts)})]
        (if (:skipped r)
          (println (str "tick skipped: " (:skipped r)))
          (doseq [x r] (println (str (:job x) "  " (:status x) "  " (:output-file x)))))
        (when (and (sequential? r) (some #(= "error" (:status %)) r)) (js/process.exit 1))))

      ("runs" "history")
      (let [f (h/join home "cron" "itonami-runs.jsonl")
            details (if (h/file? f) (map h/json-parse (remove str/blank? (str/split-lines (h/slurp f)))) [])
            details-by-id (into {} (keep (fn [r] (when-let [id (get r "execution_id")] [id r])) details))
            rows (execution-ledger/rows home nil)]
        (doseq [r (take-last (js/parseInt (or (:limit opts) "20") 10) rows)
                :let [detail (details-by-id (get r "id"))]]
          (println (str (.padEnd (str (get r "status")) 9) "  job=" (get r "job_id") "  " (get r "claimed_at")
                        "  id=" (get r "id") "  source=" (get r "source")
                        (when (get r "delivery_outcome") (str "  delivery=" (get r "delivery_outcome")))
                        (when detail (str "  " (get detail "provider") "/" (get detail "model")))
                        (when (and detail (get detail "peer") (str "  peer=" (get detail "peer"))))))))

      "incidents"
      (let [[action incident-id] args]
        (if (= action "ack")
          (if (execution-ledger/ack-incident! home incident-id)
            (println (str "closed incident " incident-id))
            (die 2 (str "no such incident: " incident-id)))
          (doseq [r (execution-ledger/incidents home)]
            (println (str (.padEnd (str (get r "state")) 9)
                          " job=" (get r "job_id")
                          " type=" (get r "failure_type")
                          " id=" (get r "id")
                          " last=" (get r "last_seen_at"))))))

      "notepad"
      (let [[job-id verb key value] args]
        (when-not (and job-id (#{"set" "get" "delete" "list"} verb))
          (die 2 (str "usage: itonami-agent cron notepad <job-id> set <key> <value>"
                      " | get <key> | delete <key> | list")))
        (case verb
          "set" (do (when (nil? value)
                      (die 2 "usage: itonami-agent cron notepad <job-id> set <key> <value>"))
                    (let [r (notepad/set-note home job-id key value)]
                      (println (str (get r "key") " = " (get r "value")))))
          "get" (if-let [v (notepad/get-note home job-id key)]
                  (println v)
                  (println (str key " is not set")))
          "delete" (println (if (notepad/delete-note home job-id key)
                              "deleted"
                              (str "no such key: " key)))
          "list" (doseq [n (notepad/list-notes home job-id)]
                   (println (str (get n "key") " = " (get n "value"))))))

      "status"
      (let [hb (h/join home "cron" "ticker_heartbeat")]
        (println (str "scheduler: " (name (cron/scheduler-of prof))))
        (println (str "last itonami tick: " (if (h/file? hb) (h/iso-local (js/Date. (* 1000 (js/parseFloat (h/slurp hb))))) "never"))))

      (die 2 (str "unknown cron command: " sub)))))

(defn vault-cmd
  "The vault write path (Hermes `hermes vault add`): the browser_vault tools
  never carry secrets, so logins are added here. The password is read from
  stdin; run this in a private terminal."
  [opts [sub & args]]
  (let [home (profile/home (:profile opts))]
    (case sub
      ("list" nil)
      (if-let [entries (seq (sort-by key (vault/load-logins home)))]
        (doseq [[handle r] entries]
          (println (str (.padEnd handle 14) (.padEnd (str (get r "username")) 20)
                        (str (get r "origin")) "  " (get r "label"))))
        (println "no saved logins"))

      "add"
      (let [[label username origin totp-seed] args]
        (when-not (and label username)
          (die 2 "usage: itonami-agent vault add <label> <username> [origin] [totp-seed]   (the password is read from stdin)"))
        (let [pw (str/trim (str (.readFileSync (js/require "node:fs") 0 "utf8")))
              handle (vault/add-login! home {:label label :username username :password pw
                                             :origin (or origin "") :totp-seed (or totp-seed "")})]
          (println (str "stored " handle))))

      "remove"
      (let [[handle] args]
        (when-not handle (die 2 "usage: itonami-agent vault remove <handle>"))
        (println (if (vault/remove-login! home handle) "removed" (str "no such handle: " handle))))

      (die 2 "usage: itonami-agent vault add|list|remove"))))

(defn mcp-cmd
  "MCP server operations. `login` is the interactive OAuth login (PKCE over a
  loopback redirect, or --device for the RFC 8628 device grant); the token
  cache lands in the profile's mcp-tokens store, issuer-bound."
  [opts [sub & args]]
  (let [prof (profile/load-profile (:profile opts) {:secrets? false})
        home (:home prof)
        server (first args)
        spec (get-in (:config prof) ["mcp_servers" (str server)])]
    (case sub
      "login"
      (do (when-not (and server spec)
            (die 2 "usage: itonami-agent mcp login <server> [--device]   (the server must be in config.yaml mcp_servers)"))
          (-> (p/let [rec (if (:device opts)
                            (oauth/device-login! home server (get spec "url") {})
                            (oauth/login! home server (get spec "url") {}))]
                (println (str "logged in: " server "  issuer-bound until " (get rec "expires_at"))))
              (p/catch (fn [e] (die 1 (str "mcp login failed: " (.-message e)))))))

      (die 2 "usage: itonami-agent mcp login <server> [--device]"))))

(defn dapps-cmd
  "The `itonami_dapps` toolset's MCP servers and how each resolves on this
  host (one JSON object per line). Reads only; starts nothing and changes no
  profile."
  [_opts _args]
  (doseq [row (dapps/status (h/process-env))]
    (println (h/json-str row))))

;; ---------------------------------------------------------------- profile

(defn- set-hermes-parked!
  "Tell Hermes' gateway to skip (parked) or serve a profile. Hermes reads the
  marker file <home>/gateway.parked (hermes_cli/profiles.py
  profile_is_parked) — the same marker `hermes -p X gateway stop` writes."
  [home parked?]
  (let [f (h/join home "gateway.parked")]
    (if parked?
      (h/spit f (str "parked by itonami-agent profile adopt at " (h/iso-local) "\n"))
      (h/rm f))))

(defn- active-cron-job? [job]
  (and (get job "enabled" true)
       (not (contains? #{"paused" "completed" "disabled"} (get job "state" "scheduled")))))

(defn- browser-cdp-configured? [prof]
  (let [dotenv (profile/parse-dotenv
                (let [path (h/join (:home prof) ".env")]
                  (when (h/file? path) (h/slurp path))))
        secret-command (get-in prof [:config "secrets" "command"])
        secret-command-may-export-cdp? (and (map? secret-command)
                                            (true? (get secret-command "enabled"))
                                            (not (str/blank? (get secret-command "command"))))]
    (boolean (or secret-command-may-export-cdp?
                 (some (complement str/blank?)
                       [(get-in prof [:config "browser" "cdp_url"])
                        (get-in prof [:config "browser" "cdp_endpoint"])
                        (get (:env prof) "BROWSER_CDP_URL")
                        (get dotenv "BROWSER_CDP_URL")
                        (h/env "BROWSER_CDP_URL")])))))

(defn- kotoba-job-issues [prof job]
  "Read-only compatibility gate for a single active Hermes cron job."
  (let [config (:config prof)
        requested (cron/tool-sets-for config job)
        disabled (tools/execution-disabled-toolsets config "cron")
        servers (get config "mcp_servers" {})
        selected-mcp (if (true? (get job "no_agent")) [] (mcp/names-for config requested disabled))
        oauth-unready (filter #(and (get-in servers [% "url"])
                                    (= "oauth" (get-in servers [% "auth"]))
                                    (not (mcp/oauth-cache-ready? (:home prof) % (get servers % {}))))
                              selected-mcp)
        bad-sets (if (true? (get job "no_agent")) []
                   (tools/unsupported-toolsets requested (conj (set (keys servers)) dapps/toolset)))
        browser-cdp (browser-cdp-configured? prof)
        bad-tools (if (true? (get job "no_agent")) []
                    (tools/unsupported-tools (tools/runtime-tool-names requested disabled browser-cdp
                                                                          (browser/cli-available?)
                                                                          (computer-use/cli-available? (:env prof)))))
        enabled-tools (tools/runtime-tool-names requested disabled browser-cdp
                                               (browser/cli-available?)
                                               (computer-use/cli-available? (:env prof)))
        browser-selected? (some (set tools/browser-tools) enabled-tools)
        browser-config (get config "browser" {})
        browser-backend (or (get browser-config "backend") "local")
        browser-provider (get browser-config "cloud_provider")
        browser-engine (get browser-config "engine")
        lane (or (get job "deliver") "local")]
    (concat
     (when (and (not (true? (get job "no_agent"))) (seq bad-sets))
       [{:code :unsupported_toolset :detail (str/join ", " bad-sets)}])
     (when (and (not (true? (get job "no_agent"))) (seq bad-tools))
       [{:code :unsupported_tools :detail (str/join ", " bad-tools)}])
     (when (and browser-selected?
                (or (not= browser-backend "local") browser-provider browser-cdp
                    (and browser-engine (not (contains? #{"auto" "chrome"} browser-engine)))))
       [{:code :unsupported_browser_backend :detail "Kotoba browser supports local Chrome only"}])
     (when (seq oauth-unready)
       [{:code :oauth_cache_unavailable :detail (str/join ", " oauth-unready)}])
     (when (not= "local" (str/lower-case (str lane)))
       [{:code :delivery_adapter :detail (str lane)}]))))

(defn- profile-readiness-issues [prof]
  (vec (mapcat (fn [job]
                 (when (and (map? job) (active-cron-job? job))
                   (map #(assoc % :job (get job "id" "(unknown)"))
                        (concat (kotoba-job-issues prof job)
                                (cron/script-runtime-issues prof job)))))
               (get-in prof [:jobs "jobs"] []))))

(defn- issue-summary [issues]
  (->> issues
       (group-by :code)
       (map (fn [[code rows]]
              (let [details (->> rows (keep :detail) (mapcat #(str/split % #",\s*")) distinct sort)
                    summary (str (name code) "=" (count rows))]
                (if (seq details) (str summary "[" (str/join "," details) "]") summary))))
       sort
       (str/join ", ")))

(defn- hy-script-target [home rel]
  (when (and (string? rel) (str/ends-with? rel ".py"))
    (let [scripts (h/join home "scripts")
          target (str (subs rel 0 (- (count rel) 3)) ".hy")
          source (h/join scripts rel)
          abs (h/join scripts target)
          source-contained? (try
                              (let [root (h/realpath scripts)
                                    resolved (h/realpath source)
                                    separator (if (= "win32" (.-platform js/process)) "\\" "/")]
                                (str/starts-with? resolved (str root separator)))
                              (catch :default _ false))]
      (when (and (cron/script-path-safe? scripts target)
                 source-contained?
                 (h/file? source)
                 (h/file? abs))
        target))))

(defn- rewrite-job-hy-refs [home jobs]
  (let [counts (atom {"script" 0 "monitor_script" 0})
        updated
        (mapv (fn [job]
                (if-not (map? job) job
                  (reduce (fn [j field]
                            (if-let [target (hy-script-target home (get j field))]
                              (do (swap! counts update field inc)
                                  (assoc j field target))
                              j))
                          job ["script" "monitor_script"])))
              jobs)]
    {:jobs updated :counts @counts}))

(defn- stage-profile-hy! [name artifact-root records dry-run?]
  (let [home (profile/home name)
        scripts (h/join home "scripts")
        payload-scripts (h/join artifact-root name "scripts")
        selected (filter #(= name (get % "profile")) records)
        plan
        (mapv (fn [{:strs [source target source_sha256 target_sha256]}]
                (let [target-rel (some-> target (str/replace-first #"^scripts/" ""))
                      source-path (h/join home source)
                      payload-path (h/join artifact-root name target)
                      target-path (h/join home target)
                      scripts-real (try (h/realpath scripts) (catch :default _ nil))
                      source-real (try (h/realpath source-path) (catch :default _ nil))
                      source-safe? (and scripts-real source-real
                                        (str/starts-with? source-real (str scripts-real "/")))]
                  (when-not (and (string? source) (string? target)
                                 (str/starts-with? source "scripts/")
                                 (str/starts-with? target "scripts/")
                                 (str/ends-with? source ".py")
                                 (= target (str (subs source 0 (- (count source) 3)) ".hy"))
                                 (re-matches #"^[0-9a-f]{64}$" (str source_sha256))
                                 (re-matches #"^[0-9a-f]{64}$" (str target_sha256))
                                 (cron/script-path-safe? scripts target-rel)
                                 (cron/script-path-safe? payload-scripts target-rel)
                                 (h/file? source-path) source-safe?
                                 (h/file? payload-path) (not (h/symlink? payload-path)))
                    (throw (ex-info (str "invalid or missing Hy migration payload for " name ": " target) {})))
                  (let [source-hash (h/sha256-hex (h/slurp-bytes source-path))
                        target-hash (h/sha256-hex (h/slurp-bytes payload-path))
                        existing-hash (when (h/file? target-path) (h/sha256-hex (h/slurp-bytes target-path)))]
                    (when-not (= source_sha256 source-hash)
                      (throw (ex-info (str "Python source drift for " name ": " source) {})))
                    (when-not (= target_sha256 target-hash)
                      (throw (ex-info (str "Hy payload hash mismatch for " name ": " target) {})))
                    (when (and existing-hash (not= existing-hash target_sha256))
                      (throw (ex-info (str "refusing to replace different Hy source for " name ": " target) {})))
                    {:target target-path :content (h/slurp payload-path) :existing? (some? existing-hash)})))
              selected)
        missing (remove :existing? plan)
        _ (when (and (seq plan) (not (h/dir? scripts)))
            (throw (ex-info (str "profile scripts directory is missing: " name) {})))]
    (when-not dry-run?
      (doseq [{:keys [target content]} missing]
        (h/spit-atomic target content))
      (when (and (seq missing) (:itonami (profile/load-profile name {:secrets? false})))
        (profile/refresh-bundle-cid home)))
    {:files (count plan) :staged (count missing) :existing (- (count plan) (count missing))}))

(defn profile-cmd [opts [sub & args]]
  (case sub
    ("list" nil)
    (do (println (str (.padEnd "Profile" 34) (.padEnd "Model" 34) (.padEnd "itonami" 9) "Scheduler"))
        (doseq [n (cons "default" (profile/names))
                :let [home (profile/home n)
                      cfg (try (profile/read-yaml-file (h/join home "config.yaml")) (catch :default _ {}))
                      m (try (profile/read-edn-file (h/join home "itonami.edn")) (catch :default _ nil))]]
          (println (str (.padEnd n 34) (.padEnd (str (get-in cfg ["model" "default"])) 34)
                        (.padEnd (if m "yes" "-") 9) (if m (name (get-in m [:runtime :scheduler] :hermes)) "hermes")))))

    "show"
    (let [prof (profile/load-profile (first args) {:secrets? false})]
      (println (str "profile: " (:name prof) "\nhome: " (:home prof) "\ndescription: " (profile/description prof)
                    "\nmodel: " (get-in prof [:config "model" "provider"]) "/" (get-in prof [:config "model" "default"])
                    "\njobs: " (count (get-in prof [:jobs "jobs"]))
                    "\nitonami: " (if (:itonami prof) (pr-str (select-keys (:itonami prof) [:runtime :placement :bundle])) "no"))))

    "readiness"
    (let [targets (if (:all opts) (profile/names) [(first args)])
          blocked (atom 0)
          issues-count (atom 0)]
      (doseq [n targets]
        (try
          (let [prof (profile/load-profile n {:secrets? false})
                issues (profile-readiness-issues prof)]
            (if (seq issues)
              (do (swap! blocked inc)
                  (swap! issues-count + (count issues))
                  (println (str "blocked " n "  " (issue-summary issues))))
              (println (str "ready   " n))))
          (catch :default e
            (swap! blocked inc)
            (swap! issues-count inc)
            (println (str "error   " n "  " (.-message e))))))
      (println (str @blocked " profile(s) blocked; " @issues-count " compatibility issue(s)")))

    ("import" "export")
    (let [out? (= "export" sub)
          src-root (h/expand (if out? (profile/itonami-root) (or (:from opts) (profile/hermes-root))))
          dst-root (h/expand (if out? (or (:to opts) (profile/hermes-root)) (profile/itonami-root)))
          targets (if (:all opts) (profile/names-in src-root) [(first args)])
          _ (when-not (first targets)
              (die 2 (str "usage: itonami-agent profile " sub " <p>|--all"
                          (if out? " [--to DIR]" " [--from DIR]") " [--force] [--dry-run]")))
          n (atom 0)]
      (doseq [t targets]
        (try
          (let [from (profile/home-in src-root t)
                to (profile/home-in dst-root t)]
            (if (:dry-run opts)
              (println (str "would  " sub " " t "  " from " -> " to))
              (let [r (profile/copy-profile! from to {:force? (:force opts)})
                    scheduled (get-in (try (profile/read-edn-file (h/join from "itonami.edn"))
                                           (catch :default _ nil))
                                      [:runtime :scheduler])]
                ;; an exported copy whose cron is itonami's must not also be
                ;; ticked by the Hermes gateway: leave it parked, as
                ;; `hermes -p X gateway stop` would
                (when (and out? (= :itonami scheduled))
                  (set-hermes-parked! to true))
                (swap! n inc)
                (println (str "copied  " t "  " (count (:copied r)) " file(s)  " from " -> " to)))))
          (catch :default e (println (str "skip    " t "  " (.-message e))))))
      (println (str @n " profile(s) " (if (:dry-run opts) "would be " "") "copied")))

    "itonamify"
    (let [targets (if (:all opts) (profile/names) [(first args)])
          n (atom 0)]
      (doseq [t targets]
        (try
          (let [prof (profile/load-profile t {:secrets? false})]
            (if (and (:itonami prof) (not (:refresh opts)))
              (println (str "keep    " t "  " (get-in prof [:itonami :bundle :cid])))
              (let [m (merge (profile/default-manifest prof)
                             ;; what the owner declared survives a refresh: scheduler,
                             ;; placement, rails, terminal/web policy, organisation
                             (select-keys (:itonami prof) (into [:runtime :placement :inference :terminal :web]
                                                                manifest/org-keys)))]
                (when-not (:dry-run opts) (profile/write-manifest! (:home prof) m))
                (swap! n inc)
                (println (str (if (:dry-run opts) "would  " "wrote   ") t "  " (get-in m [:bundle :cid]))))))
          (catch :default e (println (str "skip    " t "  " (.-message e))))))
      (println (str @n " profile(s) " (if (:dry-run opts) "would be " "") "itonamified")))

    "rail"
    (let [rail (some-> (:to opts) keyword)
          targets (if (:all opts) (profile/names) [(first args)])
          n (atom 0)]
      (when-not (and (#{:murakumo :kotoba :itonami-p2p} rail) (first targets))
        (die 2 "usage: itonami-agent profile rail <p>|--all --to murakumo|kotoba|itonami-p2p [--dry-run]"))
      (doseq [t targets]
        (let [home (profile/home t)
              m (try (profile/read-edn-file (h/join home "itonami.edn")) (catch :default _ nil))
              m' (some-> m (profile/with-inference-rail rail))]
          (cond
            (nil? m) (println (str "skip    " t "  no itonami.edn"))
            (= m m') (println (str "keep    " t))
            :else (do (when-not (:dry-run opts) (profile/write-manifest! home m'))
                      (swap! n inc)
                      (println (str (if (:dry-run opts) "would  " "wrote   ") t "  "
                                    (some-> (get-in m [:placement :inference-rail]) name) " -> " (name rail)))))))
      (println (str @n " profile(s) " (if (:dry-run opts) "would be " "") "pointed at " (name rail))))

    "check"
    (let [targets (if (:all opts) (profile/names) [(first args)])
          _ (when-not (first targets) (die 2 "usage: itonami-agent profile check <p>|--all [--summary]"))
          rs (mapv #(try (profile/check (profile/load-profile % {:secrets? false}))
                         (catch :default e {:profile % :problems [{:level :error :path [] :message (.-message e)}] :drift []}))
                   targets)
          level-count (fn [lvl] (count (filter (fn [r] (some #(= lvl (:level %)) (:problems r))) rs)))
          drift (frequencies (mapcat (fn [r] (map #(if (= :soul-block (:drift %)) [:soul-block (:missing %)] (:drift %)) (:drift r))) rs))]
      (when-not (:summary opts)
        (doseq [{:keys [profile problems drift]} rs]
          (doseq [{:keys [level path message]} problems]
            (println (str (.padEnd (name level) 7) profile "  " (pr-str path) " " message)))
          (doseq [d drift]
            (println (str "drift  " profile "  " (pr-str (dissoc d :drift)) " " (name (:drift d)))))))
      (println (str (count rs) " profile(s): " (level-count :error) " with errors, " (level-count :warn) " with warnings"
                    (when (seq drift) (str "; drift " (pr-str drift)))))
      (when (pos? (level-count :error)) (set! (.-exitCode js/process) 1)))

    "refresh"
    (let [targets (if (:all opts) (profile/names) [(first args)])
          n (atom 0)]
      (when-not (first targets) (die 2 "usage: itonami-agent profile refresh <p>|--all [--dry-run]"))
      (doseq [t targets]
        (let [home (profile/home t)
              m (try (profile/read-edn-file (h/join home "itonami.edn")) (catch :default _ nil))
              m' (some->> m (profile/with-bundle home))]
          (cond
            (nil? m) (println (str "skip    " t "  no itonami.edn"))
            (= m m') (println (str "keep    " t))
            :else (do (when-not (:dry-run opts) (profile/write-manifest! home m'))
                      (swap! n inc)
                      (println (str (if (:dry-run opts) "would  " "wrote   ") t "  "
                                    (get-in m [:bundle :cid]) " -> " (get-in m' [:bundle :cid])))))))
      (println (str @n " bundle CID(s) " (if (:dry-run opts) "would be " "") "refreshed")))

    "did"
    (let [seed (identity/seed-from-env)
          reg (try (some-> (:registry opts) profile/read-edn-file) (catch :default _ nil))
          by-id (into {} (map (juxt :agent/id identity)) (:agents reg))
          targets (cond (not (:all opts)) [(first args)]
                        (seq by-id) (sort (keys by-id))
                        :else (profile/names))]
      (when-not seed
        (die 2 (str "REFUSED: " identity/seed-env " is not set (64 hex characters). Fill it from the kagi item "
                    "shared/agent-identity-seed in a human session, for this one command; it is never printed.")))
      (when-not (first targets)
        (die 2 "usage: itonami-agent profile did <p>|--all [--registry <agent-registry.edn>] [--out <file>]"))
      (let [out (into (sorted-map)
                      (for [t targets :let [epoch (or (:did/epoch (get by-id t)) 0)]]
                        [t {:did (identity/did-of seed t epoch) :epoch epoch}]))]
        (if (:out opts)
          (h/spit (:out opts) (str ";; per-profile did:key (ADR-2610141512 D7). Public keys only.\n" (pr-str out) "\n"))
          (doseq [[t {:keys [did epoch]}] out] (println (str t "  " did "  epoch " epoch))))
        (println (str (count out) " DID(s)" (when (:out opts) (str " written to " (:out opts)))))))

    "soul"
    (let [reg (try (some-> (:registry opts) profile/read-edn-file) (catch :default _ nil))
          worlds (try (some-> (:worlds opts) profile/read-edn-file) (catch :default _ nil))
          by-id (into {} (map (juxt :agent/id identity)) (:agents reg))
          targets (if (:all opts) (profile/names) [(first args)])
          stamp (str/replace (subs (h/iso-local) 0 19) #"[^0-9T]" "")
          backup-dir (h/join (profile/itonami-root) "state" "soul-blocks" stamp)
          written (atom [])
          refused (atom 0)]
      (when-not (and (seq by-id) (map? (:worlds worlds)) (first targets))
        (die 2 "usage: itonami-agent profile soul <p>|--all --registry <agent-registry.edn> --worlds <worlds.edn> [--unit U] [--dry-run]"))
      (doseq [t targets
              :let [e (get by-id t)]
              :when (or (nil? (:unit opts)) (= (str (:unit opts)) (some-> (:org/unit e) name)))]
        (let [home (profile/home t)
              path (h/join home "SOUL.md")
              text (when (h/file? path) (h/slurp path))
              m (try (profile/read-edn-file (h/join home "itonami.edn")) (catch :default _ nil))
              y (try (profile/read-edn-file (h/join home "yakuwari.edn")) (catch :default _ nil))]
          (cond
            (nil? e) (println (str "skip    " t "  not in the registry"))
            (nil? text) (println (str "skip    " t "  no SOUL.md"))
            :else
            (let [blocks (soul/render e worlds (vec (:yakuwari/capabilities y)) (:authority m))
                  size (soul/generated-size blocks)
                  new (soul/splice text blocks)]
              (cond
                (> size soul/limit)
                (do (swap! refused inc) (println (str "refuse  " t "  generated blocks are " size " chars (limit " soul/limit ")")))
                (not= (soul/strip new) (soul/strip text))
                (do (swap! refused inc) (println (str "refuse  " t "  the body would change")))
                (= new text) (println (str "keep    " t))
                :else
                (do (when-not (:dry-run opts)
                      (h/mkdirs (h/join backup-dir t))
                      (h/spit (h/join backup-dir t "SOUL.md") text)
                      (h/spit-atomic path new))
                    (swap! written conj {:profile t :before (h/sha256-hex text) :after (h/sha256-hex new) :generated-chars size})
                    (println (str (if (:dry-run opts) "would  " "wrote   ") t "  " size " chars"))))))))
      (when (and (seq @written) (not (:dry-run opts)))
        (h/spit (h/join backup-dir "receipt.edn")
                (pr-str {:at (h/iso-local) :registry (:registry opts) :worlds (:worlds opts) :written @written})))
      (println (str (count @written) " SOUL(s) " (if (:dry-run opts) "would be " "") "rewritten, " @refused " refused"
                    (when (and (seq @written) (not (:dry-run opts))) (str "; backups and receipt in " backup-dir))))
      (when (pos? @refused) (set! (.-exitCode js/process) 1)))

    "organize"
    (let [reg (try (some-> (:registry opts) profile/read-edn-file) (catch :default _ nil))
          by-id (into {} (map (juxt :agent/id identity)) (:agents reg))
          targets (if (:all opts) (profile/names) [(first args)])
          n (atom 0)]
      (when-not (and (seq by-id) (first targets))
        (die 2 "usage: itonami-agent profile organize <p>|--all --registry <agent-registry.edn> [--dry-run]"))
      (doseq [t targets]
        (let [home (profile/home t)
              m (try (profile/read-edn-file (h/join home "itonami.edn")) (catch :default _ nil))
              e (get by-id t)
              m' (when (and m e) (manifest/with-org m e {:yakuwari? (h/file? (h/join home "yakuwari.edn"))}))
              bad (some-> m' manifest/errors first)]
          (cond
            (nil? m) (println (str "skip    " t "  no itonami.edn"))
            (nil? e) (println (str "skip    " t "  not in the registry"))
            bad (println (str "refuse  " t "  " (pr-str (:path bad)) " " (:message bad)))
            (= m m') (println (str "keep    " t))
            :else (do (when-not (:dry-run opts) (profile/write-manifest! home m'))
                      (swap! n inc)
                      (println (str (if (:dry-run opts) "would  " "wrote   ") t "  "
                                    (str/join " > " (map name (:org/path m' [:host]))) " (" (some-> (:agent/kind m') name) ")"))))))
      (println (str @n " profile(s) " (if (:dry-run opts) "would be " "") "organized")))

    "bundle"
    (let [prof (profile/load-profile (first args) {:secrets? false})
          files (profile/bundle-files (:home prof) (select-keys (get-in prof [:itonami :bundle]) [:skills :dirs]))]
      (println (profile/bundle-cid files))
      (doseq [[path sha] (profile/bundle-manifest files)] (println (str "  " (subs sha 0 12) "  " path))))

    "refresh-bundle"
    (let [prof (profile/load-profile (first args) {:secrets? false})]
      (when-not (:itonami prof)
        (die 2 (str "profile " (:name prof) " is not itonamified; run profile itonamify first")))
      (let [m (profile/refresh-bundle-cid (:home prof))]
        (println (str "refreshed " (:name prof) " bundle " (get-in m [:bundle :cid])))))

    "hy-stage"
    (let [all? (:all opts)
          artifact-arg (if all? (if (string? all?) all? (first args)) (second args))
          artifact-dir (h/expand artifact-arg)
          manifest-path (h/join artifact-dir "migration.json")
          manifest (when (h/file? manifest-path) (h/json-parse (h/slurp manifest-path)))
          targets (if all? (profile/names) [(first args)])]
      (when-not (= "kotoba-hermes-cron-hy-patch-v2" (get manifest "format"))
        (die 2 (str "invalid Hy migration manifest: " manifest-path)))
      (let [records (get manifest "script_files" [])
            staged-total (atom 0) existing-total (atom 0) skipped (atom 0)]
        (doseq [n targets]
          (try
            (let [{:keys [files staged existing]}
                  (stage-profile-hy! n artifact-dir records (:dry-run opts))]
              (swap! staged-total + staged)
              (swap! existing-total + existing)
              (println (str (if (:dry-run opts) "would  " "staged ") n
                            "  files=" files " new=" staged " present=" existing)))
            (catch :default e
              (swap! skipped inc)
              (println (str "skip    " n "  " (.-message e))))))
        (println (str @staged-total " Hy source file(s) " (if (:dry-run opts) "would be " "")
                      "staged; " @existing-total " already present; " @skipped " profile(s) skipped"))))

    "hy-migrate"
    (let [targets (if (:all opts) (profile/names) [(first args)])
          converted (atom 0)
          skipped (atom 0)]
      (doseq [n targets]
        (try
          (let [prof (profile/load-profile n {:secrets? false})
                home (:home prof)
                scheduler (get-in prof [:itonami :runtime :scheduler])
                parked? (h/file? (h/join home "gateway.parked"))
                {:keys [jobs counts]} (rewrite-job-hy-refs home (cron/read-jobs home))
                runtime-issues (mapcat #(cron/script-runtime-issues prof %)
                                       (filter map? jobs))
                issues (concat (profile-readiness-issues prof) runtime-issues)
                nrefs (+ (get counts "script" 0) (get counts "monitor_script" 0))]
            (cond
              (or (not= :itonami scheduler) (not parked?))
              (do (swap! skipped inc)
                  (println (str "skip    " n "  scheduler is not Kotoba-owned")))
              (seq issues)
              (do (swap! skipped inc)
                  (println (str "blocked " n "  " (issue-summary issues))))
              (zero? nrefs)
              (println (str "keep    " n "  no .py refs with sibling .hy files"))
              (:dry-run opts)
              (do (swap! converted + nrefs)
                  (println (str "would   convert " n "  script=" (get counts "script")
                                " monitor_script=" (get counts "monitor_script"))))
              :else
              (let [tick-lock (h/join home "cron" ".itonami-tick.lock")]
                (if-not (h/acquire-lock! tick-lock)
                  (do (swap! skipped inc)
                      (println (str "skip    " n "  Kotoba tick is in progress")))
                  (try
                    (let [counts* (atom {"script" 0 "monitor_script" 0})]
                      (cron/transform-jobs!
                       home
                       (fn [current]
                         (let [{:keys [jobs counts]} (rewrite-job-hy-refs home current)
                               runtime-issues (mapcat #(cron/script-runtime-issues prof %)
                                                      (filter map? jobs))]
                           (when (seq runtime-issues)
                             (throw (ex-info (str "Hy runtime unavailable: "
                                                  (issue-summary runtime-issues))
                                             {:issues runtime-issues})))
                           (reset! counts* counts)
                           jobs)))
                      (let [counts @counts*
                            nrefs (+ (get counts "script" 0) (get counts "monitor_script" 0))]
                        (if (pos? nrefs)
                          (do
                              ;; cron/jobs.json is part of the profile bundle. Refresh only
                              ;; after the rewritten references have been atomically saved.
                              (profile/refresh-bundle-cid home)
                              (swap! converted + nrefs)
                              (println (str "converted " n "  script=" (get counts "script")
                                            " monitor_script=" (get counts "monitor_script"))))
                          (println (str "keep    " n "  references already converted")))))
                    (finally (h/release-lock! tick-lock)))))))
          (catch :default e
            (swap! skipped inc)
            (println (str "error   " n "  " (.-message e))))))
      (println (str @converted " script ref(s) " (if (:dry-run opts) "would be " "")
                    "converted; " @skipped " profile(s) skipped")))

    "adopt"
    (let [targets (if (or (:all opts) (:ready-only opts)) (profile/names) [(first args)])
          entries (mapv (fn [n]
                          (try
                            (let [prof (profile/load-profile n {:secrets? false})
                                  m (or (:itonami prof) (profile/default-manifest prof))
                                  scheduler (or (get-in m [:runtime :scheduler]) :hermes)]
                              {:name n :profile prof :manifest m
                               :error (when-not (contains? #{:hermes :itonami} scheduler)
                                        (str "scheduler " (name scheduler)
                                             " must be retired before Kotoba adoption"))
                               :already? (and (= :itonami (get-in m [:runtime :scheduler]))
                                              (h/file? (h/join (:home prof) "gateway.parked")))
                               :issues (profile-readiness-issues prof)})
                            (catch :default e {:name n :error (.-message e)})))
                        targets)
          blockers (filter #(or (:error %) (seq (:issues %))) entries)
          changed (atom 0)]
      (if (and (:all opts) (seq blockers))
        (do
          (doseq [{:keys [name error issues]} blockers]
            (println (str (if error "error   " "blocked ") name "  "
                          (or error (issue-summary issues)))))
          (println (str "refused all-profile adoption; " (count blockers)
                        " of " (count entries) " profiles are not Kotoba-ready; no profiles changed")))
        (do
          (doseq [{:keys [name profile manifest already? issues error]} entries]
            (cond
              error (println (str "error   " name "  " error))
              already? (println (str "keep    " name "  already Kotoba-scheduled"))
              (seq issues) (println (str "blocked " name "  " (issue-summary issues)))
              (:dry-run opts) (do (swap! changed inc) (println (str "would   adopt " name)))
              :else (let [home (:home profile)]
                      (profile/write-manifest! home (assoc-in manifest [:runtime :scheduler] :itonami))
                      (set-hermes-parked! home true)
                      (profile/refresh-bundle-cid home)
                      (swap! changed inc)
                      (println (str "adopted " name ": Kotoba ticks cron; Hermes is parked")))))
          (println (str @changed " profile(s) " (if (:dry-run opts) "would be " "") "adopted")))))

    "release"
    (let [targets (if (:all opts) (profile/names) [(first args)])
          changed (atom 0)]
      (doseq [n targets]
        (try
          (let [prof (profile/load-profile n {:secrets? false})
                home (:home prof)
                owned? (or (= :itonami (get-in prof [:itonami :runtime :scheduler]))
                           (h/file? (h/join home "gateway.parked")))]
            (cond
              (not owned?) (println (str "keep    " n "  already Hermes-scheduled"))
              (:dry-run opts) (do (swap! changed inc) (println (str "would   release " n)))
              :else (do
                      (when (:itonami prof)
                        (profile/write-manifest! home (assoc-in (:itonami prof) [:runtime :scheduler] :hermes)))
                      (set-hermes-parked! home false)
                      (swap! changed inc)
                      (println (str "released " n ": Hermes ticks cron again")))))
          (catch :default e (println (str "skip    " n "  " (.-message e))))))
      (println (str @changed " profile(s) " (if (:dry-run opts) "would be " "") "released")))

    (die 2 (str "unknown profile command: " sub))))

;; ---------------------------------------------------------------- gateway

(defn pause-cmd
  "Hermes `hermes pause`: the emergency stop (cron dispatch and new gateway
  turns). An optional reason is recorded with the timestamp."
  [_ args]
  (let [reason (str/trim (str/join " " args))]
    (pause/pause! (when-not (str/blank? reason) reason))
    (println (str "paused — cron dispatch and new gateway turns are stopped"
                  (when-not (str/blank? reason) (str " (" reason ")"))
                  ". lift with: itonami-agent resume"))))

(defn resume-cmd [_ _]
  (println (if (pause/resume!)
             "resumed — emergency stop lifted"
             "nothing to resume (not paused)")))

(defn doctor-cmd
  "Hermes `hermes doctor`: what is configured and what is missing — findings
  named by code, exit 1 when any. Reads only (no secrets): it starts nothing
  and changes no profile."
  [opts _]
  (p/let [loaded (try {:prof (profile/load-profile (or (:profile opts) "default") {:secrets? false})}
                      (catch :default e
                        {:failure (str (or (.-message e) e))}))
          _ (when-let [f (:failure loaded)]
              ;; a profile that will not load (e.g. a malformed jobs.json,
              ;; which load-profile parses) is a NAMED finding, not a raw die
              (println (str "profile-load-failed: " (subs f 0 (min 200 (count f)))))
              (println "1 finding(s)")
              (js/process.exit 1))
          prof (:prof loaded)
          home (:home prof)
          cfg (:config prof)
          readiness (vec (profile-readiness-issues prof))
          ;; no PROFILE-level model resolves (job-level pins are per-job and
          ;; not inspected here): cron.model -> model.default
          model-issue (when (and (str/blank? (str (get-in cfg ["model" "default"])))
                                 (str/blank? (str (get-in cfg ["cron" "model"])))
                                 (str/blank? (str (:model opts))))
                        {:code :no-model
                         :detail "model.default is not set — resolution is unset"})
          token-issues (when (map? (get cfg "delivery"))
                         (for [[lane _c] (get cfg "delivery")
                               :let [envn (platforms/token-env-name lane cfg)]
                               :when (and envn (str/blank? (str (h/env envn))))]
                           {:code :missing-token
                            :detail (str "delivery." lane " needs env " envn " (unset)")}))
          db-issue (when-not (h/file? (h/join home "state.db"))
                     {:code :no-state-db
                      :detail "state.db missing — sessions / session_search will be empty"})
          pause-note (when (pause/active?)
                       {:code :paused :detail (str "emergency stop is set (" (pause/since) ")")})
          findings (vec (concat readiness
                               (keep identity [model-issue db-issue pause-note])
                               token-issues))]
    (if (seq findings)
      (do (doseq [f findings] (println (str (name (:code f)) ": " (:detail f))))
          (println (str (count findings) " finding(s)"))
          (js/process.exit 1))
      (println "ok"))))
(defn sessions-cmd
  "Hermes `hermes sessions` (list/show): this profile's conversations from
  state.db. `resume` lands with history re-entry."
  [opts [sub & args]]
  (let [prof (profile/load-profile (or (:profile opts) "default"))
        db-path (h/join (:home prof) "state.db")
        limit-raw (:limit opts)
        limit (tools/bounded-limit limit-raw 200)
        _ (when (and (not (nil? limit-raw)) (nil? limit))
            (die 2 "sessions: --limit must be a positive integer"))
        limit (or limit 20)]
    (case (str sub)
      ("" "list")
      (let [res (tools/sessions-browse db-path limit)]
        (if-let [e (:error res)]
          (die 1 (str "sessions: " e))
          (let [rows (:rows res)]
            (if (seq rows)
              (doseq [r rows]
                (println (str (.padEnd (str (get r "session_id")) 40)
                              (.padEnd (str (or (get r "started_at") "")) 24)
                              (.padEnd (str (get r "message_count") " msgs") 9)
                              (or (get r "title") ""))))
              (println "no sessions")))))

      "show"
      (let [id (first args)]
        (when-not id (die 2 "sessions show: a session id is required"))
        (let [res (tools/session-latest-messages db-path id (min limit 50))]
          (if-let [e (:error res)]
            (die 1 (str "sessions show: " e))
            (let [rows (:rows res)]
              (if (seq rows)
                (doseq [m rows] (println (str "[" (get m "role") "] " (get m "content"))))
                (die 1 (str "session not found: " id)))))))

      "resume"
      (die 2 "sessions resume: not implemented yet (lands with history re-entry)")

      (die 2 "usage: itonami-agent sessions [list] [--limit N] | show <id> | resume <id>"))))
(defn model-cmd
  "Hermes `hermes model` (show): the effective model/provider resolution with
  the config layer each came from, and the hop chain. The setter lands with
  config writing."
  [opts _]
  (p/let [prof (profile/load-profile (or (:profile opts) "default") {:secrets? false})
          r (provider/resolution (:config prof) {:model (:model opts) :provider (:provider opts)})]
    (println (str "model:     " (get-in r [:model :value]) "   (" (get-in r [:model :source]) ")"))
    (println (str "provider:  " (get-in r [:provider :value]) "   (" (get-in r [:provider :source]) ")"))
    (println (str "chain:"))
    (doseq [[i h] (map-indexed vector (:hops r))]
      (println (str "  " (inc i) ". " (:provider h) "/" (:model h))))))

(defn fallback-cmd
  "Hermes `hermes fallback` (show): the providers tried when the primary model
  fails. A pinned run disables fallback (Hermes: 'job pin disables fallback').
  The setter lands with config writing."
  [opts args]
  (when (seq args) (die 2 "usage: itonami-agent fallback [--profile P] [-m model]"))
  (p/let [prof (profile/load-profile (or (:profile opts) "default") {:secrets? false})
          r (provider/resolution (:config prof) {:model (:model opts) :provider (:provider opts)})]
    (if (seq (drop 1 (:hops r)))
      (doseq [[i h] (map-indexed vector (drop 1 (:hops r)))]
        (println (str "fallback " (inc i) ". " (:provider h) "/" (:model h))))
      (println "no fallback hops in the effective chain"))
    (when (:pinned? r)
      (println "(pinned run — fallback is disabled)"))))

(defn status-cmd
  "Hermes `hermes status`: what this store is running."
  [_ _]
  (let [names (profile/names)
        pid-state (fn [f]
                    (let [p (h/join (p2p/itonami-dir) f)
          pid (try (when (h/file? p) (str/trim (h/slurp p))) (catch :default _ nil))]
                      (if (and pid (h/pid-alive? pid))
                        (str "running (pid " pid ")")
                        "not running")))]
    (println (str "paused: " (if (pause/active?) (pause/since) "no")))
    (println (str "profiles (" (count names) "):"))
    (doseq [n names]
      (let [home (profile/home n)
            sched (get-in (try (profile/read-edn-file (h/join home "itonami.edn"))
                               (catch :default _ nil))
                          [:runtime :scheduler])
            sched (or sched :hermes)
            jobs (try (cron/read-jobs home) (catch :default _ []))]
        (println (str "  " (.padEnd n 32) "scheduler=" (name sched)
                      "  jobs=" (count (filter cron/active? jobs))))))
    (println (str "gateway (cron tick): " (pid-state "gateway.pid")))
    (println (str "gateway serve: " (pid-state "gateway-serve.pid")))
    (println (str "peers: " (try (count (:trusted (p2p/read-peers)))
                                (catch :default _ "?"))
                  " trusted"))))

(defn send-cmd
  "Hermes `hermes send`: push one message to a configured platform chat,
  outside any turn. The reply adapter targets the given chat exactly."
  [opts args]
  (let [platform (str/lower-case (str (or (:platform opts) "telegram")))
        chat-id (or (:chat-id opts) (die 2 "send: --chat-id is required"))
        _ (when (or (boolean? chat-id)
                    (str/blank? (str chat-id))
                    (contains? #{"true" "false"} (str chat-id)))
            (die 2 "send: --chat-id needs a chat id value (e.g. --chat-id -100123)"))
        text (str/trim (str/join " " args))]
    (when (str/blank? text) (die 2 "send: message text is required"))
    (p/let [prof0 (profile/load-profile (or (:profile opts) "default"))
            prepared (chat/prepare-send-profile prof0 platform (str chat-id))
            _ (when-let [e (:error prepared)] (die 2 (str "send: " e)))
            prof (:prof prepared)
            res (chat/send-reply! prof {"platform" platform
                                        "chat_id" (str chat-id)
                                        "thread_id" (str (or (:thread-id opts) ""))}
                                  text)]
      (if (nil? res)
        (println (str "sent to " platform ":" chat-id))
        (die 1 (str "send failed: " res))))))

(defn claim-pid!
  "Single-instance guard (Hermes' pid file + liveness check): claim
  <itonami-dir>/<name> for this process. Refuses when a LIVE process of ours
  still owns it; a dead owner's file is stale and taken over. Returns
  {:pid ...} on claim, {:error ...} on refusal — callers die."
  [dir name]
  (let [p (h/join dir name)
        existing (try (when (h/file? p) (str/trim (h/slurp p))) (catch :default _ nil))
        live? (when (and existing (re-matches #"\d+" existing))
                (try (js/process.kill (js/parseInt existing 10) 0)
                     true
                     (catch :default _ false)))]
    (if live?
      {:error (str name " is already running (pid " existing ")")}
      (do (h/spit p (str (.-pid js/process)))
          {:pid (.-pid js/process)}))))

(defn gateway-run [opts]
  (let [interval (let [sec (js/parseInt (or (:interval opts) "60") 10)]
                   ;; --interval is the tick period in seconds: a floor of 1 s
                   ;; and a sane default, never a 1 ms hot loop
                   (if (js/isFinite sec) (* 1000 (max 1 sec)) 60000))
        paused-noticed (atom false)
        cycle (fn cycle []
                (let [adopted (filter (fn [n] (= :itonami (get-in (try (profile/read-edn-file (h/join (profile/home n) "itonami.edn"))
                                                                         (catch :default _ nil))
                                                                       [:runtime :scheduler])))
                                      (profile/names))]
                  (if (pause/active?)
                    (when-not @paused-noticed
                      (reset! paused-noticed true)
                      (println (str (h/iso-local) " gateway: paused (" (pause/since) ") — dispatch stopped")))
                    (reset! paused-noticed false))
                  ;; each profile ticks independently (its own cron/.itonami-tick.lock),
                  ;; so a long run in one profile never delays another's schedule
                  ;; secrets (keychain helper) are resolved only when a job is due
                  (doseq [n adopted
                          :when (and (not (pause/active?))
                                     (some #(cron/due? % (js/Date.))
                                           (try (cron/read-jobs (profile/home n))
                                                (catch :default _ []))))]
                    (-> (p/let [r (cron/tick (profile/load-profile n) {:executor (executor opts)})]
                          (when (and (sequential? r) (seq r))
                            (println (str (h/iso-local) " " n " " (str/join ", " (map #(str (:job %) "=" (:status %)) r))))))
                        (p/catch (fn [e] (println (str (h/iso-local) " " n " tick failed: " (.-message e)))))))
                  (js/setTimeout cycle interval)))]
    (println (str "itonami-agent gateway: ticking adopted profiles every " (/ interval 1000) "s"))
    (let [claim (claim-pid! (p2p/itonami-dir) "gateway.pid")]
      (when-let [e (:error claim)] (die 2 e)))
    (cycle)))

(defn gateway-serve
  "The gateway's messaging surface (JUN-465): poll the platform, dispatch each
  update through the inbound pipeline (normalize -> guards -> routing -> turn),
  and reply to the chat it came from. One bot token per serve process."
  [opts]
  (let [platform (or (:platform opts) "telegram")]
    (when-not (= "telegram" platform)
      (die 2 (str "gateway serve: platform " platform " not implemented (telegram only)")))
    (let [profiles (into [] (keep (fn [n]
                                    (try (profile/load-profile n)
                                         (catch :default e
                                           (println (str "gateway serve: skipping profile " n ": " (.-message e)))
                                           nil)))
                                  (profile/names)))
          tokens (into #{} (keep chat/telegram-token (map :config profiles)))
          token (first tokens)]
      (when (< 1 (count tokens))
        (die 2 "gateway serve: profiles resolve to more than one telegram token — one bot token per serve process"))
      (when (str/blank? (str token))
        (die 2 "gateway serve: no telegram token configured (delivery.telegram.token_env / TELEGRAM_BOT_TOKEN)"))
      (let [d (chat/make-dispatcher
               {:profiles profiles
                :executor (executor opts)
                :run-opts (fn [prof msg] (assoc (run-opts opts prof) :platform (get msg "platform")))
                :send! (fn [prof msg text] (chat/send-reply! prof msg text))
                :on-event log-event})]
        (println (str "itonami-agent gateway serve: " platform " -> " (count profiles) " profiles"))
        (let [claim (claim-pid! (p2p/itonami-dir) "gateway-serve.pid")]
          (when-let [e (:error claim)] (die 2 e)))
        (chat/serve! {:fetch (fn [url o] (js/fetch url o))
                      :token token
                      :offset-file (h/join (p2p/itonami-dir) "gateway-serve-offset.json")
                      :dispatch (fn [raw]
                                  ;; Hermes pause: no new gateway turns while
                                  ;; the emergency stop is set
                                  (if (pause/active?)
                                    (p/resolved {:status :dropped :reason "paused"})
                                    (d platform raw)))
                      :on-error (fn [e] (println (str (h/iso-local) " gateway serve: " e)))
                      ;; --interval is SECONDS, as on `gateway run`
                      :interval (some-> (:interval opts) (js/parseInt 10) (* 1000))})))))

;; ---------------------------------------------------------------- peer

(defn peer-cmd [opts [sub & args]]
  (case sub
    "id" (println (:did (p2p/node-key)))

    "serve"
    (p/let [{:keys [did port]} (p2p/serve {:port (some-> (:port opts) (js/parseInt 10))
                                           :host (:host opts)
                                           :public-url (:url opts)
                                           :max-runs (some-> (:max-runs opts) (js/parseInt 10))})]
      (println (str "itonami-agent peer " did " listening on :" port " (" p2p/protocol ")")))

    "add" (do (p2p/add-peer! {:url (first args) :did (:did opts) :trust? (:trust opts)})
              (println (str "added " (first args) (when (:trust opts) (str " (trusted " (:did opts) ")")))))

    "trust" (let [m (p2p/read-peers)] (p2p/write-peers! (update m :trusted conj (first args))) (println (str "trusted " (first args))))

    "list"
    (p/let [infos (p2p/discover)
            {:keys [trusted]} (p2p/read-peers)]
      (doseq [i infos]
        (when-not (= (:did i) (:did (p2p/node-key)))
        (println (str (.padEnd (str (:url i)) 32)
                      (if (:error i) (str "unreachable: " (:error i))
                          (str (:did i) (if (contains? trusted (:did i)) "  trusted" "  untrusted")
                               "  load " (get i "load") "/" (get i "max_runs")
                               "  models " (str/join "," (get i "agent_models"))
                               (when (get i "murakumo_did") (str "  murakumo " (get i "murakumo_did"))))))))))

    "run" (oneshot (assoc opts :peer true))

    "rails"
    (case (first args)
      "detect" (p/let [m (rails/detect {:skip-port (or (some-> (:port opts) (js/parseInt 10)) p2p/default-port)})]
                 (if (:dry-run opts) (prn m) (do (rails/write-rails! m) (println (str "wrote " (rails/rails-file)))))
                 (doseq [r (:local m)] (println (str "  " (:name r) "  " (:base-url r) "  agent=" (:agent? r) "  " (str/join "," (:models r))))))
      "add" (let [m (rails/read-rails)
                  r {:name (or (:name opts) (str "manual-" (count (:local m)))) :base-url (second args)
                     :models (str/split (or (:models opts) "auto") #",")
                     :priority (js/parseInt (or (:priority opts) "50") 10) :agent? (not (:small opts))}]
              (rails/write-rails! (update m :local conj r))
              (println (str "added rail " (:name r) " " (:base-url r))))
      (doseq [r (:local (rails/read-rails))]
        (println (str (:name r) "  " (:base-url r) "  p" (:priority r) "  agent=" (:agent? r) "  " (str/join "," (:models r))))))

    "exec" (p2p/exec-from-stdin)

    "authorities"
    (let [hl (provider/read-health)]
      (doseq [a provider/default-authorities
              :let [{:strs [down_until status reason since]} (get hl a)]]
        (println (str (.padEnd a 22)
                      (if (and down_until (> down_until (h/now-ms)))
                        (str "skipped for " (js/Math.ceil (/ (- down_until (h/now-ms)) 60000)) " min  (" status " since " since ": " reason ")")
                        "in use")))))

    (die 2 (str "unknown peer command: " sub))))

;; ---------------------------------------------------------------- main

(defn -main [& argv]
  (let [[opts pos] (parse-args argv)]
    (when (and (:profile opts) (not= "default" (:profile opts)) (not (profile/valid-name? (:profile opts))))
      (die 2 (str "invalid profile name: " (:profile opts))))
    (-> (p/do
          (cond
            (and (:oneshot opts) (not= "peer" (first pos))) (oneshot opts)
            :else
            (case (first pos)
              "bridge" (bridge)
              "chat" (chat opts)
              "vault" (vault-cmd opts (rest pos))
              "mcp" (mcp-cmd opts (rest pos))
              "dapps" (dapps-cmd opts (rest pos))
              "cron" (cron-cmd opts (rest pos))
              "profile" (profile-cmd opts (rest pos))
              "doctor" (doctor-cmd opts (rest pos))
              "sessions" (sessions-cmd opts (rest pos))
              "model" (model-cmd opts (rest pos))
              "fallback" (fallback-cmd opts (rest pos))
              "status" (status-cmd opts (rest pos))
              "pause" (pause-cmd opts (rest pos))
              "resume" (resume-cmd opts (rest pos))
              "send" (send-cmd opts (rest pos))
              "gateway" (case (second pos)
                          "run" (gateway-run opts)
                          "serve" (gateway-serve opts)
                          (die 2 "usage: itonami-agent gateway run | serve [--platform telegram] [--interval seconds]"))
              "peer" (peer-cmd opts (rest pos))
              ("help" "--help" nil) (println (:doc (meta #'itonami.agent.main/-main)) (-> 'itonami.agent.main find-ns meta :doc))
              (die 2 (str "unknown command: " (first pos))))))
        (p/catch (fn [e]
                   (when (h/env "ITONAMI_DEBUG") (binding [*print-fn* *print-err-fn*] (println (.-stack e)) (println (ex-data e))))
                   (die 1 (str "itonami-agent: " (.-message e))))))))
