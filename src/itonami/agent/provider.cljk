(ns itonami.agent.provider
  "OpenAI-compatible chat completions with the Hermes provider chain.

  Resolution follows Hermes (cron/scheduler.py, hermes_cli/runtime_provider_custom.py):
    model    : job pin -> cron.model -> model.default
    provider : job pin -> cron.model_provider -> model.provider
    chain    : [primary] ++ fallback_providers, unless the job pinned a model
  A provider name resolves through config `providers.<name>` first, then the
  built-in rails below. Every hop that fails (transport, non-2xx, an `error`
  body, no choices) moves to the next; the last error is returned by name."
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]))

(def built-in
  {"kotoba"     {"base_url" "https://api.kotoba.cloud/v1"   "key_env" "KOTOBA_API_TOKEN"}
   "murakumo"   {"base_url" "https://api.murakumo.cloud/v1" "key_env" "MURAKUMO_API_TOKEN"}
   "openrouter" {"base_url" "https://openrouter.ai/api/v1"  "key_env" "OPENROUTER_API_KEY"}
   ;; Hermes cron jobs may pin the same relay under this free-tier selector.
   ;; It resolves to the same endpoint; Kotoba profiles' deny-host policy then
   ;; removes the relay and appends the local P2P rail.
   "openrouter-free" {"base_url" "https://openrouter.ai/api/v1" "key_env" "OPENROUTER_API_KEY"}
   "nous"       {"base_url" "https://inference-api.nousresearch.com/v1" "key_env" "NOUS_API_KEY"}
   "openai"     {"base_url" "https://api.openai.com/v1"     "key_env" "OPENAI_API_KEY"}
   ;; this node's own peer server: own rails, then trusted peers' rails
   "itonami-p2p" {"base_url" "http://127.0.0.1:7420/v1"}})

(def default-headers
  {"HTTP-Referer" "https://itonami.cloud"
   "X-Title" "Itonami By KotobaLabs"})

(defn stream-hop?
  "Whether a hop asks for `stream: true` (SSE). Config wins: models.<m>.stream,
  then providers.<p>.stream, so a rail that cannot stream is switched off
  explicitly. Unset, only the murakumo rail streams: its non-streaming reply
  sends no header until the whole generation (reasoning included) is done, and
  Node's fetch drops a connection that has no response header after 300 s
  (UND_ERR_HEADERS_TIMEOUT), whatever request_timeout_seconds says. A stream
  answers at once and keeps the connection alive with comment lines."
  [provider pc mc]
  (let [m (get mc "stream") r (get pc "stream")]
    (cond (some? m) (boolean m)
          (some? r) (boolean r)
          :else (= provider "murakumo"))))

(defn resolve-hop
  "One {provider model base_url key_env} entry -> a callable hop."
  [config {:strs [provider model base_url key_env]}]
  (let [pc (get-in config ["providers" provider])
        bi (if (= provider "itonami-p2p")
             ;; this node's own peer server, wherever it listens
             {"base_url" (str "http://127.0.0.1:" (or (h/env "ITONAMI_PEER_PORT") "7420") "/v1")}
             (get built-in provider))
        base (or base_url (get pc "base_url") (get bi "base_url")
                 (when (= provider (get-in config ["model" "provider"])) (get-in config ["model" "base_url"])))
        mc (get-in pc ["models" model])]
    {:provider provider
     :model model
     :base-url (some-> base (str/replace #"/+$" ""))
     :key-env (or key_env (get pc "key_env") (get pc "api_key_env") (get bi "key_env"))
     :headers (merge default-headers (get pc "extra_headers"))
     :extra-body (get pc "extra_body")
     :timeout-s (or (get mc "timeout_seconds") (get pc "request_timeout_seconds") 900)
     :timeout-explicit? (boolean (or (get mc "timeout_seconds") (get pc "request_timeout_seconds")))
     :stream? (stream-hop? provider pc mc)}))

(defn chain
  "The ordered hops for a run. opts: {:model :provider :pinned?} from a job or
  the CLI (-m / --provider)."
  [config {:keys [model provider pinned?]}]
  (let [m (or model (get-in config ["cron" "model"]) (get-in config ["model" "default"]))
        pv (or provider (get-in config ["cron" "model_provider"]) (get-in config ["model" "provider"]))
        primary (resolve-hop config {"provider" pv "model" m
                                     "base_url" (when (= pv (get-in config ["model" "provider"]))
                                                  (get-in config ["model" "base_url"]))})
        fb (let [f (get config "fallback_providers")
                 legacy (get config "fallback_model")]
             (cond (sequential? f) f (map? legacy) [legacy] :else []))
        fb (for [e fb :when (and (get e "provider") (get e "model"))] (resolve-hop config e))]
    (vec (distinct (if pinned? [primary] (cons primary fb))))))

(defn resolution
  "The effective model resolution for `config` and run `opts`, with the SOURCE
  of each choice — the `model` / `fallback` display side (Hermes `hermes
  model` / `hermes fallback` show). Sources follow `chain` verbatim: run
  override (a job's pin, or the CLI's -m/--provider) -> cron.model ->
  model.default, override -> cron.model_provider -> model.provider. An
  override is a PIN — `:pinned? (boolean (or (:pinned? opts) (:model opts)))`,
  matching run-opts and cron, which both pin on any model override — so the chain keeps only the primary. `:hops` is the chain as provider/model pairs (primary
  first; a pinned run keeps only the primary)."
  [config opts]
  ;; a run override IS a pin — run-opts sets :pinned? (boolean (:model opts))
  ;; and cron sets (boolean (get job "model")); the display must say what the
  ;; run will do, so `fallback -m X` shows no fallbacks
  (let [opts (assoc opts :pinned? (boolean (or (:pinned? opts) (:model opts))))
        m (or (:model opts) (get-in config ["cron" "model"]) (get-in config ["model" "default"]))
        m-src (cond (:model opts) "override (-m / job pin)"
                    (get-in config ["cron" "model"]) "cron.model"
                    (get-in config ["model" "default"]) "model.default"
                    :else "unset")
        pv (or (:provider opts) (get-in config ["cron" "model_provider"]) (get-in config ["model" "provider"]))
        pv-src (cond (:provider opts) "override (--provider / job pin)"
                     (get-in config ["cron" "model_provider"]) "cron.model_provider"
                     (get-in config ["model" "provider"]) "model.provider"
                     :else "unset")]
    {:model {:value m :source m-src}
     :provider {:value pv :source pv-src}
     :pinned? (boolean (:pinned? opts))
     :hops (->> (chain config opts)
                (map (fn [h] {:provider (:provider h) :model (:model h)}))
                distinct
                vec)}))

(def default-deny-hosts
  "Third-party relays an itonami profile does not depend on. A rail must be
  owned by a node (its own server, its mesh, a trusted peer) or be one of the
  operator's few authority servers."
  ["openrouter.ai"])

(def default-authorities
  "The few authority servers the decentralised plane may use while they are
  healthy: each sits behind a circuit breaker shared by the node."
  ["api.kotoba.cloud" "api.murakumo.cloud"])

(def p2p-hop {"provider" "itonami-p2p" "model" "auto"})

(defn authority-host [hop authorities]
  (some #(when (str/includes? (str (:base-url hop)) %) %) authorities))

(defn p2p-rail?
  "Whether an itonami profile opted into the itonami-p2p rail: it names
  :itonami-p2p in :inference :rails or as its :placement :inference-rail.
  A profile whose rails are murakumo only does not get it."
  [manifest]
  (boolean (or (some #{:itonami-p2p} (get-in manifest [:inference :rails]))
               (= :itonami-p2p (get-in manifest [:placement :inference-rail])))))

(defn decentralize
  "For an itonami profile (manifest present): drop relay hops
  (:inference :deny-hosts), mark authority hops (:inference :authorities) so
  `complete` guards them with the breaker, and append the itonami-p2p rail
  when the profile opted into it (`p2p-rail?`). A profile without
  itonami.edn keeps its Hermes chain unchanged."
  ([hops manifest] (decentralize hops manifest nil))
  ([hops manifest config]
   (if-not manifest
     hops
     (let [deny (get-in manifest [:inference :deny-hosts] default-deny-hosts)
           auth (get-in manifest [:inference :authorities] default-authorities)
           kept (vec (remove (fn [hop] (some #(str/includes? (str (:base-url hop)) %) deny)) hops))
           kept (mapv #(if-let [a (authority-host % auth)] (assoc % :authority a) %) kept)
           kept (if (or (not (p2p-rail? manifest)) (some #(= "itonami-p2p" (:provider %)) kept))
                  kept
                  (conj kept (resolve-hop (or config {}) p2p-hop)))]
       kept))))

;; ---------------------------------------------------------------- authority circuit breaker

(defn- health-file [] (h/join (h/expand (or (h/env "ITONAMI_DIR") "~/.itonami")) "authority-health.json"))

(defn read-health []
  (let [f (health-file)] (if (h/file? f) (try (h/json-parse (h/slurp f)) (catch :default _ {})) {})))

(defn- write-health! [m] (h/spit-atomic (health-file) (h/json-str m 2)))

(defn breaker-open? [host]
  (when-let [{:strs [down_until]} (get (read-health) host)]
    (> down_until (h/now-ms))))

(defn cooldown-ms
  "How long an authority is skipped after a failure of this kind."
  [{:keys [status error]}]
  (cond
    (= 402 status) (* 30 60000)                    ; out of credit: not coming back in minutes
    (#{401 403} status) (* 30 60000)               ; credentials refused
    (= 429 status) (* 2 60000)                     ; busy
    :else (* 5 60000)))                            ; 5xx, transport, empty

(defn record-authority! [host err]
  (let [m (read-health)]
    (write-health! (if err
                     (assoc m host {"down_until" (+ (h/now-ms) (cooldown-ms err)) "status" (:status err)
                                    "reason" (subs (str (:error err)) 0 (min 160 (count (str (:error err)))))
                                    "since" (h/iso-local)})
                     (dissoc m host)))))

(defn- fetch-json
  [url {:keys [headers body timeout-s]}]
  (let [ctrl (js/AbortController.)
        t (js/setTimeout #(.abort ctrl) (* 1000 timeout-s))]
    (-> (js/fetch url (clj->js {:method "POST" :headers headers :body body :signal (.-signal ctrl)}))
        (p/then (fn [^js r] (p/let [txt (.text r)] {:status (.-status r) :text txt})))
        (p/finally (fn [] (js/clearTimeout t))))))

;; ---- streaming (SSE) -------------------------------------------------------
;; A stream is folded back into the one-shot response shape
;; {"choices" [{"message" ...}] "model" .. "usage" ..}, so complete-hop below
;; (tool calls, empty/error bodies, retry classification) is the same for both.

(defn sse-acc [] {:seen? false :done? false :content "" :reasoning "" :tools (sorted-map)
                  :finish nil :model nil :usage nil :error nil})

(defn- timings->usage [t]
  (let [pn (get t "prompt_n") cn (get t "predicted_n")]
    (when (or pn cn)
      {"prompt_tokens" (or pn 0) "completion_tokens" (or cn 0) "total_tokens" (+ (or pn 0) (or cn 0))})))

(defn- apply-tool-delta [acc tc]
  (let [i (or (get tc "index") 0)
        f (get tc "function")]
    (update-in acc [:tools i]
               (fn [t]
                 (let [t (or t {:id nil :name "" :args ""})]
                   (cond-> t
                     (get tc "id") (assoc :id (get tc "id"))
                     (string? (get f "name")) (update :name str (get f "name"))
                     (string? (get f "arguments")) (update :args str (get f "arguments"))))))))

(defn sse-apply
  "Fold one parsed stream chunk (string-keyed map) into the accumulator."
  [acc chunk]
  (let [choice (first (get chunk "choices"))
        delta (get choice "delta")
        acc (cond-> acc
              (get chunk "error") (assoc :error (get chunk "error"))
              (get chunk "model") (assoc :model (get chunk "model"))
              (get chunk "usage") (assoc :usage (get chunk "usage"))
              (and (nil? (get chunk "usage")) (get chunk "timings"))
              (assoc :usage (timings->usage (get chunk "timings")))
              choice (assoc :seen? true)
              (get choice "finish_reason") (assoc :finish (get choice "finish_reason"))
              (string? (get delta "content")) (update :content str (get delta "content"))
              (string? (get delta "reasoning_content")) (update :reasoning str (get delta "reasoning_content")))]
    (reduce apply-tool-delta acc (get delta "tool_calls"))))

(defn sse-line
  "Fold one raw SSE line. Comment lines (keep-alives), blank lines, `[DONE]`
  and malformed JSON leave the accumulator alone."
  [acc line]
  (let [line (str/replace (str line) #"\r$" "")]
    (if-not (str/starts-with? line "data:")
      acc
      (let [payload (str/trim (subs line 5))]
        (cond
          (str/blank? payload) acc
          (= payload "[DONE]") (assoc acc :done? true)
          :else
          (let [chunk (try (h/json-parse payload) (catch :default _ nil))]
            (if (map? chunk) (sse-apply acc chunk) acc)))))))

(defn sse-complete?
  "Did the stream end the way a server ends one: a finish_reason, `[DONE]`, or an
  error chunk? A connection that just stops (gateway cut, reset) has none of
  these, and what was read is a fragment, not a reply."
  [{:keys [done? finish error]}]
  (boolean (or done? finish error)))

(defn sse-finish
  "The accumulator as a one-shot chat-completion body."
  [{:keys [seen? content reasoning tools finish model usage error]}]
  (cond
    error {"error" error}
    (not seen?) {"choices" []}
    :else
    {"choices" [{"index" 0
                 "finish_reason" finish
                 "message" (cond-> {"role" "assistant"
                                    "content" (when-not (str/blank? content) content)}
                             (not (str/blank? reasoning)) (assoc "reasoning_content" reasoning)
                             (seq tools) (assoc "tool_calls"
                                                (mapv (fn [[_ {:keys [id name args]}]]
                                                        {"id" id "type" "function"
                                                         "function" {"name" name "arguments" args}})
                                                      tools)))}]
     "model" model
     "usage" usage}))

(defn sse-parse-text
  "A whole SSE body -> one-shot body map (what the network path builds incrementally)."
  [text]
  (sse-finish (reduce sse-line (sse-acc) (str/split (str text) #"\n" -1))))

(defn- read-sse-lines
  "Feed each complete line of a fetch body to (on-line line); resolves when it ends.
  A native-Promise callback loop, not a recursive p/then chain: a long reply is
  thousands of chunks, and a chain that deep overflows the stack when it resolves."
  [^js reader ^js decoder on-line]
  (js/Promise.
   (fn [resolve reject]
     (let [buf (atom "")
           step (fn step []
                  (.then (.read reader)
                         (fn [^js r]
                           (try
                             (if (.-done r)
                               (do (when-not (str/blank? @buf) (on-line @buf))
                                   (resolve nil))
                               (let [s (str @buf (.decode decoder (.-value r) #js {:stream true}))
                                     parts (str/split s #"\n" -1)]
                                 (run! on-line (butlast parts))
                                 (reset! buf (last parts))
                                 (step)))
                             (catch :default e (reject e))))
                         (fn [e] (reject e))))]
       (step)))))

(defn- fetch-sse
  "Like fetch-json, with `stream: true` already in the body. Resolves to the
  same {:status :text}, where :text is the folded one-shot body. A non-2xx reply
  or one that is not text/event-stream (a server that ignored `stream`) is
  returned as plain text, exactly as fetch-json would."
  [url {:keys [headers body timeout-s]}]
  (let [ctrl (js/AbortController.)
        t (js/setTimeout #(.abort ctrl) (* 1000 timeout-s))
        acc (atom (sse-acc))]
    (-> (js/fetch url (clj->js {:method "POST" :headers (assoc headers "Accept" "text/event-stream")
                                :body body :signal (.-signal ctrl)}))
        (p/then (fn [^js r]
                  (if (and (<= 200 (.-status r) 299)
                           (str/includes? (str (.get (.-headers r) "content-type")) "text/event-stream"))
                    (p/let [_ (read-sse-lines (.getReader (.-body r)) (js/TextDecoder.)
                                              (fn [line] (swap! acc sse-line line)))]
                      (if (sse-complete? @acc)
                        {:status (.-status r) :text (h/json-str (sse-finish @acc))}
                        ;; complete-hop reports this as "transport: ...", which
                        ;; the retry chain treats as retryable
                        (throw (js/Error. "stream ended before finish_reason or [DONE]"))))
                    (p/let [txt (.text r)] {:status (.-status r) :text txt}))))
        (p/finally (fn [] (js/clearTimeout t))))))

(defn- hop-error [hop status msg]
  {:provider (:provider hop) :model (:model hop) :status status :error (subs (str msg) 0 (min 400 (count (str msg))))})

(defn complete-hop
  "One hop. Resolves to {:ok resp-map} or {:err {...}}."
  [hop env {:keys [messages tools reasoning-effort max-tokens]}]
  (if-not (:base-url hop)
    (p/resolved {:err (hop-error hop nil "no base_url for provider")})
    (let [key (when (:key-env hop) (get env (:key-env hop)))
          headers (cond-> (merge {"Content-Type" "application/json"} (:headers hop))
                    true (assoc "Authorization" (str "Bearer " (or key "no-key-required"))))
          body (cond-> (merge (:extra-body hop) {"model" (:model hop) "messages" messages})
                 (seq tools) (assoc "tools" tools)
                 reasoning-effort (assoc "reasoning_effort" reasoning-effort)
                 max-tokens (assoc "max_tokens" max-tokens)
                 (:stream? hop) (assoc "stream" true))]
      (-> ((if (:stream? hop) fetch-sse fetch-json) (str (:base-url hop) "/chat/completions")
           {:headers headers :body (h/json-str body) :timeout-s (:timeout-s hop)})
          (p/then (fn [{:keys [status text]}]
                    (let [j (try (h/json-parse text) (catch :default _ nil))
                          choice (first (get j "choices"))
                          msg (get choice "message")]
                      (cond
                        (not (<= 200 status 299)) {:err (hop-error hop status (or (get-in j ["error" "message"]) (get j "error") text))}
                        (get j "error") {:err (hop-error hop status (or (get-in j ["error" "message"]) (get j "error")))}
                        (nil? msg) {:err (hop-error hop status (str "no choices: " (subs text 0 (min 200 (count text)))))}
                        (and (str/blank? (get msg "content")) (empty? (get msg "tool_calls")))
                        {:err (hop-error hop status "empty response")}
                        :else {:ok {:message msg
                                    :finish-reason (get choice "finish_reason")
                                    :usage (get j "usage")
                                    :model (or (get j "model") (:model hop))
                                    :provider (:provider hop)}}))))
          (p/catch (fn [e] {:err (hop-error hop nil (str "transport: " (.-message e)))}))))))

(defn- retryable? [{:keys [status error]}]
  (or (nil? status) (= 429 status) (<= 500 status 599)
      (re-find #"(?i)busy|capacity|timeout|aborted|transport|skipped" (str error))))

(defn- parked? [hop] (boolean (and (:authority hop) (breaker-open? (:authority hop)))))

(defn skip-parked?
  "Skip an authority whose breaker is open only while a hop behind it can
  still carry the turn. On a murakumo-only chain the authority is the last
  rail, so it is tried rather than failing the turn for the whole cooldown."
  [hop more]
  (boolean (and (parked? hop) (some (complement parked?) more))))

(defn cap-to-run-budget
  "Hermes agent/chat_completion_helpers.cap_to_run_budget: cap an implicit
  call timeout at half the run budget still left (>= 60 s floor), so one hung
  call can't outlive the run and the wrap-up notice stays reachable. The cap
  only ever tightens; nil remaining (no run budget) leaves the timeout alone."
  [timeout-s remaining-ms]
  (if (nil? remaining-ms)
    timeout-s
    (min timeout-s (max 60 (/ remaining-ms 2000)))))

(defn cap-hop-timeout
  "Hermes' caller contract (chat_completion_helpers.cap_to_run_budget is
  unconditional; its callers skip it for explicit user settings): cap a hop's
  implicit :timeout-s at half the run budget left; an explicit hop timeout
  (models.<m>.timeout_seconds / providers.<p>.request_timeout_seconds) and a
  run without a budget are left untouched."
  [hop remaining-ms]
  (if (or (nil? remaining-ms) (:timeout-explicit? hop))
    hop
    (update hop :timeout-s cap-to-run-budget remaining-ms)))

(defn- complete-round
  [hops env {:keys [deadline-ms on-hop] :as req} attempts]
  (p/loop [[hop & more] hops attempts attempts]
    (if (nil? hop)
      {:err (or (last attempts) {:error "no provider configured"}) :attempts attempts}
      (if (skip-parked? hop more)
        ;; authority known to be down: skip at no cost, the rails behind it carry the turn
        (p/recur more (conj attempts {:provider (:provider hop) :model (:model hop) :status nil
                                      :error (str "skipped: authority " (:authority hop) " breaker open")}))
      (p/let [;; Hermes cap_to_run_budget: half the run budget left (min 60 s),
              ;; recomputed per hop — never the whole remainder, so one slow
              ;; rail cannot outlive the run or starve the fallbacks behind it
              hop (if deadline-ms
                    (cap-hop-timeout hop (- deadline-ms (h/now-ms)))
                    hop)
              t0 (h/now-ms)
              r (complete-hop hop env req)
              _ (when on-hop (on-hop hop r (- (h/now-ms) t0)))
              _ (when (:authority hop) (record-authority! (:authority hop) (:err r)))]
        (if (:ok r)
          (assoc r :attempts attempts)
          (p/recur more (conj attempts (:err r)))))))))

(defn complete
  "Walk the chain. Resolves to {:ok resp :attempts [...]} or {:err last :attempts [...]}.
  req may carry :deadline-ms (epoch ms): each hop's implicit timeout is capped
  at half the time left (min 60 s) — Hermes agent/chat_completion_helpers.
  cap_to_run_budget, recomputed per hop; an explicit hop timeout wins untouched.
  When every hop of a round failed with a transient error (429 / 5xx /
  transport), wait and walk the chain again — up to :rounds (default 3) and
  only while the deadline leaves room — instead of failing the turn on a
  momentarily saturated fleet. :on-hop (fn [hop result-or-nil ms]) observes
  each hop."
  [hops env {:keys [deadline-ms rounds] :or {rounds 3} :as req}]
  (p/loop [round 1 attempts []]
    (p/let [r (complete-round hops env req attempts)]
      (let [round-errs (take-last (count hops) (:attempts r))
            wait-ms (* 15000 round)]
        (if (and (:err r) (< round rounds)
                 (every? retryable? round-errs)
                 (or (nil? deadline-ms) (> (- deadline-ms (h/now-ms)) (+ wait-ms 120000))))
          (p/let [_ (p/delay wait-ms)] (p/recur (inc round) (:attempts r)))
          r)))))
