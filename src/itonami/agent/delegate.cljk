(ns itonami.agent.delegate
  "delegate_task — the Hermes delegation API (tools/delegate_tool.py), same
  name and same argument shape, on the itonami plane.

  A child is a full agent turn in its own context. Because a bot profile is
  distributed (itonami.edn :placement), a child runs where the parent's turn
  may run: the caller injects :run-child (the placement executor — a trusted
  peer first, this node otherwise) and this namespace only orchestrates.
  One-shot sessions (the -z and cron case) join their children and return the
  results in this call, exactly as Hermes does for a session without a
  later-result consumer.

  Children cannot call delegate_task, memory or cronjob tools (the Hermes
  rule); their summaries are self-reports, not verified facts. action steer
  and stop are accepted in the API but honest about what joined children can
  do: a joined child has no mid-run inbox and no cancel."
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]))

(def max-children 10)

(def children
  "subagent_id -> {goal status started-at}. One-shot children are registered
  while they run and kept afterwards, so action=list stays truthful."
  (atom {}))

(defn- ok [m] (h/json-str m))
(defn- err [msg] (h/json-str {"error" msg}))
(defn- sid [] (str "sub-" (h/random-hex 6)))

(defn- child-prompt [{:strs [goal context images output_schema]}]
  (str/join "\n\n"
            (remove str/blank?
                    [(str "# Goal\n" goal)
                     (when-not (str/blank? (str context)) (str "# Context\n" context))
                     (when (seq images)
                       (str "# Images (max 8; read them yourself if your tools allow)\n"
                            (str/join ", " (take 8 images))))
                     (when output_schema
                       (str "# Output\nYour final answer must be a single JSON object matching "
                            "this JSON Schema — no prose outside the JSON:\n"
                            (h/json-str output_schema)))])))

(defn- validate-schema
  "The parent-side check after a child returns: the final answer must parse
  as a JSON object carrying every required key. {:schema_valid ...} plus
  :schema_errors on failure; the raw text is always kept as the summary."
  [schema final]
  (let [required (vec (get schema "required"))]
    (if (empty? required)
      {:schema_valid true}
      (let [obj (try (h/json-parse (str final)) (catch :default _ nil))]
        (if (and (map? obj) (every? #(contains? obj %) required))
          {:schema_valid true}
          {:schema_valid false
           :schema_errors (if (map? obj)
                            (vec (remove #(contains? obj %) required))
                            ["final answer is not a JSON object"])})))))

(defn- run-one
  "One child: run it, and when an output_schema is given, retry once with the
  validation errors (the bounded correction retry Hermes describes)."
  [run-child i task]
  (let [id (sid)
        goal (str (get task "goal"))
        schema (get task "output_schema")
        _ (swap! children assoc id {:goal goal :status "running" :started-at (h/iso-local)})
        done (fn [r extra]
               (let [base (merge {"subagent_id" id "goal" goal
                                  "status" (if (= "completed" (:exit-reason r)) "completed" "failed")
                                  "exit_reason" (:exit-reason r)
                                  "summary" (str (or (:final r) ""))
                                  "turns" (:turns r)} extra)]
                 (swap! children assoc id (merge (get @children id) {:status (get base "status")}))
                 base))]
    (-> (p/do (run-child (child-prompt task) {:index i}))
        (p/then (fn [r]
                  (if-not schema
                    (done r nil)
                    (let [v (validate-schema schema (:final r))]
                      (if (:schema_valid v)
                        (done r v)
                        (-> (p/do (run-child (str (child-prompt task)
                                                  "\n\n# Correction\nYour previous answer failed validation: "
                                                  (str/join ", " (:schema_errors v))
                                                  "\nPrevious answer:\n" (str (:final r)))
                                            {:index i :correction? true}))
                            (p/then (fn [r2] (done r2 (validate-schema schema (:final r2)))))
                            (p/catch (fn [_] (done r v)))))))))
        (p/catch (fn [e]
                   (swap! children assoc id {:goal goal :status "failed"})
                   {"subagent_id" id "goal" goal "status" "failed" "error" (.-message e)})))))

(defn task
  "The delegate_task tool. ctx carries :run-child (fn [prompt opts] ->
  run-result map). Always resolves to a JSON string."
  [ctx {:strs [tasks action subagent_id message]}]
  (case (or action "spawn")
    "list" (p/resolved (ok {"tasks" (vec (for [[id c] (sort-by key @children)]
                                           (merge {"subagent_id" id} c)))}))

    "stop" (if-let [c (get @children subagent_id)]
             (if (= "running" (:status c))
               (p/resolved (err (str "stop: " subagent_id " runs joined in this call and cannot be "
                                     "cancelled mid-turn; its partial summary arrives when the turn ends")))
               (p/resolved (ok {"subagent_id" subagent_id "status" (:status c)})))
             (p/resolved (err (str "no such subagent: " subagent_id))))

    "steer" (if (contains? @children subagent_id)
              (p/resolved (err (str "steer: a joined child has no mid-run inbox (message: "
                                    (pr-str message) ") — re-delegate with the correction in the goal")))
              (p/resolved (err (str "no such subagent: " subagent_id))))

    ;; spawn (default)
    (let [run-child (:run-child ctx)]
      (cond
        (not (fn? run-child)) (p/resolved (err "delegate_task: no run backend in this context"))
        (empty? tasks) (p/resolved (err "tasks is required: at least one task to spawn"))
        (> (count tasks) max-children)
        (p/resolved (err (str "at most " max-children " tasks per call, got " (count tasks))))
        :else (p/let [rs (p/all (map-indexed (fn [i t] (run-one run-child i t)) tasks))]
                (ok {"tasks" (vec rs)}))))))
