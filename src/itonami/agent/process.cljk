(ns itonami.agent.process
  "Background terminal processes for one Kotoba agent runtime. A registry is
  scoped to the profile home; results stay bounded in memory. Running sessions
  are checkpointed to `processes.json` in Hermes' crash-recovery format
  (`tools/process_registry_checkpoint.py`) and re-attached as detached
  sessions — status and kill, no pipes — when a later runtime touches the
  home."
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]))

(def ^:private child-process (js/require "node:child_process"))
(def ^:private max-output-chars 200000)
(def ^:private max-processes 64)
(def ^:private max-retained-results 64)
(def ^:private retention-ms (* 7 24 60 60 1000))
(defonce ^:private sessions (atom {}))
(defonce ^:private recovered-homes (atom #{}))

(defn- prune-sessions! [home]
  (let [now (h/now-ms)
        completed (->> @sessions
                       (filter (fn [[_ s]] (and (= home (:home s)) (= :exited @(:state s)))))
                       (sort-by (fn [[_ s]] (or @(:finished-at s) (:started-at s)))))]
    (doseq [[id s] completed
            :when (> (- now (or @(:finished-at s) (:started-at s))) retention-ms)]
      (swap! sessions dissoc id))
    (let [remaining (remove (fn [[id _]]
                              (not (contains? @sessions id))) completed)
          excess (max 0 (- (count remaining) max-retained-results))]
      (doseq [[id _] (take excess remaining)]
        (swap! sessions dissoc id)))))

;; ---- Hermes processes.json checkpoint (crash recovery) ----
;; Entry shape is Hermes' ProcessRegistry._CHECKPOINT_FIELDS plus `session_id`;
;; `command` is redacted before persisting and `owner_task_id` is the RAW
;; spawning task id (`ProcessSession.owner_task_id`, defaulted to the
;; container key exactly as `terminal_tool_background._spawn` does:
;; `owner_task_id=task_id or effective_task_id`). Missing keys fall back to
;; the ProcessSession dataclass defaults where the session map consumes them
;; (command, pid_scope, host_start_time, started_at), and recovery defaults
;; `owner_task_id` to `task_id` as `process_registry_checkpoint` does.

(def ^:private max-handoffs-per-child
  "Hermes tools/process_registry.py `_MAX_HANDOFFS_PER_CHILD`."
  3)

;; ---- completion notices (Hermes ProcessRegistry.completion_queue) ----
;; A session that spawned with `notify_on_complete` enqueues one Hermes-shaped
;; completion event when it exits (first finisher only). `drain-notifications!`
;; routes events to their owner exactly as `ProcessRegistry.drain_notifications`
;; does and formats them with `process_registry_notifications
;; .format_process_notification` (the completion branch).

(def ^:private completion-output-chars-default
  "Hermes tools/process_registry.py `COMPLETION_OUTPUT_CHARS`."
  2000)

(def ^:private subagent-notify-note
  "Hermes tools/terminal_tool_background.py `_SUBAGENT_NOTIFY_NOTE`, verbatim."
  (str "You are a subagent: this process's completion notice will NOT reach your parent, and the process is killed when "
       "you finish. Before you finish, either wait for it (process_manage wait), kill it, or hand it to your parent with "
       "process_manage(action='handoff', session_id=..., data='<purpose>') so the parent receives its completion. For CI "
       "watchers prefer returning the fact (PR number, SHA) and letting the parent watch."))

(def ^:private silent-background-hint
  "Hermes tools/terminal_tool_background.py `_SILENT_BACKGROUND_HINT`, verbatim."
  "background=true without notify_on_complete=true means this process runs SILENTLY — you will not be told when it exits. If this is a bounded task (test suite, build, CI poller, deploy, anything with a defined end), you almost certainly wanted notify_on_complete=true so the system pings you on exit. Re-launch with notify_on_complete=true, or call process(action='poll') / process(action='wait') yourself to learn the outcome. Only ignore this hint for genuine long-lived processes that never exit (servers, watchers, daemons).")

(def ^:private homebrew-ci-poller-hint
  "Hermes tools/terminal_tool_background.py `_HOMEBREW_CI_POLLER_HINT`, verbatim."
  "This looks like a homebrewed CI poller built from `gh pr view --json statusCheckRollup` and/or `gh pr checks | jq`. That shape has burned us repeatedly in hermes-agent dev work (PRs #31329, #31448, #31695, #31709, #31745, #32264, #33131) — stdout buffering kills output capture, jq null-key edge cases silently exit the loop, conclusion-vs-status field confusion exits early with bogus all-green verdicts, TTY-only summary banners never appear when piped. Use the canonical snippets in the green-ci-policy skill instead: the exit-code-driven `gh pr checks $PR >/dev/null` (rc 0 = green, 8 = pending, else fail) for exit-on-first-fail behavior, or the column-2 awk-on-tabs poller (`awk -F\"\\t\" \"$2==\\\"pending\\\"\"`) for sharded matrices. Load skill_view(name='github/hermes-agent-dev', file_path='references/green-ci-policy.md') for the verbatim snippets. If you must roll a custom loop with rich structured output, write each tick to a known file (`tee -a $TMPDIR/ci.log`) and rely on `process(action='log')` to read THAT file — do not rely on background-process stdout capture for line-buffered shell loops.")

(def ^:private async-unsupported-note
  "Hermes tools/terminal_tool_background.py `_ASYNC_UNSUPPORTED_NOTE`, verbatim."
  "notify_on_complete / watch_patterns are not available in this session — it cannot receive an async completion after the turn ends (a one-shot runner such as `hermes -z`, a cron job, a Kanban worker, or a stateless HTTP endpoint). The process is running in the background; retrieve its result with process(action='poll') or process(action='wait').")

(def ^:private heartbeat-ignored-note
  "Hermes tools/terminal_tool_background.spawn_background_process's
  `heartbeat_ignored` value, verbatim."
  "heartbeat needs notify=true delivery, which this session cannot receive")

(def ^:private watch-patterns-ignored-note
  "Hermes tools/terminal_tool._resolve_notification_flag_conflict's conflict
  note (spawn_background_process's `watch_patterns_ignored` value), verbatim."
  "watch_patterns ignored because notify_on_complete=True; these two flags produce duplicate notifications when combined")

(defn homebrew-ci-poller?
  "Hermes tools/terminal_tool_background.py `_looks_like_homebrew_ci_poller`,
  verbatim (deliberately narrow: the canonical column-2 awk poller is fine)."
  [command]
  (let [cmd (str command)
        has-gh (or (str/includes? cmd "gh pr view") (str/includes? cmd "gh pr checks"))
        has-jq (or (str/includes? cmd " jq ") (str/includes? cmd "| jq") (str/includes? cmd "$(jq"))]
    (or (str/includes? cmd "statusCheckRollup") (and has-gh has-jq))))

(defn spawn-notify-disposition
  "Hermes `tools/terminal_tool_background.spawn_background_process`'s
  notification disposition + result notes, verbatim:

  - `hint` = `_SILENT_BACKGROUND_HINT` for a spawn with no notification intent
    (checked on the REQUESTED flags, before `_apply_async_support`), with
    `_HOMEBREW_CI_POLLER_HINT` appended (`\\\\n\\\\n` join) for a homebrewed CI poller;
  - `_apply_async_support`: a session that cannot receive an async completion
    (`:async-delivery?` false — Hermes binds `async_delivery=False` for cron
    job turns and the api_server adapter) drops a requested notify/watch:
    `notify_on_complete` false + `notify_unsupported` = `_ASYNC_UNSUPPORTED_NOTE`,
    and `heartbeat_ignored` replaces an armed heartbeat (Hermes' `elif
    heartbeat_seconds` branch);
  - `_resolve_notification_flag_conflict` (background): notify_on_complete +
    watch_patterns together drop the patterns with `watch_patterns_ignored`;
  - otherwise `notify_on_complete` true, or false + `subagent_note` for a
    delegated child (`_SUBAGENT_NOTIFY_NOTE` branch).

  Returns `{:notify-on-complete? bool :watch-patterns [...] :heartbeat-seconds n
  :notes {...}}` — the effective arming and the result-note map."
  [{:keys [command notify-on-complete? watch-patterns heartbeat-seconds async-delivery? subagent?]}]
  (let [notify? (boolean notify-on-complete?)
        watch-raw (vec (or watch-patterns []))
        hb (if (and (number? heartbeat-seconds) (pos? heartbeat-seconds)) (int heartbeat-seconds) 0)
        async? (not (false? async-delivery?))
        intent? (or notify? (boolean (seq watch-raw)))
        dropped? (and intent? (not async?))
        notify1 (and notify? async?)
        watch1 (if async? watch-raw [])
        conflict? (and notify1 (boolean (seq watch1)))
        watch (if conflict? [] watch1)
        notes (cond-> {}
                (and (not notify?) (empty? watch-raw))
                (assoc "hint" silent-background-hint)
                (homebrew-ci-poller? command)
                (update "hint" #(if (string? %) (str % "\n\n" homebrew-ci-poller-hint) homebrew-ci-poller-hint))
                dropped?
                (assoc "notify_on_complete" false "notify_unsupported" async-unsupported-note)
                conflict?
                (assoc "watch_patterns_ignored" watch-patterns-ignored-note)
                notify1
                (assoc "notify_on_complete" (not subagent?))
                (and notify1 subagent?)
                (assoc "subagent_note" subagent-notify-note)
                (and (not notify1) (pos? hb))
                (assoc "heartbeat_ignored" heartbeat-ignored-note))]
    {:notify-on-complete? notify1
     :watch-patterns watch
     ;; Hermes spawn_background_process: `arm_heartbeat` runs only in the
     ;; `elif heartbeat_seconds` of the delegated-child branch — a subagent's
     ;; spawn arms no heartbeat (and says nothing about it), exactly as its
     ;; completion notice is routed away.
     :heartbeat-seconds (if (and notify1 (not subagent?)) hb 0)
     :notes notes}))

(defonce ^:private completion-queue (atom []))
;; Hermes ProcessRegistry._completion_consumed: exits the agent already saw
;; inline (wait/log), which must not be re-injected as a notice.
(defonce ^:private completion-consumed (atom #{}))
;; Hermes ProcessRegistry._poll_observed: exits observed via a read-only poll;
;; skipped by drains that pass skip-poll-observed (the CLI agent path).
(defonce ^:private poll-observed (atom #{}))

(defn container-task-id
  "Hermes `tools/terminal_tool._resolve_container_task_id` for a non-container
  backend (Kotoba has no Docker/SSH environments; delegate children share the
  parent's home): a session key keys `session:<key>`, everything else —
  including subagent ids — collapses onto `\"default\"`, exactly as Hermes'
  branch 4 describes (\"default, which subagent ids collapse onto to share the
  parent's container\")."
  [session-key]
  (let [k (str session-key)]
    (if (str/blank? k) "default" (str "session:" k))))

(defn- redact-command
  "Kotoba's equivalent of Hermes `redact_sensitive_text(command, code_file=True)`:
  inline credentials never reach processes.json. Recovery uses command for
  display only (adoption re-validates the PID, never re-runs it), so masking
  is lossless."
  [command]
  (-> (str command)
      (str/replace #"://[^/@\s]+:[^/@\s]*@" "://[redacted]@")
      (str/replace #"(?i)\bBearer\s+[A-Za-z0-9._~+/=-]+" "Bearer [redacted]")
      (str/replace #"(?i)(^|[?&\s])([A-Za-z0-9_-]*(?:token|api[-_]?key|secret|password|passwd|pwd)[A-Za-z0-9_-]*[=:\s]+)[^\s\"']+"
                   "$1$2[redacted]")))

(defn- session-pid [session]
  (or (:pid session) (when-let [c (:child session)] (.-pid c))))

(defn- signal-number
  "POSIX signal number for a Node close-event signal name (process.constants
  is not on every runtime's `js/process` global), or nil when unknown."
  [signal]
  (try
    (let [sigs (or (some-> (js/require "node:process") (.-constants) (.-signals))
                   (some-> js/process (.-constants) (.-signals)))]
      (when sigs (aget sigs signal)))
    (catch :default _ nil)))

(defn- ps-probe
  "One `ps` read of a host PID: process state and start wall time, or nil when
  the PID is gone. Zombies report dead, as Hermes `_pid_exists` does."
  [pid]
  (try
    (let [out (str/trim (or (:stdout (h/run-process ["ps" "-o" "state=,lstart=" "-p" (str pid)] {})) ""))]
      (when-not (str/blank? out)
        (let [[state lstart] (str/split out #"\s+" 2)
              t (.getTime (js/Date. (str/trim (or lstart ""))))]
          {:zombie? (= state "Z")
           :start (when-not (js/isNaN t) (/ t 1000))})))
    (catch :default _ nil)))

(defn- host-start-time
  "PID-reuse fingerprint for `host_start_time`: field 22 of /proc/<pid>/stat
  (Linux, kernel start ticks), else the ps start wall time as epoch seconds —
  the same dual semantics as Hermes `get_process_start_time` (int ticks /
  float epoch). nil when the probe cannot be read."
  [pid]
  (try
    (let [stat-path (str "/proc/" pid "/stat")]
      (if (h/exists? stat-path)
        (let [raw (h/slurp stat-path)
              tail (subs raw (inc (.lastIndexOf raw ")")))
              toks (str/split (str/trim tail) #"\s+")]
          (when (> (count toks) 19)
            (js/parseInt (nth toks 19))))
        (:start (ps-probe pid))))
    (catch :default _ nil)))

(defn- pid-fate
  "Hermes `_detached_host_fate`:
  `running` — alive and still ours (start time matches, no baseline, or the
  start-time probe could not be read: re-attach, do not invent an exit).
  `reused` — alive and the start time positively differs: the number belongs
  to someone else; never adopt it and never signal it.
  `gone` — the PID is not alive (zombies report dead): prune it."
  [pid expected-start]
  (let [p (when pid (ps-probe pid))]
    (cond
      (or (nil? p) (:zombie? p)) "gone"
      (nil? expected-start) "running"
      :else (let [cur (host-start-time pid)]
              (if (or (nil? cur) (= cur expected-start)) "running" "reused")))))

(defn- checkpoint-entry [session]
  (let [pid (session-pid session)]
    {"session_id" (:id session)
     "command" (redact-command (:command session))
     "pid" pid
     "pid_scope" "host"
     "host_start_time" (or (:host-start-time session) (host-start-time pid))
     "systemd_unit" ""
     "wsl_chain" false
     "cwd" (:cwd session)
     "started_at" (/ (:started-at session) 1000)
     "task_id" @(:task-id session)
     "owner_task_id" @(:owner-task-id session)
     "session_key" @(:session-key session)
     "watcher_platform" ""
     "watcher_chat_id" ""
     "watcher_user_id" ""
     "watcher_user_name" ""
     "watcher_thread_id" ""
     "watcher_message_id" ""
     "watcher_interval" 0
     "parent_session_id" ""
     "notify_on_complete" (boolean @(:notify-on-complete? session))
     "completion_output_chars" (or (:completion-output-chars session) 0)
     "watch_patterns" (vec (:watch-patterns session))
     "heartbeat_seconds" (:heartbeat-seconds session)
     "persist_on_release" false
     "output_log" ""}))

(defn- read-checkpoint [path]
  (try
    (let [parsed (js->clj (js/JSON.parse (h/slurp path)))]
      (if (vector? parsed) parsed []))
    (catch :default _ [])))

(defn- adoptable-log
  "Hermes `adoptable_log`: a checkpointed log path only when it names a process
  output log (`.log` suffix). Kotoba spawns never set `output_log`."
  [p]
  (when (and (string? p) (str/ends-with? p ".log")) p))

(defn- exit-path
  "Hermes `_exit_path`: the recorded exit status beside the log."
  [log]
  (str/replace log #"\.log$" ".exit"))

(defn- foreign-handoffs
  "On-disk entries this registry never tracked whose log still decides an
  outcome (Hermes `_foreign_handoffs`): an adoptable output log that exists,
  with a recorded exit or the process still alive. Entries without a log —
  every Kotoba spawn — are dropped by the rewrite, exactly as Hermes drops
  them; read-merge-write only preserves worker-log handoffs."
  [path known]
  (filterv (fn [entry]
             (and (map? entry)
                  (not (contains? known (get entry "session_id")))
                  (when-let [log (adoptable-log (get entry "output_log"))]
                    (and (h/exists? log)
                         (or (h/exists? (exit-path log))
                             (= "running" (pid-fate (get entry "pid")
                                                    (get entry "host_start_time"))))))))
           (read-checkpoint path)))

(defn- write-checkpoint! [home]
  (let [path (h/join home "processes.json")
        mine (->> @sessions
                  (filter (fn [[_ s]] (and (= home (:home s)) (= :running @(:state s)))))
                  (mapv (fn [[_ s]] (checkpoint-entry s))))
        known (set (keys @sessions))
        entries (into mine (foreign-handoffs path known))]
    (h/spit-atomic path (h/json-str entries))))

(defn- completion-output
  "Hermes `_completion_output`: `output` sized by the session's
  `completion_output_chars` (or `COMPLETION_OUTPUT_CHARS` when 0) plus
  `output_cut` when trimmed."
  [session]
  (let [n (:completion-output-chars session)
        limit (if (and (number? n) (pos? n)) n completion-output-chars-default)
        s @(:output session)
        cut (- (count s) limit)]
    (cond-> {"output" (redact-command (subs s (max 0 (- (count s) limit))))}
      (pos? cut) (assoc "output_cut" cut))))

;; ---- watch patterns & heartbeats (Hermes watch/heartbeat events) ----
;; `terminal(notify=[...])` / legacy `watch_patterns` arm watch-pattern
;; matching on every output chunk; `terminal(heartbeat=N)` arms periodic
;; "still running, here is the output since last time" ticks. Both queue
;; Hermes-shaped events on `completion_queue` (tools/process_registry.py
;; `_check_watch_patterns` / `_emit_heartbeat`).

(def ^:private watch-min-interval-seconds
  "Hermes tools/process_registry.py `WATCH_MIN_INTERVAL_SECONDS`."
  15)

(def ^:private watch-strike-limit
  "Hermes tools/process_registry.py `WATCH_STRIKE_LIMIT`."
  3)

(def ^:private watch-lifetime-max-hits
  "Hermes tools/process_registry.py `WATCH_LIFETIME_MAX_HITS`."
  8)

(def ^:private watch-global-max-per-window
  "Hermes tools/process_registry.py `WATCH_GLOBAL_MAX_PER_WINDOW`."
  15)

(def ^:private watch-global-window-seconds
  "Hermes tools/process_registry.py `WATCH_GLOBAL_WINDOW_SECONDS`."
  10)

(def ^:private watch-global-cooldown-seconds
  "Hermes tools/process_registry.py `WATCH_GLOBAL_COOLDOWN_SECONDS`."
  30)

(def ^:private heartbeat-min-seconds
  "Hermes tools/process_registry.py `HEARTBEAT_MIN_SECONDS`."
  60)

(def ^:private heartbeat-tick-seconds
  "Hermes tools/process_registry.py `HEARTBEAT_TICK_SECONDS`."
  5)

(def ^:private heartbeat-output-chars
  "Hermes tools/process_registry_notifications.HEARTBEAT_OUTPUT_CHARS`."
  2000)

(defn- now-sec [] (/ (h/now-ms) 1000))

(defn- watch-event-base
  "Hermes `ProcessRegistry._watch_event_base`: the session identity every
  watch/heartbeat event carries. The command is redacted as
  `_redact_process_result` redacts it before the event reaches the model; the
  watcher routing fields ride the checkpoint only (see `checkpoint-entry`).
  `event_id` is Hermes' `uuid.uuid4().hex` shape (32 hex chars)."
  [session]
  {"event_id" (h/random-hex 16)
   "started_at" (/ (:started-at session) 1000)
   "parent_session_id" ""
   "session_id" (:id session)
   "session_key" @(:session-key session)
   "task_id" @(:task-id session)
   "owner_task_id" @(:owner-task-id session)
   "command" (redact-command (:command session))})

;; Hermes `ProcessRegistry`'s global watch circuit breaker state.
(defonce ^:private global-watch (atom {:window-start 0.0 :window-hits 0 :tripped-until 0.0 :suppressed 0}))

(defn reset-watch-breaker!
  "Fresh global watch-breaker state — a fresh `ProcessRegistry` (per-runtime
  singleton) starts with this; tests reset it between cases."
  []
  (reset! global-watch {:window-start 0.0 :window-hits 0 :tripped-until 0.0 :suppressed 0}))

(defn- global-watch-event
  "Hermes `ProcessRegistry._global_watch_event`: unaddressed (all-sessions)
  watch breaker event."
  [type message extra]
  (merge {"session_id" "" "session_key" "" "command" "" "type" type
          "message" message
          "platform" "" "chat_id" "" "user_id" "" "user_name" "" "thread_id" ""}
         extra))

(defn- global-watch-admit!
  "Hermes `ProcessRegistry._global_watch_admit`: true when this watch_match may
  pass the global breaker. In cooldown: drop and count. Otherwise slide the
  rolling window; exceeding the cap trips the breaker for
  `watch-global-cooldown-seconds` with ONE \"tripped\" summary, and the
  cooldown's end emits ONE \"released\" summary."
  [now]
  ;; Node runs this synchronously (no await inside), so a plain
  ;; read-modify-write is atomic like Hermes' lock.
  (let [g @global-watch]
    (when (and (pos? (:tripped-until g)) (>= now (:tripped-until g)))
      (let [suppressed (:suppressed g)]
        (reset! global-watch {:window-start now :window-hits 0
                              :tripped-until 0.0 :suppressed 0})
        (when (pos? suppressed)
          (swap! completion-queue conj
                 (global-watch-event "watch_overflow_released"
                                     (str "Watch-pattern notifications resumed. "
                                          suppressed " match event(s) were suppressed during the flood.")
                                     {"suppressed" suppressed}))))
      nil)
    (let [g @global-watch]
      (if (and (pos? (:tripped-until g)) (< now (:tripped-until g)))
        (do (swap! global-watch update :suppressed inc)
            false)
        (let [g (if (>= (- now (:window-start g)) watch-global-window-seconds)
                  (assoc g :window-start now :window-hits 0)
                  g)]
          (if (< (:window-hits g) watch-global-max-per-window)
            (do (reset! global-watch (update g :window-hits inc))
                true)
            (do (reset! global-watch (-> g
                                         (assoc :tripped-until (+ now watch-global-cooldown-seconds))
                                         (update :suppressed inc)))
                (swap! completion-queue conj
                       (global-watch-event "watch_overflow_tripped"
                                           (str "Watch-pattern overflow: >" watch-global-max-per-window
                                                " notifications in " watch-global-window-seconds
                                                "s across all processes. Suppressing further watch_match "
                                                "events for " watch-global-cooldown-seconds "s.")
                                           {}))
                false)))))))

(defn- emit-watch-disabled!
  "Hermes `ProcessRegistry._emit_watch_disabled`: the one-shot watch_disabled
  summary (strike-limit or lifetime-cap path)."
  [session suppressed why]
  (swap! completion-queue conj
         (merge (watch-event-base session)
                {"type" "watch_disabled"
                 "suppressed" suppressed
                 "message" (str "Watch patterns disabled for process " (:id session) " — " why
                                "Falling back to notify_on_complete semantics; you'll get "
                                "exactly one notification when the process exits.")})))

(defn heartbeat-output-tail
  "Hermes `process_registry_notifications.heartbeat_output_tail`, verbatim: a
  tick's output capped to its newest characters (a long job's latest lines are
  what matters), and the count of characters cut before it. `omitted` counts
  characters already cut before `output`."
  ([output] (heartbeat-output-tail output 0))
  ([output omitted]
   (if (> (count output) heartbeat-output-chars)
     [(subs output (- (count output) heartbeat-output-chars))
      (+ omitted (- (count output) heartbeat-output-chars))]
     [output omitted])))

(defn check-watch-patterns!
  "Hermes `ProcessRegistry._check_watch_patterns`: scan a freshly-read chunk
  for watch patterns and queue notifications. Per-session rate limiting (the
  `watch-*` constants): one match per cooldown window, a match inside the
  window is one strike, `watch-strike-limit` consecutive strikes or
  `watch-lifetime-max-hits` total deliveries disable watching and promote the
  session to `notify_on_complete`. `now` is epoch seconds."
  [session new-text now]
  (let [patterns (vec (:watch-patterns session))]
    (when (and (seq patterns)
               (not (:disabled? @(:watch session)))
               (= :running @(:state session)))
      (let [hits (into []
                       (for [line (str/split-lines new-text)
                             :let [p (some (fn [p] (when (str/includes? line p) p)) patterns)]
                             :when p]
                         [p (str/replace line #"\s+$" "")]))]
        (when (seq hits)
          (let [matched-pattern (first (first hits))
                matched-lines (mapv second hits)
                w @(:watch session)]
            (if (and (pos? (:cooldown-until w)) (< now (:cooldown-until w)))
              ;; Inside the cooldown: drop, count one strike per window,
              ;; disable + promote once the strike limit is hit.
              (do (swap! (:watch session) update :suppressed + (count matched-lines))
                  (when-not (:strike-candidate? @(:watch session))
                    (swap! (:watch session) assoc :strike-candidate? true)
                    (swap! (:watch session) update :consecutive-strikes inc)
                    (when (>= (:consecutive-strikes @(:watch session)) watch-strike-limit)
                      (swap! (:watch session) assoc :disabled? true)
                      ;; Promote so the agent still gets exactly one
                      ;; notification on exit, plus exactly one summary so it
                      ;; sees why things went quiet.
                      (reset! (:notify-on-complete? session) true)
                      (emit-watch-disabled!
                       session (:suppressed @(:watch session))
                       (str watch-strike-limit " consecutive rate-limit windows triggered "
                            "(min spacing " watch-min-interval-seconds "s). ")))))
              ;; Cooldown expired. A prior window with no drops resets the
              ;; consecutive-strike counter (healthy cadence again).
              (let [w (cond-> w
                        (and (pos? (:cooldown-until w)) (not (:strike-candidate? w)))
                        (assoc :consecutive-strikes 0))
                    ;; Emit and start a new cooldown window.
                    w (-> w
                          (assoc :strike-candidate? false)
                          (assoc :cooldown-until (+ now watch-min-interval-seconds))
                          (update :hits inc))
                    suppressed (:suppressed w)
                    w (assoc w :suppressed 0)
                    ;; Lifetime cap: this match is still delivered, but no
                    ;; further ones.
                    lifetime-exhausted (>= (:hits w) watch-lifetime-max-hits)
                    w (cond-> w lifetime-exhausted (assoc :disabled? true))]
                (reset! (:watch session) w)
                (when lifetime-exhausted
                  (reset! (:notify-on-complete? session) true))
                (let [output (let [lines (str/join "\n" (take 20 matched-lines))]
                               (if (> (count lines) 2000)
                                 (str (subs lines 0 2000) "\n...(truncated)")
                                 lines))]
                  (when (global-watch-admit! now)
                    (swap! completion-queue conj
                           (merge (watch-event-base session)
                                  {"type" "watch_match"
                                   "pattern" matched-pattern
                                   "output" (redact-command output)
                                   "suppressed" suppressed})))
                  ;; Even when the breaker drops the final match, still
                  ;; explain the silence.
                  (when lifetime-exhausted
                    (emit-watch-disabled!
                     session 0
                     (str "reached the lifetime cap of " watch-lifetime-max-hits
                          " delivered matches. "))))))))))))

(defn emit-heartbeat!
  "Hermes `ProcessRegistry._emit_heartbeat`: queue a heartbeat carrying the
  output since the last one. A tick with nothing new is skipped outright:
  every queued event costs the owner a full model turn."
  [session now]
  (let [hb @(:hb session)]
    (reset! (:hb session) (assoc hb :last now))
    (let [delta (- @(:total-chars session) (:total-at-last hb))
          buf @(:output session)
          raw (if (pos? delta) (subs buf (max 0 (- (count buf) delta))) "")]
      (reset! (:hb session) (assoc @(:hb session) :total-at-last @(:total-chars session)))
      (when-not (= raw "")
        (let [[output omitted] (heartbeat-output-tail raw)
              seq (inc (:seq @(:hb session)))]
          (reset! (:hb session) (assoc @(:hb session) :seq seq))
          (swap! completion-queue conj
                 (merge (watch-event-base session)
                        {"type" "heartbeat"
                         "seq" seq
                         "interval" (:heartbeat-seconds session)
                         "elapsed" (js/Math.trunc (- now (/ (:started-at session) 1000)))
                         "output" (redact-command output)
                         "omitted" omitted
                         "started_at" (/ (:started-at session) 1000)})))))))

(defonce ^:private heartbeat-timer (atom nil))

(defn- heartbeat-loop
  "Hermes `ProcessRegistry._heartbeat_loop`: one daemon thread for every
  heartbeat session (Kotoba: one unref'd interval timer)."
  []
  (let [now (now-sec)]
    (doseq [[_ s] @sessions
            :when (and (= :running @(:state s))
                       (pos? (:heartbeat-seconds s))
                       (>= (- now (:last @(:hb s))) (:heartbeat-seconds s)))]
      (emit-heartbeat! s now))))

(defn- ensure-heartbeat-timer!
  "Start the single heartbeat tick timer (`_ensure_heartbeat_thread`). The
  timer is unref'd — a daemon thread must not keep the runtime alive."
  []
  (when-not @heartbeat-timer
    (let [t (js/setInterval heartbeat-loop (* 1000 heartbeat-tick-seconds))]
      (when (fn? (.-unref t)) (.unref t))
      (reset! heartbeat-timer t))))

(defn- completion-event
  "Hermes `ProcessRegistry._publish_finished`'s notification payload, minus
  what Kotoba has no producer for (watcher fields ride the checkpoint only).
  The command is redacted exactly as the checkpoint entry is (`_redact_process_result`
  redacts the command before the event reaches the model)."
  [session exit-code reason source]
  (cond-> {"type" "completion"
           "session_id" (:id session)
           "session_key" @(:session-key session)
           "task_id" @(:task-id session)
           "owner_task_id" @(:owner-task-id session)
           "command" (redact-command (:command session))
           "exit_code" exit-code
           "completion_reason" reason
           "termination_source" source
           "started_at" (/ (:started-at session) 1000)}
    (not (str/blank? @(:handoff-note session))) (assoc "handoff_note" @(:handoff-note session))
    true (into (completion-output session))))

(defn- finish! [session exit-code reason source detail on-exit tmpdir]
  (when (compare-and-set! (:state session) :running :exited)
    (reset! (:exit-code session) exit-code)
    (reset! (:finished-at session) (h/now-ms))
    (try
      (when @(:notify-on-complete? session)
        (swap! completion-queue conj (completion-event session exit-code reason source)))
      (finally
        ;; Hermes `_move_to_finished` releases the one-shot linger's waiters
        ;; (`_completion_event.set()`) only after the notice is queued (or its
        ;; publish failed), so a waiter can never park forever and can never
        ;; miss a queued notice.
        (reset! (:completion-event? session) true)))
    (try
      (when on-exit (on-exit exit-code detail))
      (finally
        (when tmpdir (h/rm tmpdir))
        (prune-sessions! (:home session))
        (write-checkpoint! (:home session))))))

(defn- append-output! [session chunk]
  (let [text (.toString chunk "utf8")]
    (swap! (:total-chars session) + (count text))
    (swap! (:output session)
           (fn [s]
             (let [s (str s text)]
               (subs s (max 0 (- (count s) max-output-chars))))))
    ;; Hermes' reader thread scans each freshly-read chunk for watch patterns.
    (check-watch-patterns! session text (now-sec))))

(defn- process-status [session]
  (if (= :running @(:state session)) "running" "exited"))

(defn- result-base [session]
  (merge {"session_id" (:id session)
          "command" (:command session)
          "status" (process-status session)
          "pid" (session-pid session)
          "cwd" (:cwd session)
          "uptime_seconds" (max 0 (quot (- (h/now-ms) (:started-at session)) 1000))
          "task_id" @(:task-id session)
          "owner_task_id" @(:owner-task-id session)}
         (when-not (str/blank? @(:handoff-note session))
           {"handoff_note" @(:handoff-note session)})))

(defn- adopt-entry! [home entry]
  (let [id (get entry "session_id")
        pid (get entry "pid")
        scope (or (get entry "pid_scope") "host")]
    (when (and (string? id) (number? pid)
               (not (contains? @sessions id))
               ;; in-sandbox PIDs mean nothing once the env handle is gone
               (= "host" scope))
      (let [expected (get entry "host_start_time")]
        ;; A start-time probe that cannot be read is not proof the PID was
        ;; reused; only a positive mismatch refuses adoption.
        (when (= "running" (pid-fate pid expected))
          (let [started (get entry "started_at")
                session {:id id :home home :command (get entry "command" "unknown")
                         :cwd (get entry "cwd") :pid pid :child nil :detached? true
                         :host-start-time expected
                         :task-id (atom (str (or (get entry "task_id") "")))
                         :owner-task-id (atom (str (or (get entry "owner_task_id")
                                                      (get entry "task_id") "")))
                         :session-key (atom (str (or (get entry "session_key") "")))
                         :handoff-note (atom "")
                         :notify-on-complete? (atom (boolean (get entry "notify_on_complete")))
                         :completion-event? (atom false)
                         :on-exit nil :tmpdir nil
                         :completion-output-chars (or (get entry "completion_output_chars") 0)
                         :watch-patterns (vec (or (get entry "watch_patterns") []))
                         :heartbeat-seconds (int (or (get entry "heartbeat_seconds") 0))
                         :watch (atom {:hits 0 :suppressed 0 :disabled? false
                                       :cooldown-until 0.0 :strike-candidate? false
                                       :consecutive-strikes 0})
                         :hb (atom {:last 0.0 :total-at-last 0 :seq 0})
                         :total-chars (atom 0)
                         :killed-by (atom nil)
                         :started-at (long (* 1000 (if (number? started)
                                                     started
                                                     (/ (h/now-ms) 1000))))
                         :finished-at (atom nil) :state (atom :running)
                         :exit-code (atom nil) :output (atom "")}]
            (swap! sessions assoc id session)
            session))))))

(defn restore-checkpoint!
  "Hermes `recover_from_checkpoint`: probe the checkpoint's PIDs and re-attach
  the ones still ours as detached sessions (status and kill; the pipes died
  with the old runtime, so no output survives). A recycled PID is never
  adopted and never signalled. Returns how many sessions were adopted."
  [home]
  (let [path (h/join home "processes.json")
        adopted (count (keep #(adopt-entry! home %) (read-checkpoint path)))]
    ;; rewrite so the entries recovery did not adopt leave the checkpoint
    (write-checkpoint! home)
    adopted))

(defn- ensure-recovered! [home]
  (when-not (contains? @recovered-homes home)
    (swap! recovered-homes conj home)
    (restore-checkpoint! home)))

(defn- refresh-detached!
  "Hermes `_refresh_detached_session`: re-attach while the PID is still ours,
  close without a collected exit status when it is gone, and drop (never
  signal) a recycled PID."
  [session]
  (if-not (and (:detached? session) (= :running @(:state session)))
    session
    (let [fate (pid-fate (:pid session) (:host-start-time session))]
      (case fate
        "running" session
        ;; Hermes `_close_reused_detached` / `_prune_uncollected_detached`:
        ;; the entry is closed without a collected exit status and its
        ;; completion event is set (no completion is queued — there is no
        ;; exit status to report), so a parked linger releases.
        "reused" (do (reset! (:completion-event? session) true)
                     (swap! sessions dissoc (:id session)) nil)
        (do (when (compare-and-set! (:state session) :running :exited)
              (reset! (:finished-at session) (h/now-ms))
              (reset! (:completion-event? session) true)
              (prune-sessions! (:home session)))
            session)))))

(defn spawn!
  "Start the already-confined argv from confine/command. The caller owns the
  policy decision and audit record; this namespace only manages the child.
  `notify-on-complete?` arms Hermes' pushed completion notice (terminal
  `notify_on_complete`); a subagent spawn stays armed (the notice is routed
  away at drain time by child-ownership, and a handoff re-owns it) while its
  result says so, with Hermes' `subagent_note`
  (`terminal_tool_background`'s delegated-child branch)."
  [ctx {:keys [argv env cwd tmpdir command on-exit notify-on-complete? completion-output-chars
               watch-patterns heartbeat-seconds]}]
  (let [home (:home ctx)
        _ (ensure-recovered! home)
        _ (prune-sessions! home)
        running (filter #(and (= home (:home %)) (= :running @(:state %))) (vals @sessions))
        notify-requested (boolean notify-on-complete?)]
    (cond
      (>= (count running) max-processes)
      (h/json-str {"error" (str "background process limit reached (" max-processes ")")})

      :else
      (let [id (str "proc_" (h/random-hex 6))
            raw-task (str (or (:task-id ctx) ""))
            session-key (str (or (:session-key ctx) ""))
            ;; Hermes spawn_background_process's notification disposition +
            ;; result notes, applied to the REQUESTED flags (the `hint` check
            ;; precedes `_apply_async_support`, as there).
            disp (spawn-notify-disposition {:command (str command)
                                            :notify-on-complete? notify-requested
                                            :watch-patterns watch-patterns
                                            :heartbeat-seconds heartbeat-seconds
                                            :async-delivery? (:async-delivery? ctx)
                                            :subagent? (boolean (:subagent ctx))})
            hb-armed (if (pos? (:heartbeat-seconds disp))
                       ;; Hermes `arm_heartbeat` returns the floor-clamped interval
                       (max (int (:heartbeat-seconds disp)) heartbeat-min-seconds)
                       0)
            task-key (container-task-id session-key)
            ;; Hermes terminal_tool_background._spawn:
            ;; `owner_task_id=task_id or effective_task_id`
            owner (if (str/blank? raw-task) task-key raw-task)
            child (try
                    (.spawn child-process (first argv) (clj->js (subvec (vec argv) 1))
                            #js {:cwd cwd :env (clj->js env) :detached true
                                 :stdio #js ["pipe" "pipe" "pipe"]})
                    (catch :default e e))
            session {:id id :home home :command command :cwd cwd :child child
                     :pid (when-not (instance? js/Error child) (.-pid child))
                     :task-id (atom task-key)
                     :owner-task-id (atom owner)
                     :session-key (atom session-key)
                     :handoff-note (atom "")
                     :notify-on-complete? (atom (:notify-on-complete? disp))
                     ;; Hermes `ProcessSession._completion_event`: set exactly
                     ;; when the exit is booked (finish! / detached close).
                     :completion-event? (atom false)
                     :on-exit on-exit :tmpdir tmpdir
                     :completion-output-chars (or completion-output-chars 0)
                     ;; Hermes `arm_heartbeat`: the effective interval is
                     ;; clamped to the floor; the output baseline stays 0
                     ;; (spawn) so the first heartbeat carries everything
                     ;; printed since spawn, exactly as `_heartbeat_total_at_last`
                     ;; defaults to 0 in `ProcessSession`.
                     :watch-patterns (vec (:watch-patterns disp))
                     :heartbeat-seconds hb-armed
                     :watch (atom {:hits 0 :suppressed 0 :disabled? false
                                   :cooldown-until 0.0 :strike-candidate? false
                                   :consecutive-strikes 0})
                     :hb (atom {:last (now-sec) :total-at-last 0 :seq 0})
                     :total-chars (atom 0)
                     :killed-by (atom nil)
                     :started-at (h/now-ms) :finished-at (atom nil)
                     :state (atom :running) :exit-code (atom nil)
                     :output (atom "")}]
        (if (instance? js/Error child)
          (do (when tmpdir (h/rm tmpdir))
              (h/json-str {"error" (str "background spawn failed: " (.-message child))}))
          (do
            (swap! sessions assoc id session)
            (when (pos? (:heartbeat-seconds session)) (ensure-heartbeat-timer!))
            (.on (.-stdout child) "data" #(append-output! session %))
            (.on (.-stderr child) "data" #(append-output! session %))
            (.on child "error" (fn [e]
                                 (finish! session -1 "failed_start" "failed_start"
                                          (str (.-message e)) on-exit tmpdir)))
            (.on child "close" (fn [code signal]
                                 ;; Python Popen returncode semantics: a signal
                                 ;; death reports the negated signal number
                                 ;; (SIGTERM -> -15, the formatter's marker set).
                                 (let [killed @(:killed-by session)
                                       exit (if (number? code)
                                              code
                                              (- (or (signal-number signal) 1)))]
                                   (finish! session exit
                                            (if killed "killed" "exited")
                                            (str (or killed ""))
                                            (when signal (str "signal " signal))
                                            on-exit tmpdir))))
            (write-checkpoint! home)
            (h/json-str (merge (result-base session)
                               {"status" "running"
                                "note" "Use process_manage to poll, wait, read logs, send stdin, or terminate."}
                               ;; Hermes spawn_background_process's result
                               ;; notes, verbatim: `hint` (`_SILENT_BACKGROUND_HINT`
                               ;; + `_HOMEBREW_CI_POLLER_HINT`), `notify_unsupported`
                               ;; (`_ASYNC_UNSUPPORTED_NOTE`), `watch_patterns_ignored`,
                               ;; `heartbeat_ignored`, `subagent_note`,
                               ;; `notify_on_complete`.
                               (:notes disp)
                               (cond-> {}
                                 ;; `arm_heartbeat`'s floor-clamped return value
                                 (pos? hb-armed) (assoc "heartbeat_seconds" hb-armed)
                                 ;; Hermes: only an armed (post-conflict) list is echoed
                                 (seq (:watch-patterns disp)) (assoc "watch_patterns" (vec (:watch-patterns disp))))))))))))

(defn- resolve-session [ctx requested]
  (let [matches (filter (fn [[id s]] (and (= (:home ctx) (:home s))
                                             (str/starts-with? id (str requested)))) @sessions)]
    (cond
      (empty? matches) {:error (str "process not found: " requested)}
      (> (count matches) 1) {:error (str "ambiguous session_id prefix: " requested)}
      :else (val (first matches)))))

(defn- snapshot [session]
  ;; Hermes poll(): a read-only exit observation records `_poll_observed` —
  ;; it suppresses the CLI's duplicate-notice drain but not the watcher's.
  (when (= :exited @(:state session))
    (swap! poll-observed conj (:id session)))
  (merge (result-base session)
         {"exit_code" @(:exit-code session)
          "output_preview" (let [s @(:output session)] (subs s (max 0 (- (count s) 1000))))}))

(defn- read-log [session offset limit]
  (let [lines (str/split-lines @(:output session))
        total (count lines)
        start (if (nil? offset) (max 0 (- total limit)) (max 0 offset))
        selected (take limit (drop start lines))]
    ;; Hermes log(): an exited result read through to the end is CONSUMED
    ;; (`_completion_consumed`) — the agent has the result this turn, so no
    ;; completion notice may re-inject it.
    (when (and (= :exited @(:state session))
               (or (zero? total)
                   (and (seq selected) (>= (+ start (count selected)) total))))
      (swap! completion-consumed conj (:id session)))
    (merge (result-base session)
           {"output" (str/join "\n" selected)
            "total_lines" total
            "showing" (str (count selected) " lines")})))

(defn- wait-result [session timeout-s]
  (let [timeout-ms (* 1000 (max 1 (min 1800 (or timeout-s 180))))
        started (h/now-ms)]
    (p/loop []
      (let [s (or (refresh-detached! session) session)]
        (cond
          (= :exited @(:state s))
          ;; Hermes wait(): the wait consumed the completion.
          (do (swap! completion-consumed conj (:id session))
              (snapshot s))
          (>= (- (h/now-ms) started) timeout-ms) (assoc (snapshot s) "timed_out" true)
          :else (p/let [_ (p/delay 100)] (p/recur)))))))

(defn transfer-ownership!
  "Hermes `ProcessRegistry.transfer_ownership`: move a RUNNING session from
  `from-owner` to `to-owner` — flipping `owner_task_id`, the container
  `task_id`, `session_key` and `handoff_note` is the whole transfer (completion
  notices are stamped from the owner at exit time). Returns the session, or
  nil when it is unknown, already exited, or not owned by `from-owner` — the
  caller must not report a transfer that did not happen."
  [session {:keys [from-owner to-owner to-task-id to-session-key note]}]
  (when (and (= :running @(:state session))
             (= (str from-owner) @(:owner-task-id session)))
    (reset! (:owner-task-id session) (str to-owner))
    (reset! (:task-id session) (str to-task-id))
    (reset! (:session-key session) (str to-session-key))
    (reset! (:handoff-note session) (str note))
    session))

(defn handoff!
  "Hermes `_handoff_process` (tools/process_registry.py): subagent-only —
  transfer a running background process to the parent agent so its completion
  is delivered THERE. Validated against the live spawn tree: the caller must
  be a registered child (`ctx :subagent`, as `delegate_tool_registry
  ._active_subagents` gates it) with a live parent and must own the process;
  anything else is an error, never a silent no-op, so a PID mentioned in prose
  can't masquerade as a transfer. The parent's owner id is its task id
  (`parent._current_task_id or parent.session_id` in Hermes; Kotoba binds one
  task id per run)."
  [ctx session-id data]
  (let [task-id (str (or (:task-id ctx) ""))
        sub (:subagent ctx)
        parent-owner (str (or (:parent-owner sub) ""))
        parent-session-key (str (or (:parent-session-key sub) ""))
        handed (:handed sub)
        note (str/trim (str (or data "")))]
    (cond
      (nil? sub)
      {"error" "handoff is only available to a running subagent with a live parent; you are not one."}

      (str/blank? parent-owner)
      {"error" "parent has no process owner id yet; retry after the parent's turn has started."}

      (>= (count @handed) max-handoffs-per-child)
      {"error" (str "handoff cap reached (" max-handoffs-per-child
                    " per subagent); wait on or kill the rest yourself.")}

      (str/blank? note)
      {"error" "handoff requires `data`: one sentence saying what the process is for and what the parent should do with its result."}

      :else
      (let [resolved (resolve-session ctx session-id)
            session (when-not (:error resolved) (refresh-detached! resolved))
            transferred (when session
                          (transfer-ownership! session
                                               {:from-owner task-id
                                                :to-owner parent-owner
                                                :to-task-id (container-task-id parent-session-key)
                                                :to-session-key parent-session-key
                                                :note note}))]
        (if transferred
          (do
            (swap! handed conj {"session_id" (:id transferred)
                                "command" (:command transferred)
                                "note" note})
            {"status" "handed_off"
             "session_id" (:id transferred)
             "command" (:command transferred)
             "note" (str "Your parent now owns this process and will receive its "
                         "completion; you will not. Mention the handoff in your final answer.")})
          {"error" (str "cannot hand off " session-id ": not a running process you own "
                        "(already exited? read its result with poll/log and report it instead).")})))))

(defn manage
  "Hermes-shaped background process actions, scoped to this profile home."
  [ctx {:strs [action session_id data timeout offset limit]}]
  (ensure-recovered! (:home ctx))
  (prune-sessions! (:home ctx))
  (if (= action "list")
    (h/json-str {"processes" (->> (vals @sessions)
                                  (filter #(= (:home ctx) (:home %)))
                                  (keep refresh-detached!)
                                  (mapv snapshot))})
    (let [session (when session_id (resolve-session ctx session_id))
          session (when session
                    (or (refresh-detached! session)
                        {:error (str "process not found: " session_id)}))]
      (cond
        (nil? session_id) (h/json-str {"error" (str "session_id is required for " action)})
        (= action "handoff") (h/json-str (handoff! ctx session_id data))
        (:error session) (h/json-str session)
        (= action "poll") (h/json-str (snapshot session))
        (= action "log") (h/json-str (read-log session offset (max 1 (min 2000 (or limit 200)))))
        (= action "wait") (p/then (wait-result session timeout) h/json-str)
        (= action "kill")
        (if (= :exited @(:state session))
          (h/json-str (merge (snapshot session) {"status" "already_exited"}))
          (try
            ;; Hermes kill_process: the registry-initiated kill stamps the
            ;; termination source the completion notice reports ("killed …
            ;; terminated by process.kill").
            (reset! (:killed-by session) "process.kill")
            ;; a detached session owns no group we track: signal the PID itself
            (js/process.kill (if (:detached? session)
                               (session-pid session)
                               (- (session-pid session)))
                             "SIGTERM")
            (h/json-str {"status" "terminating" "session_id" (:id session)})
            (catch :default e (h/json-str {"status" "error" "error" (.-message e)}))))
        (or (= action "write") (= action "submit") (= action "close"))
        (let [stdin (when-let [c (:child session)] (.-stdin c))]
          (if (or (= :exited @(:state session)) (nil? stdin))
            (h/json-str {"status" "error" "error" "process stdin is unavailable or already closed"})
            (try
              (case action
                "write" (.write stdin (str data))
                "submit" (.write stdin (str data "\n"))
                "close" (.end stdin))
              (h/json-str {"status" "ok" "session_id" (:id session)})
              (catch :default e (h/json-str {"status" "error" "error" (.-message e)})))))
        :else (h/json-str {"error" (str "unknown process action: " action)})))))

;; ---- subagent attribution (Hermes tools/delegate_tool_registry) ----

(def recent-subagents-cap
  "Hermes `tools/delegate_tool_registry._RECENT_SUBAGENTS_CAP`, verbatim."
  200)

(def active-subagents
  "subagent_id -> the child's registry record (Hermes
  `tools/delegate_tool_registry._active_subagents`), written by
  `delegated-tasks` around each child run. Read only through
  `get-subagent-attribution`."
  (atom {}))

(def recent-subagents
  "Ordered [subagent_id stub] entries kept AFTER the child finishes (Hermes
  `_recent_subagents`, bounded FIFO): child-started background processes
  routinely outlive the child and their completion notifications still need
  delegation attribution. A stub keeps `goal` and `delegation_id` (Hermes also
  keeps `owner_agent_session_id`, which Kotoba's handoff gate sources from the
  process record instead)."
  (atom []))

(defn register-subagent-attribution!
  "Hermes `_register_subagent`: keep the record under its `subagent_id`."
  [record]
  (let [sid (get record "subagent_id")]
    (when (and (some? sid) (not= "" sid))
      (swap! active-subagents assoc sid record))))

(defn unregister-subagent-attribution!
  "Hermes `_unregister_subagent`: drop the live record and keep the bounded
  attribution stub in the recent FIFO. A recycled id's stub is replaced IN
  PLACE (Python dict assignment semantics): the FIFO slot is the first
  insertion, never the latest."
  [subagent-id]
  (when-let [record (get @active-subagents subagent-id)]
    (swap! active-subagents dissoc subagent-id)
    (let [sid (get record "subagent_id")]
      (when (and (some? sid) (not= "" sid))
        (swap! recent-subagents
               (fn [entries]
                 (let [stub {"goal" (get record "goal")
                             "delegation_id" (get record "delegation_id")}
                       slot (first (keep-indexed (fn [i [id _]] (when (= id sid) i)) entries))
                       entries (if (some? slot)
                                 (assoc entries slot [sid stub])
                                 (conj (vec entries) [sid stub]))]
                   (if (> (count entries) recent-subagents-cap)
                     (subvec entries 1)
                     entries))))))))

(defn get-subagent-attribution
  "Hermes `tools/delegate_tool_registry.get_subagent_attribution`, verbatim
  projection: `{subagent_id goal delegation_id}` for a process task_id that
  belongs to a live or recently-finished child (children run their terminal
  sessions under `task_id == subagent_id`), else nil."
  [task-id]
  (when (and (string? task-id) (not= "" task-id))
    (when-let [record (or (get @active-subagents task-id)
                          (some (fn [[id stub]] (when (= id task-id) stub))
                                @recent-subagents))]
      {"subagent_id" task-id
       "goal" (get record "goal")
       "delegation_id" (get record "delegation_id")})))

;; ---- completion-notice routing (Hermes drain_notifications + format_process_notification) ----

(defn is-completion-consumed?
  "Hermes `ProcessRegistry.is_completion_consumed`: the agent already has this
  result this turn (consumed via wait/log), so no notice may re-inject it."
  [session-id]
  (contains? @completion-consumed session-id))

(defn- child-notification?
  "Hermes `is_child_process_notification` on the RAW spawning id: Kotoba
  subagent ids are `sub-…` (Hermes' are `sa-…`) — raw child process noise,
  not a delegation deliverable."
  [evt]
  (str/starts-with? (str (or (get evt "owner_task_id") (get evt "task_id") "")) "sub-"))

(def ^:private reason-status
  "Hermes `process_registry_notifications._REASON_STATUS`, verbatim."
  {"lost" "marked lost because the process backend disappeared"
   "failed_start" "failed to start"})

(defn- completion-status
  "Hermes `process_registry_notifications._completion_status`, verbatim."
  [evt]
  (let [reason (or (get evt "completion_reason") "exited")]
    (cond
      (= reason "killed") (str "terminated by " (or (get evt "termination_source") "Hermes"))
      (contains? reason-status reason) (get reason-status reason)
      (= 0 (get evt "exit_code" "?")) "completed normally"
      :else "exited")))

(defn- delegation-attribution-line
  "Hermes `process_registry_notifications._delegation_attribution_line`,
  verbatim (Kotoba subagent ids are `sub-…`, Hermes' `sa-…`): the
  `get-subagent-attribution` lookup fills the delegation and the goal, and an
  aged-out registry entry still attributes generically, never anonymously."
  [evt]
  (let [raw-owner (str (or (get evt "owner_task_id") (get evt "task_id") ""))]
    (when (child-notification? evt)
      (if-let [info (get-subagent-attribution raw-owner)]
        (let [goal (str/trim (str (or (get info "goal") "")))
              goal (if (> (count goal) 120) (str (subs goal 0 117) "...") goal)
              deleg (get info "delegation_id")]
          (str "Started by subagent " raw-owner
               (when (and (some? deleg) (not= deleg "")) (str " of delegation " deleg))
               "."
               (when-not (= goal "") (str " Task: \"" goal "\""))))
        (str "Started by subagent " raw-owner " (delegate_task).")))))

(defn format-age
  "Hermes `process_registry_notifications._format_age`, verbatim:
  human-friendly elapsed string ('18m', '2h3m', '45s')."
  [seconds]
  (let [s (try (js/Math.trunc (max 0 seconds)) (catch :default _ nil))]
    (cond
      (or (nil? s) (js/Number.isNaN s)) "?"
      (< s 60) (str s "s")
      :else (let [m (quot s 60) r (rem s 60)]
              (if (< m 60)
                (str m "m" (when (pos? r) (str r "s")))
                (let [hh (quot m 60) mm (rem m 60)]
                  (str hh "h" (when (pos? mm) (str mm "m")))))))))

(defn heartbeat-output-text
  "Hermes `process_registry_notifications.heartbeat_output_text`, verbatim: a
  tick's output as the agent reads it — the cut marker, rendered here only,
  then the tail."
  [evt]
  (let [omitted (int (or (get evt "omitted") 0))
        output (str (or (get evt "output") ""))]
    (if (pos? omitted)
      (str "...(" omitted " earlier characters omitted)\n" output)
      output)))

(defn format-completion-notification
  "Hermes `process_registry_notifications.format_process_notification`, verbatim
  (`async_delegation` has no Kotoba producer — that surface is the delegation
  result path). `handoff_note` overrides the delegation attribution, as in
  Hermes: the parent is told the process was handed to it and why."
  [evt]
  (let [evt-type (get evt "type" "completion")]
    (if (contains? #{"watch_disabled" "watch_overflow_tripped" "watch_overflow_released"} evt-type)
      (str "[IMPORTANT: " (get evt "message" "") "]")
      (let [sid (get evt "session_id" "unknown")
            cmd (get evt "command" "unknown")
            attribution (if (get evt "handoff_note")
                          (str "Handed off to you by a subagent before it finished. Purpose: "
                               (get evt "handoff_note"))
                          (delegation-attribution-line evt))
            attribution (if attribution (str attribution "\n") "")]
        (cond
          (= "heartbeat" evt-type)
          (str "[Background process " sid " heartbeat #" (get evt "seq" "?")
               " — still running after " (format-age (or (get evt "elapsed") 0))
               " (next in " (get evt "interval" "?") "s when there is new output; you will also be told when it exits).\n"
               attribution "Command: " cmd "\nOutput since last heartbeat:\n"
               (heartbeat-output-text evt) "]")

          (= "watch_match" evt-type)
          (let [sup (or (get evt "suppressed") 0)]
            (str "[IMPORTANT: Background process " sid " matched watch pattern \""
                 (get evt "pattern" "?") "\".\n"
                 attribution "Command: " cmd "\nMatched output:\n" (get evt "output" "")
                 (when (pos? sup) (str "\n(" sup " earlier matches were suppressed by rate limit)"))
                 "]"))

          :else
          (let [exit (get evt "exit_code" "?")
                out (get evt "output" "")
                signal (if (contains? #{-15 143 "-15" "143"} exit) ", SIGTERM" "")
                out (cond
                      (and attribution (string? out) (> (count out) 600))
                      (str "...(output trimmed — subagent-owned process; see the "
                           "delegation's live transcript for full output)\n"
                           (subs out (- (count out) 600)))

                      (get evt "output_cut")
                      (str "...(first " (get evt "output_cut") " characters cut — process(action=\"log\", "
                           "session_id=\"" sid "\") has the full output)\n" out)

                      :else out)]
            (str "[IMPORTANT: Background process " sid " " (completion-status evt)
                 " (exit code " exit signal ").\n"
                 attribution "Command: " cmd "\nOutput:\n" out "]")))))))

(defn notification-batch-text
  "Hermes `ProcessNotificationBatch.render`: consecutive completions enter the
  conversation as one batch — a single notice as-is, several under one header.
  Events consumed since the drain are dropped at render time."
  [pairs]
  (let [live (vec (for [[evt text] pairs
                        :when (not (is-completion-consumed? (get evt "session_id" "")))]
                    text))]
    (cond
      (empty? live) nil
      (= 1 (count live)) (first live)
      :else (str/join "\n\n"
                      (cons (str "[IMPORTANT: " (count live) " background processes completed. "
                                 "Treat these results as one batch and give one consolidated response; "
                                 "preserve failures and actionable results.]")
                            live)))))

(defn drain-notifications!
  "Hermes `ProcessRegistry.drain_notifications`: pop pending events and return
  `[event text]` pairs, formatted with `format-completion-notification`.
  Routing (`_owns_event`): an event that carries a `session_key` needs positive
  proof of ownership — it is consumed only by a drainer with the same key and
  re-queued for its owner otherwise; an unkeyed event goes to whichever agent
  drains first (Hermes' legacy single-session behavior). Exits already consumed
  via wait/log are skipped; a read-only poll observation is skipped too unless
  `skip-poll-observed?` is false (the CLI agent path passes true). Subagent-owned
  notices (`sub-…` owner) are dropped — NOT requeued — unless `surface-child?`:
  the delegation result is the deliverable."
  [{:keys [session-key skip-poll-observed? surface-child?]
    :or {skip-poll-observed? true surface-child? false}}]
  (let [key (str (or session-key ""))
        kept (atom [])
        out (atom [])]
    (doseq [evt @completion-queue]
      (let [evt-key (str (or (get evt "session_key") ""))]
        (cond
          (and (not (str/blank? evt-key)) (not (str/blank? key)) (not= evt-key key))
          (swap! kept conj evt)

          (and (= "completion" (get evt "type" "completion"))
               (or (contains? @completion-consumed (get evt "session_id"))
                   (and skip-poll-observed? (contains? @poll-observed (get evt "session_id")))))
          nil

          (and (child-notification? evt) (not surface-child?))
          nil

          :else (swap! out conj [evt (format-completion-notification evt)]))))
    (reset! completion-queue @kept)
    @out))

(defn group-process-notifications
  "Hermes `process_registry_notifications.group_process_notifications`,
  verbatim: group consecutive completions only; watches, heartbeats and
  delegations are barriers. Returns vectors of `[event text]` pairs."
  [notifications]
  (let [groups (atom [])
        batch (atom [])]
    (doseq [[evt text] notifications]
      (if (= "completion" (get evt "type" "completion"))
        (swap! batch conj [evt text])
        (do (when (seq @batch)
              (swap! groups conj @batch)
              (reset! batch []))
            (swap! groups conj [[evt text]]))))
    (when (seq @batch) (swap! groups conj @batch))
    @groups))

(defn pending-notification-messages
  "This run's owned process notices as Hermes delivers them: one message per
  `group_process_notifications` group — a completion batch rendered by
  `notification-batch-text`, a watch/heartbeat event as its own message (the
  CLI's `_pending_input.put` per group)."
  [opts]
  (vec (keep (fn [group]
               (let [evt (first (first group))]
                 (if (= "completion" (get evt "type" "completion"))
                   (notification-batch-text group)
                   (second (first group)))))
             (group-process-notifications (drain-notifications! opts)))))

(defn pending-notification-text
  "The pending messages joined with a blank line. Callers that must keep
  Hermes' one-message-per-group boundary use `pending-notification-messages`."
  [opts]
  (let [msgs (pending-notification-messages opts)]
    (when (seq msgs) (str/join "\n\n" msgs))))

;; ---- one-shot exit linger (Hermes wait_for_pending_completions) ----
;; A one-shot CLI run (`-z`) exits when its turn ends; a `notify_on_complete`
;; background process it spawned still holds pipes owned by the dying parent.
;; Only `notify_on_complete` processes carry a completion contract —
;; servers/daemons/watchers aren't the parent's to wait for.

(defn- reconcile-local-exit!
  "Hermes `ProcessRegistry._reconcile_local_exit`, Node mapping: reconcile
  `:state` against the real child. Node fires `exit` when the direct child dies
  but `close` only once its stdio streams close — a descendant that inherited
  the pipe holds `close` exactly as it held Python's reader (issue #17327's
  orphaned pipe), and `poll()`/state would report \"running\" forever.
  `child.exitCode` / `child.signalCode` are the `Popen.poll()` equivalent: once
  set while the session is still running, book the exit (`finish!`, the
  `_move_to_finished` equivalent that publishes the completion). No-op for
  exited and detached sessions."
  [session]
  (when (and session (not (:detached? session)) (= :running @(:state session)))
    (when-let [child (:child session)]
      (let [code (.-exitCode child)
            sig (.-signalCode child)
            exit (cond
                   (number? code) code
                   (string? sig) (- (or (signal-number sig) 1)))]
        (when exit
          (let [killed @(:killed-by session)]
            (finish! session exit
                     (if killed "killed" "exited")
                     (str (or killed "")) nil
                     (:on-exit session) (:tmpdir session))))))))

(def oneshot-completion-wait-seconds-default
  "Hermes `hermes_cli.config_defaults` `terminal.oneshot_completion_wait_seconds`
  and `ProcessRegistry._config_seconds`'s fallback."
  600.0)

(defn oneshot-completion-wait-seconds
  "Hermes `ProcessRegistry._oneshot_completion_wait_seconds` via
  `_config_seconds(key, 600.0)`: `terminal.oneshot_completion_wait_seconds` as
  a non-negative number (0 disables), clamped at zero; the default when the
  value is unset or unparseable. Booleans count as 1.0/0.0 and numeric strings
  parse, as Python `float()` does there. (Kotoba additionally falls back on a
  NaN parse — where Python `float(\"nan\")` yields `nan` — so a garbage config
  can never wedge the linger.)"
  [config]
  (let [raw (get-in (or config {}) ["terminal" "oneshot_completion_wait_seconds"])
        v (cond
            (nil? raw) oneshot-completion-wait-seconds-default
            (number? raw) (double raw)
            (boolean? raw) (if raw 1.0 0.0)
            (string? raw) (let [s (str/trim raw)]
                            (cond
                              (re-matches #"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?" s) (js/Number s)
                              (contains? #{"inf" "+inf" "-inf" "infinity" "+infinity" "-infinity"}
                                         (str/lower-case s)) (if (str/starts-with? s "-") js/-Infinity js/Infinity)
                              :else oneshot-completion-wait-seconds-default))
            :else oneshot-completion-wait-seconds-default)]
    (if (js/Number.isNaN v)
      oneshot-completion-wait-seconds-default
      (js/Math.max v 0))))

(defn- pending-completion-sessions
  "Hermes `wait_for_pending_completions`'s pending set: `notify_on_complete`
  sessions whose completion event is not yet set (running AND just-finished —
  `_move_to_finished` moves the session before its publish lands), optionally
  scoped by `owner_task_id`. Ordered by start time = Python's dict insertion
  order over `_running` then `_finished`."
  [task-id]
  (->> @sessions
       vals
       (filter (fn [s] (and @(:notify-on-complete? s)
                            (not @(:completion-event? s))
                            (or (nil? task-id)
                                (= (str task-id) @(:owner-task-id s))))))
       (sort-by :started-at)
       vec))

(defn wait-for-pending-completions!
  "Hermes `ProcessRegistry.wait_for_pending_completions`, verbatim semantics:
  bounded linger for `notify_on_complete` background processes at one-shot
  exit. `task-id` nil waits on every tracked process; `timeout` is seconds and
  nil reads `terminal.oneshot_completion_wait_seconds` (<= 0 disables). Each
  pass re-reconciles child state (`reconcile-local-exit!` then
  `refresh-detached!`) so an orphaned-pipe exit cannot wedge the linger; a
  session that timed out is waited on no further. Resolves to
  `{\"waited\" \"completed\" \"timed_out\"}` id lists — `\"waited\"` empty (and
  the call immediate) when nothing is pending or the timeout disables the wait.
  Hermes' KeyboardInterrupt branch has no Node equivalent (the CLI dies on
  SIGINT instead of raising into the linger)."
  [{:keys [task-id timeout poll-interval config]}]
  (let [timeout (double (if (some? timeout) timeout (oneshot-completion-wait-seconds config)))
        timeout (if (js/Number.isNaN timeout) 0.0 timeout)
        pending (pending-completion-sessions task-id)]
    (if (or (empty? pending) (<= timeout 0))
      (p/resolved {"waited" [] "completed" [] "timed_out" []})
      (let [deadline (+ (h/now-ms) (* 1000 (max timeout 0.0)))
            interval (max (double (or poll-interval 1.0)) 0.05)]
        (p/loop [remaining (seq pending)
                 completed []
                 timed-out []]
          (if-let [s (first remaining)]
            (p/let [done? (p/loop []
                            (cond
                              @(:completion-event? s) (p/resolved true)
                              (<= (- deadline (h/now-ms)) 0) (p/resolved false)
                              :else (p/let [_ (do (reconcile-local-exit! s)
                                                  (refresh-detached! s))]
                                      (if @(:completion-event? s)
                                        (p/resolved true)
                                        (p/let [remaining-s (/ (max (- deadline (h/now-ms)) 0) 1000)
                                                _ (p/delay (* 1000 (min remaining-s interval)))]
                                          (p/recur))))))]
              (p/recur (next remaining)
                       (if done? (conj completed (:id s)) completed)
                       (if done? timed-out (conj timed-out (:id s)))))
            (p/resolved {"waited" (mapv :id pending)
                         "completed" completed
                         "timed_out" timed-out})))))))
