(ns itonami.agent.notepad
  "Per-job durable KV notepad (cursors, watermarks) carried across cron
  wake-ups -- the HOST-ADAPTER splice of the notepad surface (trench 3):
  the node:sqlite implementation is replaced by delegation to the kotoba
  modules (itonami.notepad / itonami.notepad-render), which are the guest
  implementation proven node-free in the guest VM (boot101-106: index-free
  listing, the 64KB total, the CLI verbs, clear).

  Same documented caps: 16KB per value, 128 characters per key, 64KB per
  job in total. Oversized writes fail and leave the store untouched.

  API drift measured (the subset has no exceptions, maps, or vectors of
  maps -- recorded, not papered over):
    set-note           -> 1 ok / 0 refused (was: row map or throw)
    get-note           -> value, empty when unset (was: value or nil; an
                          empty value and an absent key are one shape now)
    delete-note        -> 1 / 0 (was: boolean)
    list-notes         -> the sorted keys string, newline-joined (was: a
                          vector of maps)
    clear-notepad      -> the count cleared (was: silent)
    render-notepad-section -> unchanged contract (byte-exact section, the
                          empty string when the notepad is empty)

  The callers (main.cljk cron notepad verbs, cron.cljk clear/render) keep
  the function names and splice at their own trench; the store shape moves
  from one SQLite table to one file per key under base, so no job data
  crosses the cut."
  (:require [itonami.notepad :as np]
            [itonami.notepad-render :as nr])
  (:export [db-path set-note get-note delete-note list-notes clear-notepad
            render-notepad-section]))

(defn db-path [home :string] :string home)

(defn- base-of [home :string job-id :string] :string home)

(defn set-note [home :string job-id :string key :string value :string] :i64
  (np/notepad-set (base-of home job-id) key value))

(defn get-note [home :string job-id :string key :string] :string
  (np/notepad-get (base-of home job-id) key))

(defn delete-note [home :string job-id :string key :string] :i64
  (np/notepad-delete (base-of home job-id) key))

(defn list-notes [home :string job-id :string] :string
  (nr/note-keys (base-of home job-id)))

(defn clear-notepad [home :string job-id :string] :i64
  (np/notepad-clear (base-of home job-id)))

(defn render-notepad-section [home :string job-id :string] :string
  (nr/render-notes (base-of home job-id) job-id))
