(ns itonami.agent.execution-ledger
  "The execution ledger + incidents -- the HOST-ADAPTER splice of this
  surface (trench 3): the node:sqlite implementation is replaced by
  delegation to itonami.ledger and itonami.incidents (the guest
  implementations proven node-free).

  API drift measured (the subset has no exceptions, maps, or sets --
  recorded, not papered over):
    claim!                   -> [home job-id id source] -- the caller
                                supplies the execution id (was: generated
                                inside via random-hex) and a job-id string
                                (was: the job map). Answers the lg-claim
                                code.
    mark-handoff-pending!    -> [home job-id id owner-ok] (was: the owner
                                decision computed inside)
    adopt-claimed!           -> [home job-id id grace-ok] (was: the grace
                                computed inside from the config clock)
    mark-running!            -> [home job-id id]
    finish!                  -> [home job-id id status error] where status
                                is the vocabulary code (was: success? +
                                delivery-outcome, three shapes)
    set-delivery-outcome!    -> [home job-id id outcome]
    rows                     -> rows-count / rows-active (was: a vector of
                                row maps for status display)
    upsert-incident!         -> [home job-id incident-id failure] -- the
                                error-to-failure-type normalization moved
                                to the caller side (was: error text +
                                output-file, normalized inside)
    upsert-incident-for-failure! -> NOT carried: its repeat-alert policy
                                reads a config map, which the subset
                                cannot express; the primitives (inc-upsert
                                / inc-recurrences / inc-alert) carry the
                                behavior at the caller trench
    get-incident             -> the inc-get-state code (was: a row map)
    incidents                -> incidents-recurrences [home incident-id]
                                (was: listing every incident row)
    ack-incident! / mark-incident-alerted! / resolve-incidents! -> inc-ack
                                / inc-alert / inc-resolve-job
    handoff-adoption-grace-seconds / default-failure-repeat-alert-hours
                           -> zero-arg functions returning the constants
                                (exports must be functions)

  finished_at / pid / process columns and the incident row maps are not
  carried. The callers keep the names where they exist and splice at their
  own trench."
  (:require [itonami.ledger :as lg]
            [itonami.incidents :as inc])
  (:export [db-path claim! mark-handoff-pending! adopt-claimed! mark-running!
            finish! set-delivery-outcome! rows-count rows-active
            upsert-incident! resolve-incidents! get-incident ack-incident!
            mark-incident-alerted! incidents-recurrences
            handoff-adoption-grace-seconds default-failure-repeat-alert-hours]))

(defn db-path [home :string] :string home)

(defn- base-of [home :string] :string home)

(defn handoff-adoption-grace-seconds [] :i64 300)

(defn default-failure-repeat-alert-hours [] :string "6.0")

(defn claim! [home :string job-id :string id :string source :string] :i64
  (lg/lg-claim (base-of home) job-id id source))

(defn mark-handoff-pending! [home :string job-id :string id :string owner-ok :i64] :i64
  (lg/lg-mark-handoff (base-of home) job-id id owner-ok))

(defn adopt-claimed! [home :string job-id :string id :string grace-ok :i64] :i64
  (lg/lg-adopt (base-of home) job-id id grace-ok))

(defn mark-running! [home :string job-id :string id :string] :i64
  (lg/lg-mark-running (base-of home) job-id id))

(defn finish! [home :string job-id :string id :string status :i64 error :string] :i64
  (lg/lg-finish (base-of home) job-id id status error))

(defn set-delivery-outcome! [home :string job-id :string id :string outcome :string] :i64
  (lg/lg-set-outcome (base-of home) job-id id outcome))

(defn rows-count [home :string job-id :string] :i64
  (lg/lg-row-count (base-of home) job-id))

(defn rows-active [home :string job-id :string] :i64
  (lg/lg-active-count (base-of home) job-id))

(defn upsert-incident! [home :string job-id :string incident-id :string failure :string] :i64
  (inc/inc-upsert (base-of home) incident-id job-id failure))

(defn resolve-incidents! [home :string job-id :string] :i64
  (inc/inc-resolve-job (base-of home) job-id))

(defn get-incident [home :string incident-id :string] :i64
  (inc/inc-get-state (base-of home) incident-id))

(defn ack-incident! [home :string incident-id :string] :i64
  (inc/inc-ack (base-of home) incident-id))

(defn mark-incident-alerted! [home :string incident-id :string] :i64
  (inc/inc-alert (base-of home) incident-id))

(defn incidents-recurrences [home :string incident-id :string] :i64
  (inc/inc-recurrences (base-of home) incident-id))
