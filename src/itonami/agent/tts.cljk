(ns itonami.agent.tts
  "Hermes text_to_speech, slice 1: provider-backed synthesis over an
  OpenAI-compatible /audio/speech endpoint, on the same hop resolution the
  chat chain uses. Config `tts.provider` / `tts.model` / `tts.voice`; an
  unset piece is a NAMED error — nothing is inferred (the voice defaults to
  alloy only once the rest is configured). Audio bytes land in the profile
  workspace and the result names the file.
  (Hermes' local/command providers, streaming and speaker routing are later
  slices.)"
  (:require [clojure.string :as str]
            ["node:fs" :as fs]
            [promesa.core :as p]
            [itonami.agent.host :as h]
            [itonami.agent.provider :as provider]))

(defn configured
  "The tts settings from config, or nil when incomplete: provider AND model
  are required; voice defaults to `alloy` only once the rest is configured."
  [config]
  (let [c (get config "tts")]
    (when-not (or (str/blank? (str (get c "provider")))
                  (str/blank? (str (get c "model"))))
      {:provider (str (get c "provider"))
       :model (str (get c "model"))
       ;; blank counts as unset, as everywhere else in this module
       :voice (let [v (str (get c "voice"))] (if (str/blank? v) "alloy" v))})))

(defn speech-request
  "The /audio/speech request (pure): one hop -> {url headers body}. The
  response is audio bytes, so the body carries the OpenAI speech fields and
  the hop's headers ride along."
  [hop voice text format]
  {:url (str (:base-url hop) "/audio/speech")
   ;; Content-Type is REQUIRED: FastAPI-based OpenAI-compatible servers
   ;; (vLLM and friends) answer 422 to a JSON body sent as text/plain
   :headers (cond-> (assoc (or (:headers hop) {}) "Content-Type" "application/json")
              (not (str/blank? (str (:token hop)))) (assoc "Authorization" (str "Bearer " (:token hop))))
   :body (h/json-str {"model" (:model hop)
                      "voice" voice
                      "input" (str text)
                      "response_format" (str format)})})

(defn- safe-format
  "The response format as a filename-safe token: alphanumeric only, so a
  caller-supplied format can never escape the workspace through the path."
  [f]
  (let [s (str f)]
    (when (re-matches #"[A-Za-z0-9]+" s) s)))

(defn synthesize!
  "Run one synthesis and write the audio into <home>/workspace/tts/<sha>.<format>,
  where the hash covers text+voice+model+format+provider+base_url (same
  request, same bytes; different request, different file). Injected `fetch` for tests;
  `writable?` (a path predicate from the tool ctx) is consulted BEFORE the
  write — a path outside the permitted roots is refused, exactly as
  write-file does (a nil predicate means ungated — legacy 4-arg call sites
  bind it to nil under kbb/SCI). Resolves
  to a map naming path and format, or a map
  naming the error — a named outcome either way, never a guessed artifact."
  ([config home args fetch] (synthesize! config home args fetch nil))
  ([config home {:strs [text voice model] :as args} fetch writable?]
  ;; `format` is pulled by key — destructuring it would shadow clojure.core
  (let [cfg (configured config)
        fmt-in (let [f (str (get args "format"))] (if (str/blank? f) "mp3" f))
        fmt (safe-format fmt-in)
        voice (let [v (str voice)] (if (str/blank? v) (get cfg :voice) v))
        model (let [m (str model)] (if (str/blank? m) (get cfg :model) m))]
    (cond
      (nil? cfg)
      (p/resolved {"error" "text_to_speech is not configured (tts.provider and tts.model are required)"})

      (str/blank? (str text))
      (p/resolved {"error" "text is required"})

      (nil? fmt)
      (p/resolved {"error" (str "format must be alphanumeric, got " (pr-str fmt-in))})

      :else
      (let [hop (provider/resolve-hop config {"provider" (:provider cfg) "model" model})
            key-env (:key-env hop)
            token (when-not (str/blank? (str key-env)) (h/env key-env))]
        (cond
          (str/blank? (str (:base-url hop)))
          (p/resolved {"error" (str "provider " (:provider cfg) " has no base_url configured")})

          (and (not (str/blank? (str key-env))) (str/blank? (str token)))
          (p/resolved {"error" (str "missing credentials: env " key-env " is unset")})

          :else
          (let [req (speech-request (assoc hop :token token) voice text fmt)
                out-dir (h/join home "workspace" "tts")
                ;; json encoding is delimiter-unambiguous: distinct requests
                ;; cannot collide on one path
                ;; provider AND endpoint: re-pointing a named provider at a
                ;; different base_url is a different request -> different file
                out-path (h/join out-dir (str (h/sha256-hex (h/json-str [(str text) voice model fmt (:provider cfg) (:base-url hop)])) "." fmt))]
            (let [ctl (js/AbortController.)
                  ;; the chat-hop pattern: the controller is paired with a
                  ;; timer that ABORTS it — without the timer the signal
                  ;; never fires and the fetch stays unbounded. (The timer is
                  ;; cleared on BOTH outcomes; p/finally is avoided: it
                  ;; breaks value propagation through p/catch in this build.)
                  ;; a non-numeric request_timeout_seconds must not throw
                  ;; or NaN the delay — clamp like backoff-ms does
                  timeout-s (let [t (:timeout-s hop)]
                              (if (and (number? t) (pos? t)) t 900))
                  timer (js/setTimeout (fn [] (.abort ctl)) (* 1000 timeout-s))]
              (-> (fetch (:url req) (clj->js {:method "POST"
                                              :headers (clj->js (:headers req))
                                              :body (:body req)
                                              :signal (.-signal ctl)}))
                  (p/catch (fn [e]
                             (js/clearTimeout timer)
                             {"error" (str "speech request failed: " (or (.-message e) e))}))
                  (p/then
                   (fn [r]
                     ;; the timer is cleared at the INNERMOST completions —
                     ;; it must stay armed through the body read (.arrayBuffer),
                     ;; which is exactly where a slow drip stalls (the cited
                     ;; chat-hop pattern keeps it armed past (.text r) too)
                     (if (get r "error")
                       r
                       (if (.-ok r)
                         (-> (.arrayBuffer r)
                             (p/then
                              (fn [buf]
                                ;; the body has settled here — the timer's job
                                ;; is done on every outcome that reaches this
                                ;; point (success or write refusal)
                                (js/clearTimeout timer)
                                (try
                                  ;; the roots gate runs BEFORE the write,
                                  ;; like write-file/patch — refuse, never
                                  ;; write and then only skip bookkeeping
                                  (if (and writable? (not (writable? out-path)))
                                    {"error" "speech write refused: outside the permitted roots"}
                                    (do (h/mkdirs out-dir)
                                        ;; tmp+rename: a concurrent
                                        ;; reader never sees a
                                        ;; half-written cache file
                                        (let [tmp (str out-path ".tmp-" (.-pid js/process))]
                                          (fs/writeFileSync tmp (js/Buffer.from buf))
                                          (fs/renameSync tmp out-path))
                                        ;; the CALLER records this as a run
                                        ;; write (tools.cljk) — tts cannot
                                        ;; require tools (cycle)
                                        {"path" out-path "format" fmt}))
                                  (catch :default e
                                    (js/clearTimeout timer)
                                    {"error" (str "speech write failed: " (or (.-message e) e))}))))
                             (p/catch (fn [e]
                                        (js/clearTimeout timer)
                                        {"error" (str "speech read failed: " (or (.-message e) e))})))
                         (do (js/clearTimeout timer)
                             {"error" (str "speech request failed: HTTP " (.-status r))}))))))))))))))
