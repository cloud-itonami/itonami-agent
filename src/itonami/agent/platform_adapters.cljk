(ns itonami.agent.platform-adapters
  "Delivery adapters for messaging platforms — the sends the cron delivery
  queue hands to `delivery/register-adapter!`. One adapter per `deliver`
  lane (the platform name). The token comes from the environment (never from
  config or the job), the target chat from profile config; an unconfigured
  lane resolves to nil so the run reports `not_configured` instead of
  pretending."
  (:require [clojure.string :as str]
            [itonami.agent.host :as h]))

;; ---------------------------------------------------------------- telegram

(defn telegram-request
  "The Telegram Bot API sendMessage request this adapter makes. Pure: the
  caller owns transport and secrets. `thread-id` (a forum topic) rides as
  message_thread_id when it parses as a number."
  ([token chat-id text] (telegram-request token chat-id text nil))
  ([token chat-id text thread-id]
   (let [tid (js/parseInt (str thread-id) 10)]
     {:url (str "https://api.telegram.org/bot" token "/sendMessage")
      :body (h/json-str (cond-> {"chat_id" chat-id "text" (str text)}
                          (not (js/isNaN tid)) (assoc "message_thread_id" tid)))})))

(defn- telegram-adapter [token chat-id]
  ;; `opts :chat-id` overrides the configured target — a reply must reach the
  ;; chat it answers, never the profile's default delivery chat
  (fn [_job _lane content opts]
    (let [req (telegram-request token (or (:chat-id opts) chat-id) content (:thread-id opts))]
    (-> ((or (:fetch opts) js/fetch) (:url req)
                  #js {:method "POST"
                       :headers #js {"Content-Type" "application/json"}
                       :body (:body req)})
        (.then (fn [res]
                 (if (.-ok res)
                   nil
                   (str "telegram sendMessage failed: HTTP " (.-status res)))))
        (.catch (fn [e] (str "telegram sendMessage failed: " (.-message e))))))))


;; ---------------------------------------------------------------- slack

(defn slack-request
  "The Slack chat.postMessage request (bot token). Pure."
  [token channel text]
  {:url "https://slack.com/api/chat.postMessage"
   :headers {"Authorization" (str "Bearer " token) "Content-Type" "application/json; charset=utf-8"}
   :body (h/json-str {"channel" channel "text" (str text)})})

(defn- slack-adapter [token channel]
  (fn [_job _lane content opts]
    (let [r (slack-request token (or (:chat-id opts) channel) content)]
      (-> ((or (:fetch opts) js/fetch) (:url r) #js {:method "POST"
                          :headers (clj->js (:headers r))
                                  :body (:body r)})
          (.then (fn [res]
                   (if (.-ok res)
                     (.then (.json res)
                            (fn [j]
                              (if (aget j "ok")
                                nil
                                (str "slack chat.postMessage failed: " (or (aget j "error") "unknown error")))))
                     (str "slack chat.postMessage failed: HTTP " (.-status res)))))
          (.catch (fn [e] (str "slack chat.postMessage failed: " (.-message e))))))))

;; ---------------------------------------------------------------- discord

(defn discord-request
  "The Discord execute-webhook request. Pure. The webhook URL carries its own
  secret; it comes from config because Discord has no separate token here."
  [webhook-url text]
  {:url (str webhook-url "?wait=true")
   :body (h/json-str {"content" (str text)})})

(defn discord-bot-request
  "The Discord bot-channel message request. Pure."
  [token channel-id text]
  {:url (str "https://discord.com/api/channels/" channel-id "/messages")
   :headers {"Authorization" (str "Bot " token) "Content-Type" "application/json"}
   :body (h/json-str {"content" (str text)})})

(defn- discord-adapter [webhook-url token channel-id configured-chat]
  (fn [_job _lane content opts]
    ;; a bot-channel message honours :chat-id; a webhook has ONE fixed target
    ;; and refuses a chat it does not serve — never a silent wrong-chat send
    (let [to (str (:chat-id opts))]
      (if (and webhook-url (not (str/blank? to)) (not= to (str configured-chat)))
        (js/Promise.resolve (str "discord webhook serves chat " (str configured-chat)
                                 "; refusing reply to " to))
        (let [r (if webhook-url (discord-request webhook-url content)
                    (discord-bot-request token (or (:chat-id opts) channel-id) content))]
      (-> ((or (:fetch opts) js/fetch) (:url r) #js {:method "POST"
                                  :headers (clj->js (or (:headers r) {"Content-Type" "application/json"}))
                                  :body (:body r)})
          (.then (fn [res]
                   (if (.-ok res) nil (str "discord send failed: HTTP " (.-status res)))))
          (.catch (fn [e] (str "discord send failed: " (.-message e))))))))))

;; ---------------------------------------------------------------- mattermost

(defn mattermost-request
  "The Mattermost incoming-webhook request. Pure."
  [webhook-url text]
  {:url webhook-url
   :body (h/json-str {"text" (str text)})})

(defn- mattermost-adapter [webhook-url configured-chat]
  ;; one webhook = one chat; a reply for any other chat is refused, never
  ;; posted into the configured channel
  (fn [_job _lane content opts]
    (let [to (str (:chat-id opts))]
      (if (and (not (str/blank? to)) (not= to (str configured-chat)))
        (js/Promise.resolve (str "mattermost webhook serves chat " (str configured-chat)
                                 "; refusing reply to " to))
        (let [r (mattermost-request webhook-url content)]
      (-> ((or (:fetch opts) js/fetch) (:url r) #js {:method "POST"
                                  :headers #js {"Content-Type" "application/json"}
                                  :body (:body r)})
          (.then (fn [res]
                   (if (.-ok res) nil (str "mattermost webhook failed: HTTP " (.-status res)))))
          (.catch (fn [e] (str "mattermost webhook failed: " (.-message e))))))))))

;; ---------------------------------------------------------------- matrix

(defn matrix-request
  "The Matrix m.room.message send request. Pure. One txn id per send."
  [homeserver token room-id text]
  {:url (str (str/replace (str homeserver) #"/$" "") "/_matrix/client/v3/rooms/"
             (js/encodeURIComponent room-id) "/send/m.room.message/" (h/random-hex 12))
   :headers {"Authorization" (str "Bearer " token) "Content-Type" "application/json"}
   :body (h/json-str {"msgtype" "m.text" "body" (str text)})})

(defn- matrix-adapter [homeserver token room-id]
  (fn [_job _lane content opts]
    (let [r (matrix-request homeserver token (or (:chat-id opts) room-id) content)]
      (-> ((or (:fetch opts) js/fetch) (:url r) #js {:method "PUT"
                                  :headers (clj->js (:headers r))
                                  :body (:body r)})
          (.then (fn [res]
                   (if (.-ok res) nil (str "matrix send failed: HTTP " (.-status res)))))
          (.catch (fn [e] (str "matrix send failed: " (.-message e))))))))

;; ---------------------------------------------------------------- registry

(defn for-lane
  "The built-in adapter for a deliver lane, or nil when this lane has no
  configured platform. `config` is the profile's config.yaml map.
  telegram: token from the env named by delivery.telegram.token_env
  (default TELEGRAM_BOT_TOKEN), target chat from delivery.telegram.chat_id."
  [lane config]
  (case (str/lower-case (str lane))
    "telegram"
    (let [c (get-in config ["delivery" "telegram"])
          token-env (or (get c "token_env") "TELEGRAM_BOT_TOKEN")
          token (h/env token-env)
          chat-id (get c "chat_id")]
      (when (and (not (str/blank? (str token))) (not (str/blank? (str chat-id))))
        (telegram-adapter token chat-id)))
    "slack"
    (let [c (get-in config ["delivery" "slack"])
          token (h/env (or (get c "token_env") "SLACK_BOT_TOKEN"))
          channel (get c "channel")]
      (when (and (not (str/blank? (str token))) (not (str/blank? (str channel))))
        (slack-adapter token channel)))
    "discord"
    (let [c (get-in config ["delivery" "discord"])
          webhook (get c "webhook_url")
          token (h/env (or (get c "token_env") "DISCORD_BOT_TOKEN"))
          channel-id (get c "channel_id")]
      (cond
        (not (str/blank? (str webhook))) (discord-adapter (str webhook) nil nil (str (get c "chat_id")))
        (and (not (str/blank? (str token))) (not (str/blank? (str channel-id))))
        (discord-adapter nil token channel-id nil)))
    "mattermost"
    (let [c (get-in config ["delivery" "mattermost"])
          webhook (get c "webhook_url")]
      (when-not (str/blank? (str webhook))
        (mattermost-adapter (str webhook) (str (get c "chat_id")))))
    "matrix"
    (let [c (get-in config ["delivery" "matrix"])
          homeserver (get c "homeserver")
          token (h/env (or (get c "token_env") "MATRIX_ACCESS_TOKEN"))
          room-id (get c "room_id")]
      (when (and (not (str/blank? (str homeserver)))
                 (not (str/blank? (str token)))
                 (not (str/blank? (str room-id))))
        (matrix-adapter (str homeserver) token room-id)))
    nil))
