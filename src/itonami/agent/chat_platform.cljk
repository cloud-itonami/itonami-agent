(ns itonami.agent.chat-platform
  "Inbound messaging for the gateway — the receiving half of Hermes'
  `gateway/platforms` contract (JUN-465 slice 1).

  One platform-agnostic inbound message flows through: normalize (a raw
  transport update -> a turn-carrying message or nil) -> intake guards
  (dedup, size) -> chat -> profile routing (an unresolved identity is DROPPED
  with one warning, never keyed into another profile) -> a serial per-chat
  dispatch (busy chats queue, as `platforms/base.py::_pending_messages`) ->
  a turn on the owning profile -> the reply through the platform's existing
  send adapter.

  The transport (long poll / webhook) and the turn run are injected, so a new
  platform is one `platform-adapters` entry plus one `normalize` entry here.
  History is the user/assistant transcript the CLJK turn API takes as
  `:history` (`loop/history-messages` shape: {\"role\" \"content\"})."
  (:require [clojure.string :as str]
            [promesa.core :as p]
            [itonami.agent.host :as h]
            [itonami.agent.platform-adapters :as platforms]))

;; ---------------------------------------------------------------- normalize

(defn telegram-normalize
  "Hermes `gateway/platforms/telegram.py`: one `getUpdates` entry -> the
  platform-agnostic inbound message, or nil when the update carries no turn
  (non-message updates, edited messages, non-text messages)."
  [raw]
  (let [m (get raw "message")]
    (when (and m (string? (get m "text")))
      {"update_id" (str (get raw "update_id"))
       "platform" "telegram"
       "chat_id" (str (get-in m ["chat" "id"]))
       "user_id" (str (get-in m ["from" "id"]))
       "user_name" (str (or (get-in m ["from" "username"])
                            (get-in m ["from" "first_name"]) ""))
       "thread_id" (str (or (get m "message_thread_id") ""))
       "message_id" (str (get m "message_id"))
       "text" (get m "text")})))

(defn feishu-normalize
  "Feishu im.message.receive_v1 webhook event -> the platform-agnostic
  inbound message, or nil when the event carries no turn (other event
  types, non-text messages). The text content is a JSON string."
  [raw]
  (let [m (get-in raw ["event" "message"])]
    (when (and (= "im.message.receive_v1" (get-in raw ["header" "event_type"]))
               m
               (= "text" (get m "message_type")))
      (let [content (try (h/json-parse (str (get m "content"))) (catch :default _ nil))]
        (when (string? (get content "text"))
          {"update_id" (str (or (get-in raw ["header" "event_id"]) (get m "message_id")))
           "platform" "feishu"
           "chat_id" (str (get m "chat_id"))
           "user_id" (str (get-in raw ["event" "sender" "sender_id" "open_id"]))
           "user_name" (str (or (get-in raw ["event" "sender" "sender_id" "open_id"]) ""))
           "thread_id" (str (or (get m "thread_id") ""))
           "message_id" (str (get m "message_id"))
           "text" (get content "text")})))))

(defn dingtalk-normalize
  "DingTalk robot callback event -> the platform-agnostic inbound message,
  or nil when the event carries no turn (non-text messages). The dedup key
  needs a UNIQUE id: msgId, else createAt — and with neither, the turn is
  REFUSED (the R1 gate: a type-string fallback like msgtype collides and
  the intake guard silently drops distinct turns)."
  [raw]
  (let [m (get raw "text")
        uid (let [a (get raw "msgId")] (if (str/blank? (str a)) (get raw "createAt") a))]
    (when (and m (string? (get m "content")) (not (str/blank? (str uid))))
      {"update_id" (str uid)
       "platform" "dingtalk"
       ;; chat_id is the reply ROUTE: oToMessages/batchSend addresses
       ;; userIds — a user identifier — so the reply lands on the SENDER,
       ;; not the conversation (the R2 round-trip gate). The conversation
       ;; id rides along as the thread.
       "chat_id" (str (or (get raw "senderStaffId") ""))
       "user_id" (str (or (get raw "senderStaffId") ""))
       "user_name" (str (or (get raw "senderNick") ""))
       "thread_id" (str (or (get raw "conversationId") ""))
       "message_id" (str (or (get raw "msgId") ""))
       "text" (get m "content")})))

(defn wecom-normalize
  "WeCom message-push callback (JSON) -> the platform-agnostic inbound
  message, or nil when the event carries no turn. The dedup id needs a
  UNIQUE value (MsgId, else CreateTime) — the dingtalk R1 lesson: a
  type-string fallback silently drops distinct turns. chat_id is the
  REPLY route (FromUserName — the user id message/send's touser speaks),
  per the dingtalk R2 lesson."
  [raw]
  (let [uid (let [a (get raw "MsgId")] (if (str/blank? (str a)) (get raw "CreateTime") a))]
    (when (and (= "text" (get raw "MsgType"))
               (string? (get raw "Content"))
               (not (str/blank? (str uid))))
      {"update_id" (str uid)
       "platform" "wecom"
       "chat_id" (str (get raw "FromUserName"))
       "user_id" (str (get raw "FromUserName"))
       "user_name" (str (or (get raw "FromUserName") ""))
       "thread_id" (str (or (get raw "ConversationId") ""))
       "message_id" (str (or (get raw "MsgId") ""))
       "text" (get raw "Content")})))

(defn whatsapp-normalize
  "WhatsApp Cloud API webhook entry -> the platform-agnostic inbound
  message, or nil when the event carries no turn. The dedup id needs a
  UNIQUE value (the wamid message id, else timestamp) — the dingtalk R1
  lesson. chat_id is the REPLY route (the sender phone number — the `to`
  vocabulary), per the dingtalk R2 lesson."
  [raw]
  (let [msg (get-in raw ["entry" 0 "changes" 0 "value" "messages" 0])
        uid (let [a (get msg "id")] (if (str/blank? (str a)) (get msg "timestamp") a))]
    (when (and msg (= "text" (get msg "type")) (string? (get-in msg ["text" "body"]))
               (not (str/blank? (str uid))))
      {"update_id" (str uid)
       "platform" "whatsapp"
       "chat_id" (str (get msg "from"))
       "user_id" (str (get msg "from"))
       "user_name" (str (or (get-in raw ["entry" 0 "changes" 0 "value" "contacts" 0 "profile" "name"]) ""))
       "thread_id" ""
       "message_id" (str (or (get msg "id") ""))
       "text" (get-in msg ["text" "body"])})))

(def platform-adapters
  "One entry per platform. `:normalize` turns one raw transport update into
  the inbound message map above (nil = carries no turn). The send half lives
  in `itonami.agent.platform-adapters/for-lane`. A second platform is one
  entry here — nothing else changes."
  {"telegram" {:normalize telegram-normalize}
   "feishu" {:normalize feishu-normalize}
   "dingtalk" {:normalize dingtalk-normalize}
   "wecom" {:normalize wecom-normalize}
   "whatsapp" {:normalize whatsapp-normalize}})

(defn normalize
  "The inbound message in `raw` for `platform`, or nil."
  [platform raw]
  (when-let [f (get-in platform-adapters [platform :normalize])]
    (f raw)))

;; ---------------------------------------------------------------- guards

(def max-text-chars
  "Intake guard: the longest inbound text a turn will be built from."
  8000)

(def max-seen-updates
  "Intake guard: how many update ids per platform are remembered for dedup."
  512)

(defn- err-str
  "A rejection's message text — `(.-message e)` is undefined for non-Error
  rejections."
  [e]
  (str (or (.-message e) e)))

(defn guard-message
  "Hermes' intake guards (the base adapter side): a message already seen is
  dropped, an empty or oversized text is dropped. Returns `{:ok msg}` or
  `{:drop reason}` — a drop is silent to the sender, one line to the log."
  [seen msg]
  (let [uid (str (get msg "platform") ":" (get msg "update_id"))]
    (cond
      (some #(= uid %) @seen) {:drop "duplicate"}
      (or (str/blank? (str (get msg "chat_id"))) (str/blank? (str (get msg "user_id"))))
      {:drop "empty-identity"}
      (str/blank? (str (get msg "text"))) {:drop "empty"}
      (< max-text-chars (count (str (get msg "text")))) {:drop "oversized"}
      :else (do (swap! seen (fn [s]
                              (let [s (conj (vec (or s [])) uid)]
                                (if (< max-seen-updates (count s))
                                  (subvec s (- (count s) max-seen-updates))
                                  s))))
                {:ok msg}))))

;; ---------------------------------------------------------------- routing

(defn route-chat
  "Which profile owns this chat. A chat is owned by the profile whose delivery
  config names it (`delivery.<platform>.chat_id`) or by an explicit
  `gateway.routes` entry (\"<platform>:<chat-id>\" -> profile name).
  Returns the profile name, or nil — an unresolved identity is dropped, as
  Hermes drops an unroutable event instead of keying it into another profile."
  [profiles msg]
  (let [platform (get msg "platform")
        chat (get msg "chat_id")
        explicit (reduce (fn [acc prof]
                           (or acc (get-in (:config prof) ["gateway" "routes" (str platform ":" chat)])))
                         nil profiles)]
    (or explicit
        (some (fn [prof]
                (when (= (str (get-in (:config prof) ["delivery" platform "chat_id"])) (str chat))
                  (:name prof)))
              profiles))))

;; ---------------------------------------------------------------- history

(defn- history-path [home platform chat-id]
  ;; both segments are sanitized: neither may escape home/chat
  (h/join home "chat" (str (str/replace (str platform) #"[^A-Za-z0-9_-]" "_") "-"
                           (str/replace (str chat-id) #"[^A-Za-z0-9_-]" "_") ".jsonl")))

(defn load-history
  "The chat's user/assistant transcript ({\"role\" \"content\"} rows), newest
  last, capped at `limit` rows."
  ([home platform chat-id] (load-history home platform chat-id 100))
  ([home platform chat-id limit]
   (let [f (history-path home platform chat-id)]
     (if (h/file? f)
       (->> (str/split-lines (h/slurp f))
            (remove str/blank?)
            (map #(h/json-parse %))
            (take-last limit)
            vec)
       []))))

(defn append-history!
  "Append rows to the chat's transcript. Rows only — tool rows stay scoped to
  the turn that produced them (the CLJK turn API keeps the user/assistant
  transcript between requests, nothing else)."
  [home platform chat-id rows]
  (when (seq rows)
    (let [f (history-path home platform chat-id)
          prior (if (h/file? f) (h/slurp f) "")]
      (h/mkdirs (h/join home "chat"))
      (h/spit-atomic f (str prior (str/join "" (for [r rows] (str (h/json-str r) "\n"))))))))

;; ---------------------------------------------------------------- dispatch

(defn make-dispatcher
  "The per-chat dispatch: normalize -> guard -> route -> queue -> turn ->
  reply. One turn per chat at a time; a message that arrives mid-turn waits in
  that chat's queue (Hermes `platforms/base.py::_pending_messages`), never
  interleaved.

  Injected:
    `profiles`    seq of {:name :config :home} — the routable profiles
    `executor`    (fn [prof prompt opts] -> promise of the loop result map)
    `run-opts`    (fn [prof msg] -> the turn's run options)
    `send!`       (fn [prof msg text] -> promise) — the reply, via the platform's
                  send adapter
    `on-event`    optional (fn [event]) log hook (:drop / :unrouted / :turn /
                  :turn-error)

  Returns a fn: (dispatch platform raw) -> a promise that resolves when THIS
  message's turn and reply finished — including when it waited in the chat's
  queue — with {:status :dropped|:unrouted|:replied|:send-failed|:turn-failed ...}.
  The transport update carries no platform label — the caller names the
  platform it received the update from."
  [{:keys [profiles executor run-opts send! on-event]}]
  (let [seen (atom #{})
        state (atom {:queues {} :busy #{}})
        emit (fn [e] (when on-event (on-event e)))
        chat-key (fn [m] (str (get m "platform") ":" (get m "chat_id")))
        run-one (fn [msg]
                  (let [platform (get msg "platform")
                        chat-id (get msg "chat_id")
                        prof-name (route-chat profiles msg)
                        prof (some #(when (= (:name %) prof-name) %) profiles)]
                    (if-not prof
                      (do (emit {:event :unrouted :msg (select-keys msg ["platform" "chat_id" "user_id"])})
                          (p/resolved {:status :unrouted}))
                      (let [home (:home prof)
                            prior (load-history home platform chat-id)]
                        (-> (executor prof (get msg "text")
                                      (assoc (run-opts prof msg) :history prior))
                            (p/then (fn [r]
                                      (let [final (or (:final r) (str "[" (:exit-reason r) "]"))]
                                        ;; persist the transcript as role/content rows
                                        (append-history! home platform chat-id
                                                         [{"role" "user" "content" (get msg "text")}
                                                          {"role" "assistant" "content" final}])
                                        (emit {:event :turn :msg msg :exit-reason (:exit-reason r)})
                                        (if (= "completed" (:exit-reason r))
                                          (-> (send! prof msg final)
                                              (p/then (fn [res]
                                                        (if (nil? res)
                                                          {:status :replied :reply final}
                                                          {:status :send-failed :reply final :error (str res)})))
                                              (p/catch (fn [e]
                                                         {:status :send-failed :reply final :error (err-str e)})))
                                          (-> (send! prof msg (str "The turn failed: " (:exit-reason r)
                                                              (when-let [e (get-in r [:error :error])] (str " — " e))))
                                              (p/then (fn [res]
                                                        {:status :turn-failed :exit-reason (:exit-reason r)
                                                         :notice (if (nil? res) :delivered (str res))}))
                                              (p/catch (fn [e]
                                                         {:status :turn-failed :exit-reason (:exit-reason r)
                                                          :notice (str (err-str e))})))))))
                            (p/catch (fn [e]
                                       (emit {:event :turn-error :msg msg :error (err-str e)})
                                       (p/resolved {:status :turn-failed :error (err-str e)}))))))))
        pop-next! (fn [k]
                    ;; atomic: one compare-and-set takes the head, never a
                    ;; side effect inside swap!
                    (loop []
                      (let [st @state
                            q (get-in st [:queues k])
                            nxt (first q)]
                        (if (nil? nxt)
                          nil
                          (if (compare-and-set! state st (assoc-in st [:queues k] (vec (rest q))))
                            nxt
                            (recur))))))
        claim! (fn [k]
                 ;; true = this caller owns the chat's pump
                 (loop []
                   (let [st @state]
                     (cond
                       (contains? (:busy st) k) false
                       (compare-and-set! state st (update st :busy conj k)) true
                       :else (recur)))))
        release! (fn [k]
                   ;; one atomic transition: drop the claim only while the
                   ;; queue is empty. true = released; false = a message
                   ;; arrived meanwhile and the claim is kept.
                   (loop []
                     (let [st @state]
                       (cond
                         (seq (get-in st [:queues k])) false
                         (compare-and-set! state st (update st :busy disj k)) true
                         :else (recur)))))
        pump! (fn pump! [k]
                (if-let [{:keys [msg res-fn]} (pop-next! k)]
                  ;; run-one enters through a promise boundary: a synchronous
                  ;; throw (corrupt history, a bad injected fn) becomes a
                  ;; rejection the catch below answers — never a hung caller
                  (-> (p/resolved nil)
                      (p/then (fn [_] (run-one msg)))
                      (p/then (fn [r] (res-fn r) (pump! k)))
                      (p/catch (fn [e]
                                 (res-fn {:status :turn-failed :error (err-str e)})
                                 (pump! k))))
                  (when-not (release! k)
                    (pump! k))))]
    ;; dispatch resolves when THIS message's turn (and reply) finished, even
    ;; when it waited behind another message in the same chat
    (fn dispatch [platform raw]
      (let [msg (normalize platform raw)]
        (if (nil? msg)
          (let [reason (if (contains? platform-adapters platform) "no-turn" "unknown-platform")]
            (emit {:event :drop :reason reason})
            (p/resolved {:status :dropped :reason reason}))
          (let [g (guard-message seen msg)]
            (if (:drop g)
              (do (emit {:event :drop :reason (:drop g)})
                  (p/resolved {:status :dropped :reason (:drop g)}))
              (let [k (chat-key msg)
                    res-fn (atom nil)
                    done (js/Promise. (fn [res] (reset! res-fn res)))]
                (swap! state update-in [:queues k] (fnil conj []) {:msg msg :res-fn @res-fn})
                (when (claim! k)
                  (pump! k))
                done))))))))

;; ---------------------------------------------------------------- telegram

(defn telegram-poll!
  "One `getUpdates` long poll. `fetch` is injected (tests pass a fake); the
  body is Hermes' shape (`ok` / `result`). Returns {:updates [...] :offset n}
  where `offset` is the next `update_id` to ask for."
  [{:keys [fetch token offset timeout]}]
  (let [url (str "https://api.telegram.org/bot" token "/getUpdates?timeout="
                 (or timeout 25) "&offset=" (or offset 0))]
    (-> (fetch url #js {:method "GET"})
        (p/then (fn [res] (if (.-ok res) (.text res) (js/Promise.reject (js/Error. (str "getUpdates failed: HTTP " (.-status res)))))))
        (p/then (fn [body]
                  (let [data (h/json-parse body)
                        updates (vec (get data "result"))]
                    (let [ids (keep (fn [u]
                                      (let [n (js/parseInt (str (get u "update_id")) 10)]
                                        (when-not (js/isNaN n) n)))
                                    updates)]
                      {:updates updates
                       :offset (if (seq ids)
                                 (inc (apply max ids))
                                 (or offset 0))}))))
        (p/catch (fn [e] {:error (err-str e) :updates [] :offset (or offset 0)})))))

(defn telegram-token
  "The bot token for a telegram session, resolved through the single source
  (platform-adapters/token-env-name). nil = not configured."
  [config]
  (let [token (h/env (platforms/token-env-name "telegram" config))]
    (when-not (str/blank? (str token)) (str token))))

(defn backoff-ms
  "The poll-error backoff in milliseconds: a finite positive interval floored
  at 1000 and capped at 600000 — a NaN or zero backoff would hot-loop the
  platform's API, and Node's setTimeout collapses delays above 2^31-1 ms to
  ~1 ms (the same hot loop from the other side). Anything unparseable falls
  back to 5000."
  [interval]
  (let [n (if (number? interval) interval (js/parseFloat (str interval)))]
    (if (and (js/isFinite n) (pos? n))
      (min 600000 (max 1000 (js/Math.floor n)))
      5000)))

(defn- read-offset
  "The last consumed getUpdates offset from `file`, or 0. Best-effort: a
  missing or corrupt file restarts at 0 (at-least-once replay), never a
  guessed number."
  [file]
  (try
    (if (h/file? file)
      (let [raw (str (get (h/json-parse (h/slurp file)) "offset"))]
        ;; strict digits only: a corrupt value restarts at 0, never a
        ;; parseInt prefix guess ("8abc" is NOT 8)
        (if (re-matches #"\d+" raw)
          (let [n (js/parseInt raw 10)]
            ;; isSafeInteger: a digit string past double precision must not
            ;; round into a wrong number — it restarts at 0 like any other
            ;; unrepresentable value
            (if (and (js/isFinite n) (js/Number.isSafeInteger n) (pos? n)) n 0))
          0))
      0)
    (catch :default _ 0)))

(defn- write-offset!
  "Persist the consumed offset (atomic). Best-effort — a failed write replays
  later, which is the safe direction."
  [file n]
  (when file
    (try (h/spit-atomic file (h/json-str {"offset" n}))
         (catch :default _ nil))))

(defn serve!
  "The gateway serve loop (JUN-465): one `telegram-poll!` long poll, dispatch
  every carried update through `dispatch`, recur until stopped. A poll error
  reports through `on-error` and backs off `backoff-ms` of `interval` (ms,
  floored at 1000; default 5000 — never a hot retry loop).
  Injected: `fetch`, `dispatch` (fn [raw]), optional `on-error`, `max-ticks`
  (tests bound the loop), `poll-timeout` (the long-poll timeout, default 25),
  `offset-file` (where the consumed getUpdates offset persists, so a restart
  does not replay what was already taken — best-effort, corrupt = 0).
  Returns {:stop (fn []) :done <promise resolving :stopped|:max-ticks>}."
  [{:keys [fetch token dispatch on-error interval max-ticks poll-timeout offset-file]}]
  (let [iv (backoff-ms interval)
        stopped (atom false)
        ticks (atom 0)
        off (atom (read-offset offset-file))
        resolve-done (atom nil)
        done (js/Promise. (fn [res] (reset! resolve-done res)))
        wait (fn [ms] (js/Promise. (fn [res] (js/setTimeout res ms))))
        finish (fn [why] (@resolve-done why))  ;; a Promise resolver is idempotent
        notify! (fn [e]
                  (when on-error
                    (try (on-error e) (catch :default _ nil))))
        step (fn step []
               (cond
                 @stopped (finish :stopped)
                 (and max-ticks (<= max-ticks @ticks)) (finish :max-ticks)
                 :else
                 ;; the poll enters through a promise boundary: a synchronous
                 ;; throw from an injected fetch or callback becomes a
                 ;; rejection the catch answers — never a dead loop
                 (-> (p/resolved nil)
                     (p/then (fn [_] (telegram-poll! {:fetch fetch :token token :offset @off
                                                      :timeout (or poll-timeout 25)})))
                     (p/then (fn [res]
                               (swap! ticks inc)
                               (if-let [err (:error res)]
                                 (do (notify! err)
                                     (-> (wait iv) (p/then (fn [_] (step)))))
                                 ;; ack (memory + disk) only AFTER every
                                 ;; dispatch settles: a crash or a rejecting
                                 ;; dispatch replays the batch on restart
                                 ;; (at-least-once — the safe direction)
                                 (-> (p/all (map dispatch (:updates res)))
                                     (p/then (fn [_]
                                               (reset! off (:offset res))
                                               (write-offset! offset-file (:offset res))
                                               (step)))))))
                     (p/catch (fn [e]
                                (notify! (err-str e))
                                (-> (wait iv) (p/then (fn [_] (step)))))))))]
    (step)
    {:stop (fn [] (reset! stopped true)) :done done}))

(defn prepare-send-profile
  "Shape a profile for an EXPLICIT-target send (the `send` command). Per-chat
  families (telegram/slack/matrix, discord-bot) take the requested chat as the
  target, so a missing default is filled from it, in the key that adapter
  actually constructs from (telegram `chat_id`, slack `channel`, matrix
  `room_id`, discord-bot `channel_id`). Webhook-style sends have ONE fixed target whose
  served chat is the configured anchor — filling that anchor from the request
  would defeat the misdirection refusal, so an undeclared anchor is REFUSED
  (fail closed) instead. Returns {:prof ...} or {:error ...}."
  [prof platform chat-id]
  (let [c (get-in prof [:config "delivery" platform])
        webhook? (or (= "mattermost" platform)
                     (and (= "discord" platform)
                          (not (str/blank? (str (get c "webhook_url"))))))
        bot-channel? (and (= "discord" platform) (not webhook?))]
    (cond
      webhook?
      (cond
        (str/blank? (str (get c "webhook_url")))
        {:error (str platform " webhook lane needs delivery." platform ".webhook_url configured")}
        (str/blank? (str (get c "chat_id")))
        {:error (str platform " webhook lane must declare delivery." platform
                     ".chat_id (the one chat it serves) before an explicit send")}
        :else {:prof prof})

      (contains? #{"telegram" "slack" "matrix" "discord"} platform)
      ;; the key each adapter actually constructs from (for-lane):
      ;; telegram chat_id, slack channel, matrix room_id, discord-bot channel_id
      (let [fill-key (if bot-channel?
                       "channel_id"
                       ({"telegram" "chat_id" "slack" "channel" "matrix" "room_id"} platform))]
        {:prof (update-in prof [:config "delivery" platform]
                          (fn [c]
                            (cond-> (or c {})
                              (str/blank? (str (get c fill-key)))
                              (assoc fill-key (str chat-id)))))})

      :else {:error (str platform " is not implemented for send (telegram/slack/matrix/discord/mattermost)")})))

(def max-reply-chars
  "Sendable reply segment size. Telegram sendMessage rejects over 4096 chars
  with HTTP 400; stay under the limit with margin."
  4000)

(defn chunk-text
  "Split a reply into sendable segments of at most `limit` chars, preferring
  the last newline inside the window (a hard split only when one line is
  longer than the limit). The boundary newline stays with the earlier
  segment, so concatenating every segment returns the original text.
  `limit` must be a positive integer (a fractional limit would loop on a
  zero-advance split) — anything else throws."
  ([text] (chunk-text text max-reply-chars))
  ([text limit]
   (when-not (and (integer? limit) (pos? limit))
     ;; a fractional limit truncates subs to a zero-advance step and loops
     ;; forever; the contract is a positive INTEGER
     (throw (js/Error. "chunk-text: limit must be a positive integer")))
   (let [s (str text)]
     (if (<= (count s) limit)
       [s]
       (loop [rest-s s acc []]
         (if (<= (count rest-s) limit)
           (conj acc rest-s)
           (let [window (subs rest-s 0 limit)
                 nl (str/last-index-of window "\n")
                 cut (if nl (inc nl) limit)]
             (recur (subs rest-s cut) (conj acc (subs window 0 cut))))))))))

(defn send-reply!
  "The reply through the platform's existing send adapter (the same one the
  cron delivery queue uses), addressed to the MESSAGE'S chat: a
  `gateway.routes`-routed chat must never leak into the profile's configured
  delivery chat — a message that names no chat is refused outright, and
  webhook-style sends (one fixed target) refuse a chat they do not serve
  rather than post into the configured channel. The message's thread_id
  rides along as the platform's thread target where one exists (telegram:
  message_thread_id). A reply longer than `max-reply-chars` is sent as
  ordered newline-preferring segments; the first failing segment stops the
  send and its error is returned; blank replies are refused outright.
  `prof` is the owning profile (same position
  as send!'s first argument). Resolves to nil on success or the adapter's
  error string."
  ([prof msg text] (send-reply! prof msg text nil))
  ([prof msg text fetch]
   (let [platform (get msg "platform")
         chat (str (get msg "chat_id"))
         adapter (platforms/for-lane platform (:config prof))]
     (cond
       (str/blank? chat)
       (p/resolved (str platform " reply names no chat - refusing to fall back to the configured delivery chat"))

       (str/blank? (str text))
       (p/resolved (str platform " reply is empty - refusing to send"))

       (nil? adapter)
       (p/resolved (str platform " send adapter not configured"))

       :else
       (let [send-opts (cond-> {:chat-id chat
                                :thread-id (get msg "thread_id")}
                         fetch (assoc :fetch fetch))
             segments (chunk-text text)
             send-segs (fn send-segs [segs]
                         (let [seg (first segs)
                               more (rest segs)]
                           (-> (adapter nil platform seg send-opts)
                               (p/then (fn [res]
                                         (if (and (nil? res) (seq more))
                                           (send-segs more)
                                           res))))))]
         (send-segs segments))))))
