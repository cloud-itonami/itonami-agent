sha256() {
  hash=$(/usr/bin/env -i /usr/bin/shasum -a 256 < "$1") || return 1
  printf '%s\n' "${hash%% *}"
}

matches_pin() {
  [ -f "$1" ] && [ ! -L "$1" ] && [ "$(sha256 "$1")" = "$2" ]
}
