#!/usr/bin/env -S kbb --backend sci --classpath src:test
;; kbb --backend sci --classpath src:test run-tests.cljk
;; Uses a throwaway ITONAMI_DIR so the node key under ~/.itonami is untouched.
(ns run-tests
  (:require [cljs.test :as t]
            ["node:os" :as os]
            ["node:path" :as path]))

(aset (.-env js/process) "ITONAMI_DIR" (path/join (os/tmpdir) (str "itonami-agent-test-" (.-pid js/process))))

(require 'itonami.agent.core-test 'itonami.agent.code-rpc-test 'itonami.agent.process-checkpoint-test 'itonami.agent.process-notice-test 'itonami.agent.process-watch-test 'itonami.agent.oneshot-linger-test 'itonami.agent.spawn-notes-test 'itonami.agent.watcher-register-test 'itonami.agent.watcher-delivery-test 'itonami.agent.gateway-test 'itonami.agent.gateway-admission-test 'itonami.agent.session-search-test 'itonami.agent.delivery-queue-test)

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m) (js/process.exit 1)))

(t/run-tests 'itonami.agent.core-test 'itonami.agent.code-rpc-test 'itonami.agent.process-checkpoint-test 'itonami.agent.process-notice-test 'itonami.agent.process-watch-test 'itonami.agent.oneshot-linger-test 'itonami.agent.spawn-notes-test 'itonami.agent.watcher-register-test 'itonami.agent.watcher-delivery-test 'itonami.agent.gateway-test 'itonami.agent.gateway-admission-test 'itonami.agent.session-search-test 'itonami.agent.delivery-queue-test)
