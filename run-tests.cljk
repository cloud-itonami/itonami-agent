#!/usr/bin/env -S kbb --backend sci --classpath src:test
;; kbb --backend sci --classpath src:test run-tests.cljk
;; Uses a throwaway ITONAMI_DIR so the node key under ~/.itonami is untouched.
(ns run-tests
  (:require [cljs.test :as t]
            ["node:os" :as os]
            ["node:path" :as path]))

(aset (.-env js/process) "ITONAMI_DIR" (path/join (os/tmpdir) (str "itonami-agent-test-" (.-pid js/process))))

;; The Hermes session that runs these tests may export HERMES_SESSION_* (its
;; own routing stamps). Several watcher tests assert the no-stamp case and
;; pass only when those are absent -- so make the runner hermetic instead of
;; asking every caller to clean its shell first.
(doseq [k (js/Object.keys (.-env js/process))]
  (when (.startsWith k "HERMES_SESSION_")
    (js-delete (.-env js/process) k)))

(require 'itonami.agent.execute-code-rpc-test 'itonami.agent.collect-io-test 'itonami.agent.collect-test 'itonami.agent.p2p-service-test 'itonami.agent.core-test 'itonami.agent.code-rpc-test 'itonami.agent.process-checkpoint-test 'itonami.agent.process-notice-test 'itonami.agent.process-watch-test 'itonami.agent.oneshot-linger-test 'itonami.agent.spawn-notes-test 'itonami.agent.watcher-register-test 'itonami.agent.watcher-delivery-test 'itonami.agent.gateway-test 'itonami.agent.gateway-admission-test 'itonami.agent.session-search-test 'itonami.agent.delivery-queue-test 'itonami.agent.dapps-test 'itonami.agent.chat-platform-test 'itonami.agent.pause-test 'itonami.agent.args-test 'itonami.agent.sessions-cli-test 'itonami.agent.provider-resolution-test 'itonami.agent.profile-gate-test 'itonami.agent.doctor-test 'itonami.agent.code-rpc-hint-test 'itonami.agent.chunk-test 'itonami.agent.connections-test 'itonami.agent.tts-test 'itonami.agent.pid-guard-test 'itonami.agent.clarify-test)

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (when-not (t/successful? m) (js/process.exit 1)))

(t/run-tests 'itonami.agent.execute-code-rpc-test 'itonami.agent.collect-io-test 'itonami.agent.collect-test 'itonami.agent.p2p-service-test 'itonami.agent.core-test 'itonami.agent.code-rpc-test 'itonami.agent.process-checkpoint-test 'itonami.agent.process-notice-test 'itonami.agent.process-watch-test 'itonami.agent.oneshot-linger-test 'itonami.agent.spawn-notes-test 'itonami.agent.watcher-register-test 'itonami.agent.watcher-delivery-test 'itonami.agent.gateway-test 'itonami.agent.gateway-admission-test 'itonami.agent.session-search-test 'itonami.agent.delivery-queue-test 'itonami.agent.dapps-test 'itonami.agent.chat-platform-test 'itonami.agent.pause-test 'itonami.agent.args-test 'itonami.agent.sessions-cli-test 'itonami.agent.provider-resolution-test 'itonami.agent.profile-gate-test 'itonami.agent.doctor-test 'itonami.agent.code-rpc-hint-test 'itonami.agent.chunk-test 'itonami.agent.connections-test 'itonami.agent.tts-test 'itonami.agent.pid-guard-test 'itonami.agent.clarify-test)
